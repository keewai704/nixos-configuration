+static int command_send(struct torne_bridge *b, bool answer, u32 *value)
+{
+    u8 packet[512] = { 0 }, reply[64];
+    u32 sequence = b->command_sequence, status;
+    unsigned int i;
+    int length;
+    u64 deadline;
