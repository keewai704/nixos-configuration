+func TestAcquiredParametersAvoidRepeatedSearch(t *testing.T) {
+	chip := lockedChip()
+	demod, _ := newTestDemod(chip)
+	if err := demod.Initialize(); err != nil {
+		t.Fatal(err)
+	}
+	for _, frequency := range []uint32{473142857, 479142857} {
+		chip.queues[1284] = []uint16{1, 0, 2}
+		if err := demod.Tune(frequency); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(demod.acquired) != 2 {
+		t.Fatalf("acquired %d frequencies", len(demod.acquired))
+	}
+	chip.queues[1284] = []uint16{0}
+	before := len(chip.writes)
+	if err := demod.Tune(473142857); err != nil {
+		t.Fatal(err)
+	}
+	if demod.demod.status != statusDataLocked {
+		t.Fatal("cached tune did not lock")
+	}
+	for _, write := range chip.writes[before:] {
+		if write.register == 357 && write.value == 0x111 {
+			t.Fatal("cached tune repeated FFT search")
+		}
+	}
+	if err := demod.Initialize(); err != nil {
+		t.Fatal(err)
+	}
+	if len(demod.acquired) != 0 {
+		t.Fatal("reset retained acquired parameters")
+	}
+}
+
+func TestIncompleteLockIsNotAcquired(t *testing.T) {
+	for _, missing := range []uint16{1 << 1, 1 << 12} {
+		chip := lockedChip()
+		chip.registers[568] &^= missing
+		demod, _ := newTestDemod(chip)
+		if err := demod.Initialize(); err != nil {
+			t.Fatal(err)
+		}
+		_ = demod.Tune(473142857)
+		if len(demod.acquired) != 0 {
+			t.Fatalf("cached incomplete lock without %#x", missing)
+		}
+	}
+}
+
+func TestStaleAcquiredParametersFallBack(t *testing.T) {
+	chip := lockedChip()
+	demod, _ := newTestDemod(chip)
+	if err := demod.Initialize(); err != nil {
+		t.Fatal(err)
+	}
+	if err := demod.Tune(473142857); err != nil {
+		t.Fatal(err)
+	}
+	chip.queues[568] = []uint16{0, 0x3ffe}
+	chip.queues[1284] = []uint16{1, 0, 2}
+	chip.registers[570] = 3<<4 | 3
+	if err := demod.Tune(473142857); err != nil {
+		t.Fatal(err)
+	}
+	if demod.demod.status != statusDataLocked {
+		t.Fatal("fallback did not lock")
+	}
+	if demod.acquired[473142857].guardInterval != guard1_4 {
+		t.Fatal("fallback did not refresh parameters")
+	}
+}
