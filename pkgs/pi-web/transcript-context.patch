+test("exact prompts project each canonical request without mutating history or losing tools", async () => {
+  const tool = (name) => ({ name, description: name, parameters: { type: "object" } });
+  const messages = [
+    { role: "system", content: "original", toolsAdded: [tool("old")], timestamp: 0 },
+    { role: "user", content: "task", timestamp: 1 },
+    { role: "system", content: "later", toolsRemoved: [{ name: "old" }], toolsAdded: [tool("current")], timestamp: 2 },
+  ];
+  const snapshot = structuredClone(messages);
+  let prompt = "exact";
+  const agent = {
+    state: Object.freeze({ systemPrompt: "original" }),
+    prepareRequest: async () => ({ context: { messages, tools: [tool("current")] }, thinkingLevel: "high" }),
+  };
+  new AgentSessionWrapper({ agent }, { exactSystemPrompt: () => prompt });
+  for (const expected of ["exact", "updated"]) {
+    prompt = expected;
+    const result = await agent.prepareRequest({ context: { messages: [] } });
+    assert.equal(result.context.messages[0].content, expected);
+    assert.deepEqual(result.context.messages[0].toolsAdded.map((value) => value.name), ["current"]);
+    assert.deepEqual(result.context.messages.slice(1), [messages[1]]);
+    assert.equal(result.thinkingLevel, "high");
+    assert.deepEqual(result.context.tools, [tool("current")]);
+  }
+  assert.deepEqual(messages, snapshot);
+  assert.equal(agent.state.systemPrompt, "original");
 });

