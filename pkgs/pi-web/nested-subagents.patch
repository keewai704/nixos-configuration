new file mode 100644
--- /dev/null
+++ b/lib/subagent-ancestry.ts
@@ -0,0 +1,25 @@
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import type { SessionEntry } from "./types";
+import { canonicalParentSessionFile } from "./subagent-state";
+import { readSubagentParentSessionFile, readSubagentRun, SUBAGENT_META_TYPE } from "./subagents";
+
+export const MAX_DELEGATION_DEPTH = 2;
+
+export function subagentDepth(id: string, file: string, entries: readonly SessionEntry[]): number {
+  const seen = new Set<string>();
+  let depth = 0;
+  for (;;) {
+    const path = canonicalParentSessionFile(file);
+    if (seen.has(path)) throw new Error("Invalid cyclic subagent ancestry");
+    seen.add(path);
+    if (!entries.some((entry) => entry.type === "custom" && entry.customType === SUBAGENT_META_TYPE)) return depth;
+    const run = readSubagentRun(entries, id, file);
+    const parent = readSubagentParentSessionFile(entries);
+    if (!run || !parent || ++depth > MAX_DELEGATION_DEPTH) throw new Error("Invalid subagent ancestry or delegation depth");
+    const manager = SessionManager.open(parent);
+    if (manager.getSessionId() !== run.parentSessionId) throw new Error("Subagent ancestor identity changed");
+    id = manager.getSessionId();
+    file = parent;
+    entries = manager.getEntries() as unknown as SessionEntry[];
+  }
+}
