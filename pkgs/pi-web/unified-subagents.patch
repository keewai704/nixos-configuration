+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { mkdtempSync, readFileSync, readdirSync, rmSync, statSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { syncBuiltinESMExports } from "node:module";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const load = () => createJiti(import.meta.url).import("./subagent-state.ts");
+const task = (id, needs = []) => ({ id, profile: "scout", description: id, assignment: "Inspect", needs });
+const record = (id, needs = []) => ({ ...task(id, needs), groupId: "batch", status: "blocked", attempt: 0,
+  createdAt: "2026-01-01T00:00:00.000Z", updatedAt: "2026-01-01T00:00:00.000Z" });
+
+function fixture(t) {
+  const dir = mkdtempSync(join(tmpdir(), "pi-native-state-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const parent = join(dir, "parent.jsonl");
+  writeFileSync(parent, "");
+  return { dir, parent };
+}
+
+test("invalid batches never pass the launch boundary", async () => {
+  const { validateBatch } = await load();
+  for (const input of [[], [task("parent")], [task("a"), task("a")], [task("a", [{ taskId: "missing", input: "report" }])],
+    [task("a", [{ taskId: "a", input: "report" }])], [{ ...task("a"), profile: " " }],
+    [task("a", [{ taskId: "b", input: "unknown" }]), task("b")]]) {
+    assert.throws(() => validateBatch(input));
+  }
+  assert.throws(() => validateBatch([
+    task("a", [{ taskId: "b", input: "report" }]), task("b", [{ taskId: "a", input: "report" }]),
+  ]), /cycle/i);
+  assert.doesNotThrow(() => validateBatch([task("a"), task("b", [{ taskId: "a", input: "report" }])]));
+});
+
+test("only completed reports release dependents and file inputs need an explicit integrated revision", async () => {
+  const { readyTaskIds } = await load();
+  const a = record("a");
+  const b = record("b", [{ taskId: "a", input: "report" }]);
+  const c = record("c", [{ taskId: "a", input: "integrated_changes" }]);
+  const state = { tasks: [a, b, c] };
+  assert.deepEqual(readyTaskIds(state), ["a"]);
+  for (const status of ["running", "failed", "needs_input", "interrupted", "completed"]) {
+    a.status = status;
+    assert.deepEqual(readyTaskIds(state), []);
+  }
+  a.report = { outcome: "completed", report: "Inspected" };
+  assert.deepEqual(readyTaskIds(state), ["b"]);
+  a.releaseRevision = "a".repeat(40);
+  assert.deepEqual(readyTaskIds(state), ["b", "c"]);
+  b.status = "queued";
+  assert.deepEqual(readyTaskIds(state), ["c"]);
+});
+
+test("state inspection has no writes and symlink spellings share private durable state", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { readDelegationState, updateDelegationState, delegationStatePath } = await load();
+  assert.equal(readDelegationState(dir, parent), undefined);
+  assert.deepEqual(readdirSync(dir), ["parent.jsonl"]);
+  const alias = join(dir, "alias.jsonl");
+  symlinkSync(parent, alias);
+  await updateDelegationState(dir, alias, (state) => {
+    state.groups.push({ id: "batch", createdAt: "2026-01-01T00:00:00.000Z" });
+    state.tasks.push(record("a"));
+  });
+  assert.equal(readDelegationState(dir, parent).tasks[0].id, "a");
+  const path = delegationStatePath(dir, parent);
+  assert.equal(path, delegationStatePath(dir, alias));
+  assert.equal(statSync(path).mode & 0o777, 0o600);
+  assert.equal(statSync(dirname(path)).mode & 0o777, 0o700);
+  assert.equal(statSync(dirname(dirname(path))).mode & 0o777, 0o700);
+});
+
+test("concurrent updates are serialized without losing another task group", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { readDelegationState, updateDelegationState } = await load();
+  await Promise.all(Array.from({ length: 12 }, (_, id) => updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id: `group-${id}`, createdAt: "2026-01-01T00:00:00.000Z" });
+  })));
+  assert.equal(readDelegationState(dir, parent).groups.length, 12);
+});
+
+test("invalid state and invalid mutations preserve the previous file", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { readDelegationState, updateDelegationState, delegationStatePath } = await load();
+  await updateDelegationState(dir, parent, () => {});
+  const path = delegationStatePath(dir, parent);
+  const valid = readFileSync(path, "utf8");
+  for (const bad of ["{", JSON.stringify({ version: 9 }), JSON.stringify({ version: 1, tasks: [] })]) {
+    writeFileSync(path, bad);
+    assert.throws(() => readDelegationState(dir, parent));
+    await assert.rejects(updateDelegationState(dir, parent, () => {}));
+    assert.equal(readFileSync(path, "utf8"), bad);
+  }
+  writeFileSync(path, valid);
+  await assert.rejects(updateDelegationState(dir, parent, (state) => { state.parentSessionFile = "/another-parent"; }));
+  assert.equal(readFileSync(path, "utf8"), valid);
+});
+
+test("closing a report preserves its terminal outcome and oversized writes are rejected atomically", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { readDelegationState, updateDelegationState, delegationStatePath } = await load();
+  await updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id: "batch", createdAt: "2026-01-01T00:00:00.000Z" });
+    state.tasks.push({ ...record("a"), attempt: 1, status: "completed", report: { outcome: "completed", report: "Done" } });
+  });
+  await updateDelegationState(dir, parent, (state) => { state.tasks[0].closedAt = "2026-01-01T00:01:00.000Z"; });
+  const state = readDelegationState(dir, parent);
+  assert.equal(state.tasks[0].status, "completed");
+  assert.equal(state.tasks[0].report.report, "Done");
+  const path = delegationStatePath(dir, parent);
+  const before = readFileSync(path, "utf8");
+  await assert.rejects(updateDelegationState(dir, parent, (next) => { next.tasks[0].report.report = "あ".repeat(90_000); }), /report/i);
+  assert.equal(readFileSync(path, "utf8"), before);
+  for (const key of ["skillFiles", "extensionFiles"]) {
+    await assert.rejects(updateDelegationState(dir, parent, (next) => {
+      next.tasks[0].resources = { version: 1, appendSystemPrompt: [], tools: ["read"],
+        loadSkills: false, loadExtensions: false, [key]: [42] };
+    }), /state/i);
+    assert.equal(readFileSync(path, "utf8"), before);
+  }
+});
+
+test("state creation flushes its new directory hierarchy and replacements require a directory flush", async (t) => {
+  const { dir, parent } = fixture(t);
+  let path;
+  const flushed = new Set();
+  const fsync = fs.fsyncSync;
+  let fail = false;
+  const probe = t.mock.method(fs, "fsyncSync", (fd) => {
+    if (fs.fstatSync(fd).isDirectory()) {
+      const target = fs.readlinkSync(`/proc/self/fd/${fd}`);
+      flushed.add(target);
+      if (fail && target === dirname(path)) throw new Error("state directory flush failed");
+    }
+    return fsync(fd);
+  });
+  syncBuiltinESMExports();
+  try {
+    const { updateDelegationState, delegationStatePath } = await createJiti(import.meta.url, { moduleCache: false }).import("./subagent-state.ts");
+    path = delegationStatePath(dir, parent);
+    const expected = [dir, dirname(dirname(path)), dirname(path)];
+    await updateDelegationState(dir, parent, () => {});
+    assert.equal(expected.every((path) => flushed.has(path)), true, JSON.stringify([...flushed]));
+    fail = true;
+    await assert.rejects(updateDelegationState(dir, parent, () => {}), /state directory flush failed/);
+  } finally {
+    probe.mock.restore();
+    syncBuiltinESMExports();
+  }
+});
+
+test("failed retirement durability preserves the metadata holder's proof", async (t) => {
+  const { dir, parent } = fixture(t);
+  const rename = fs.renameSync;
+  const fsync = fs.fsyncSync;
+  let retired;
+  const renameProbe = t.mock.method(fs, "renameSync", (from, to) => {
+    const result = rename(from, to);
+    if (String(from).endsWith("state.json.lock")) retired = String(to);
+    return result;
+  });
+  const fault = t.mock.method(fs, "fsyncSync", (fd) => {
+    if (retired && fs.fstatSync(fd).isDirectory()
+      && fs.readlinkSync(`/proc/self/fd/${fd}`) === dirname(retired)) throw new Error("retirement flush failed");
+    return fsync(fd);
+  });
+  syncBuiltinESMExports();
+  try {
+    const { updateDelegationState } = await createJiti(import.meta.url, { moduleCache: false }).import("./subagent-state.ts");
+    await assert.rejects(updateDelegationState(dir, parent, () => {}), /retirement flush failed/);
+    assert.equal(JSON.parse(readFileSync(retired, "utf8")).pid, process.pid);
+  } finally {
+    renameProbe.mock.restore();
+    fault.mock.restore();
+    syncBuiltinESMExports();
+  }
+});
+
+test("unassigned tasks persist without launching until the parent assigns a role", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { updateDelegationState, readDelegationState, readyTaskIds } = await load();
+  await updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id: "batch", createdAt: "2026-01-01T00:00:00.000Z" });
+    state.tasks.push({ ...record("pending"), profile: undefined });
+  });
+  assert.deepEqual(readyTaskIds(readDelegationState(dir, parent)), []);
+  const assigned = await updateDelegationState(dir, parent, (state) => { state.tasks[0].profile = "scout"; });
+  assert.deepEqual(readyTaskIds(assigned), ["pending"]);
+});
+
+test("native task options are validated before any launch", async () => {
+  const { validateBatch } = await load();
+  for (const invalid of [{ maxTurns: -1 }, { maxTurns: 1.5 }, { inputFiles: false }, { inputFiles: [42] },
+    { runInBackground: "yes" }, { inheritContext: 0 }, { isolation: "shared" }, { parentToolCallId: 42 }, { parentToolCallId: "" }]) {
+    assert.throws(() => validateBatch([{ ...task("one"), ...invalid }]));
+  }
+});
+
+test("persisted-history markers are boolean and preserve the actual parent tool-call association", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { updateDelegationState, readDelegationState } = await load();
+  await updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id: "batch", createdAt: "2026-01-01T00:00:00.000Z" });
+    state.tasks.push({ ...record("child"), parentToolCallId: "sdk-call", historyPersisted: false });
+  });
+  await assert.rejects(updateDelegationState(dir, parent, (state) => { state.tasks[0].historyPersisted = "yes"; }), /state/i);
+  assert.equal(readDelegationState(dir, parent).tasks[0].parentToolCallId, "sdk-call");
+  assert.equal(readDelegationState(dir, parent).tasks[0].historyPersisted, false);
+});
diff --git a/lib/subagent-state.ts b/lib/subagent-state.ts
new file mode 100644
index 0000000..4eca078
--- /dev/null
+++ b/lib/subagent-state.ts
@@ -0,0 +1,217 @@
+import { createHash } from "node:crypto";
+import { chmodSync, mkdirSync, readFileSync, realpathSync } from "node:fs";
+import { basename, dirname, isAbsolute, join, resolve } from "node:path";
+import { syncDirectorySync, writePrivateFileAtomicSync } from "./atomic-file";
+import { lockSubagentState } from "./subagent-state-lock";
+import { formatAssignment, validateMessage, validateReport } from "./subagent-task-types";
+import type { DelegationState, TaskInput, TaskRecord } from "./subagent-task-types";
+
+const ID = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/;
+const OID = /^(?:[a-f0-9]{40}|[a-f0-9]{64})$/;
+const UUID = /^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/i;
+const STATUSES = new Set(["blocked", "queued", "running", "cancelling", "needs_input", "completed", "failed", "aborted", "interrupted"]);
+const THINKING = new Set(["off", "minimal", "low", "medium", "high", "xhigh", "max"]);
+
+function object(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function text(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function date(value: unknown): boolean {
+  return text(value) && Number.isFinite(Date.parse(value));
+}
+
+function requireState(condition: unknown): asserts condition {
+  if (!condition) throw new Error("Invalid native subagent state");
+}
+
+export function canonicalParentSessionFile(path: string): string {
+  if (!isAbsolute(path)) throw new Error("The parent session file must be absolute");
+  try {
+    return realpathSync(path);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    return join(realpathSync(dirname(path)), basename(path));
+  }
+}
+
+export function delegationStatePath(agentDir: string, parentSessionFile: string): string {
+  const parent = canonicalParentSessionFile(parentSessionFile);
+  return join(resolve(agentDir), "native-subagents", createHash("sha256").update(parent).digest("hex"), "state.json");
+}
+
+export function validateBatch(tasks: TaskInput[]): void {
+  if (!Array.isArray(tasks) || tasks.length === 0) throw new Error("A batch needs tasks");
+  const ids = new Set<string>();
+  for (const task of tasks) {
+    if (!object(task) || !text(task.id) || !ID.test(task.id) || task.id === "parent" || ids.has(task.id)) throw new Error("Invalid or duplicate task ID");
+    ids.add(task.id);
+    if ((task.profile !== undefined && !text(task.profile)) || !text(task.description)) throw new Error("Invalid task profile or description");
+    formatAssignment(task.assignment);
+    if (!Array.isArray(task.needs)) throw new Error("Task dependencies must be an array");
+    for (const key of ["inputRevision", "specialistPrompt", "model", "parentToolCallId"] as const) {
+      if (task[key] !== undefined && !text(task[key])) throw new Error(`Invalid task ${key}`);
+    }
+    if (task.thinking !== undefined && !THINKING.has(task.thinking)) throw new Error("Invalid task thinking level");
+    if (task.maxTurns !== undefined && (!Number.isSafeInteger(task.maxTurns) || task.maxTurns < 0)) throw new Error("Invalid task turn limit");
+    if (task.inputFiles !== undefined && (!Array.isArray(task.inputFiles) || !task.inputFiles.every(text))) throw new Error("Invalid task input files");
+    for (const key of ["inheritContext", "runInBackground"] as const) {
+      if (task[key] !== undefined && typeof task[key] !== "boolean") throw new Error(`Invalid task ${key}`);
+    }
+    if (task.isolation !== undefined && task.isolation !== "worktree") throw new Error("Invalid task isolation");
+  }
+  for (const task of tasks) {
+    const dependencies = new Set<string>();
+    for (const edge of task.needs) {
+      if (!object(edge) || !text(edge.taskId) || !ids.has(edge.taskId)) throw new Error("Unknown dependency task");
+      if (edge.taskId === task.id || dependencies.has(edge.taskId)) throw new Error("Self or duplicate dependency");
+      if (edge.input !== "report" && edge.input !== "integrated_changes") throw new Error("Unknown dependency input");
+      dependencies.add(edge.taskId);
+    }
+  }
+  const remaining = new Map(tasks.map((task) => [task.id, new Set(task.needs.map((edge) => edge.taskId))]));
+  while (remaining.size) {
+    const ready = [...remaining].filter(([, needs]) => needs.size === 0).map(([id]) => id);
+    if (ready.length === 0) throw new Error("Task dependency cycle");
+    for (const id of ready) {
+      remaining.delete(id);
+      for (const needs of remaining.values()) needs.delete(id);
+    }
+  }
+}
+
+export function isTaskReady(state: Pick<DelegationState, "tasks">, task: TaskRecord): boolean {
+  const byId = new Map(state.tasks.map((task) => [task.id, task]));
+  return !task.closedAt && text(task.profile)
+    && task.needs.every((edge) => {
+      const prerequisite = byId.get(edge.taskId);
+      return prerequisite?.status === "completed" && prerequisite.report?.outcome === "completed"
+        && (edge.input === "report" || (typeof prerequisite.releaseRevision === "string" && OID.test(prerequisite.releaseRevision)));
+    });
+}
+
+export function readyTaskIds(state: Pick<DelegationState, "tasks">): string[] {
+  return state.tasks.filter((task) => task.status === "blocked" && isTaskReady(state, task)).map((task) => task.id);
+}
+
+function validateState(value: unknown, parent: string): asserts value is DelegationState {
+  requireState(object(value));
+  if (value.version !== 1) throw new Error("Unsupported native subagent state version");
+  requireState(value.parentSessionFile === parent && Array.isArray(value.groups) && Array.isArray(value.tasks)
+    && Array.isArray(value.messages) && Array.isArray(value.deliveries));
+  requireState(value.parentSessionId === undefined || text(value.parentSessionId));
+  const groups = new Set<string>();
+  for (const group of value.groups) {
+    requireState(object(group) && text(group.id) && ID.test(group.id) && !groups.has(group.id) && date(group.createdAt));
+    groups.add(group.id);
+  }
+  if (value.tasks.length) validateBatch(value.tasks);
+  const tasks = new Map(value.tasks.map((task) => [task.id, task]));
+  for (const task of value.tasks) {
+    requireState(groups.has(task.groupId) && STATUSES.has(task.status) && Number.isSafeInteger(task.attempt) && task.attempt >= 0
+      && date(task.createdAt) && date(task.updatedAt));
+    for (const key of ["sessionId", "sessionFile", "worktreePath", "worktreeBranch", "lastInput"] as const) {
+      requireState(task[key] === undefined || text(task[key]));
+    }
+    requireState(task.releaseRevision === undefined || (typeof task.releaseRevision === "string" && OID.test(task.releaseRevision)));
+    requireState(task.closedAt === undefined || date(task.closedAt));
+    requireState(task.historyPersisted === undefined || typeof task.historyPersisted === "boolean");
+    if (task.report !== undefined) validateReport(task.report);
+    if (["completed", "failed", "needs_input"].includes(task.status)) requireState(task.report?.outcome === task.status);
+    if (task.resources !== undefined) {
+      const r = task.resources;
+      requireState(object(r) && r.version === 1 && Array.isArray(r.appendSystemPrompt) && r.appendSystemPrompt.every((v) => typeof v === "string")
+        && Array.isArray(r.tools) && r.tools.every(text) && typeof r.loadSkills === "boolean" && typeof r.loadExtensions === "boolean"
+        && (r.exactSystemPrompt === undefined || text(r.exactSystemPrompt)));
+      for (const paths of [r.skillFiles, r.extensionFiles]) requireState(paths === undefined || (Array.isArray(paths) && paths.every(text)));
+    }
+  }
+  const messageIds = new Set<string>();
+  for (const message of value.messages) {
+    requireState(object(message) && text(message.id) && !messageIds.has(message.id) && groups.has(message.groupId as string)
+      && date(message.createdAt) && (message.deliveredAt === undefined || date(message.deliveredAt)));
+    for (const actor of [message.from, message.to]) {
+      requireState(actor === "parent" || (text(actor) && tasks.get(actor)?.groupId === message.groupId));
+    }
+    validateMessage(message.text);
+    messageIds.add(message.id);
+  }
+  const deliveryIds = new Set<string>();
+  for (const delivery of value.deliveries) {
+    requireState(object(delivery) && text(delivery.id) && !deliveryIds.has(delivery.id) && text(delivery.taskId)
+      && tasks.has(delivery.taskId) && Number.isSafeInteger(delivery.attempt) && (delivery.attempt as number) >= 1
+      && (delivery.attempt as number) <= tasks.get(delivery.taskId)!.attempt
+      && date(delivery.createdAt) && (delivery.acknowledgedAt === undefined || date(delivery.acknowledgedAt)));
+    if (delivery.kind === "report") validateReport(delivery.report);
+    else {
+      requireState(delivery.kind === "message" && text(delivery.messageId) && messageIds.has(delivery.messageId));
+      validateMessage(delivery.text);
+    }
+    deliveryIds.add(delivery.id);
+  }
+  if (value.owner !== undefined) {
+    const owner = value.owner;
+    requireState(object(owner) && owner.parentSessionFile === parent && text(owner.token) && UUID.test(owner.token)
+      && Number.isSafeInteger(owner.pid) && (owner.pid as number) > 0 && text(owner.bootId) && UUID.test(owner.bootId)
+      && typeof owner.startTime === "string" && /^\d+$/.test(owner.startTime));
+  }
+}
+
+export function assertDelegationParent(state: DelegationState, parentSessionId: string): void {
+  if (state.parentSessionId === parentSessionId) return;
+  if (state.parentSessionId !== undefined || state.groups.length || state.tasks.length || state.messages.length || state.deliveries.length) {
+    throw new Error("The saved parent session identity does not match this SDK parent");
+  }
+}
+
+export function readDelegationState(agentDir: string, parentSessionFile: string, parentSessionId?: string): DelegationState | undefined {
+  const parent = canonicalParentSessionFile(parentSessionFile);
+  let raw: string;
+  try {
+    raw = readFileSync(delegationStatePath(agentDir, parent), "utf8");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+    throw error;
+  }
+  const state: unknown = JSON.parse(raw);
+  validateState(state, parent);
+  if (parentSessionId !== undefined) assertDelegationParent(state, parentSessionId);
+  return state;
+}
+
+export async function lockDelegationState(agentDir: string, parentSessionFile: string) {
+  const path = delegationStatePath(agentDir, parentSessionFile);
+  realpathSync(agentDir);
+  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+  chmodSync(dirname(dirname(path)), 0o700);
+  chmodSync(dirname(path), 0o700);
+  syncDirectorySync(dirname(dirname(path)));
+  syncDirectorySync(resolve(agentDir));
+  return lockSubagentState(path);
+}
+
+export async function updateDelegationState(
+  agentDir: string,
+  parentSessionFile: string,
+  mutate: (state: DelegationState) => void,
+): Promise<DelegationState> {
+  const parent = canonicalParentSessionFile(parentSessionFile);
+  const path = delegationStatePath(agentDir, parent);
+  const lock = await lockDelegationState(agentDir, parent);
+  try {
+    const state = readDelegationState(agentDir, parent) ?? {
+      version: 1, parentSessionFile: parent, groups: [], tasks: [], messages: [], deliveries: [],
+    };
+    const result: unknown = mutate(state);
+    if (object(result) && typeof result.then === "function") throw new Error("State mutations must be synchronous");
+    validateState(state, parent);
+    lock.assertHeld();
+    writePrivateFileAtomicSync(path, JSON.stringify(state), { durable: true });
+    return state;
+  } finally {
+    await lock.release();
+  }
+}
