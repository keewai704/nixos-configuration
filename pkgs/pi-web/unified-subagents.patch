+    assert.ok(binding.data.tools.includes("send_subagent_message"));
+    for (const name of names) assert.equal(binding.data.tools.includes(name), false);
+    for (const name of names) assert.equal(binding.data.allTools.includes(name), false);
+  }
+  for (const request of f.requests) {
+    for (const name of names) assert.equal(getCurrentTools(request.context.messages).some((tool) => tool.name === name), false);
+  }
+  const run = readSubagentRun(entries, second.sessionId, second.sessionFile);
+  assert.equal(run.parentSessionId, f.original.getSessionId());
+  assert.equal(run.result, "Resumed fixture complete");
+  assert.equal(readDelegationState(agentDir, second.sessionFile), undefined);
