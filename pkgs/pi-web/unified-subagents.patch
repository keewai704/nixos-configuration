new file mode 100644
index 0000000..25274af
--- /dev/null
+++ b/lib/subagent-history.ts
@@ -0,0 +1,42 @@
+import { readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import type { SessionEntry } from "./types";
+import type { SubagentParentHost } from "./subagent-session";
+import { canonicalParentSessionFile } from "./subagent-state";
+import { readSubagentParentSessionFile, readSubagentRun, readSubagentSessionResources } from "./subagents";
+
+function directoryEntries(path: string) {
+  try { return readdirSync(path, { withFileTypes: true }); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+}
+
+export function findSubagentHistory(parent: Pick<SubagentParentHost, "parentSessionId" | "sessionFile" | "cwd">,
+  id: string, agentDir: string) {
+  if (!/^[a-f\d]{8}(?:-[a-f\d]{4}){3}-[a-f\d]{12}$/i.test(id)) return null;
+  const candidates = new Set<string>();
+  const nearby = SessionManager.findById(parent.cwd, id, dirname(parent.sessionFile));
+  if (nearby) candidates.add(canonicalParentSessionFile(nearby));
+  const root = join(agentDir, "sessions");
+  for (const directory of [root, ...directoryEntries(root).filter((entry) => entry.isDirectory()).map((entry) => join(root, entry.name))]) {
+    for (const file of directoryEntries(directory)) {
+      if (file.isFile() && file.name.endsWith(`_${id}.jsonl`)) candidates.add(canonicalParentSessionFile(join(directory, file.name)));
+    }
+  }
+  const matches = [...candidates].map((file) => SessionManager.open(file)).filter((manager) => manager.getSessionId() === id);
+  if (matches.length > 1) throw new Error("Ambiguous child session identity");
+  const manager = matches[0];
+  if (!manager) return null;
+  const entries = manager.getEntries() as unknown as SessionEntry[];
+  const run = readSubagentRun(entries, id, manager.getSessionFile()!);
+  const parentFile = readSubagentParentSessionFile(entries);
+  if (!run) return null;
+  if (run.parentSessionId !== parent.parentSessionId || !parentFile
+    || canonicalParentSessionFile(parentFile) !== canonicalParentSessionFile(parent.sessionFile)) {
+    throw new Error("The child does not belong to this parent");
+  }
+  return { run, resources: readSubagentSessionResources(entries) };
+}
