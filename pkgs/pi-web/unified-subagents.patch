diff --git a/lib/subagent-process.ts b/lib/subagent-process.ts
new file mode 100644
index 0000000..1f3f7a3
--- /dev/null
+++ b/lib/subagent-process.ts
@@ -0,0 +1,49 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+export interface ProcessIdentity {
+  pid: number;
+  bootId: string;
+  startTime: string;
+}
+
+function bootIdentity(procRoot: string): string {
+  try {
+    const bootId = readFileSync(join(procRoot, "sys/kernel/random/boot_id"), "utf8").trim();
+    if (!/^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/i.test(bootId)) throw new Error("Invalid boot ID");
+    return bootId;
+  } catch (cause) {
+    throw new Error("Cannot establish process boot identity; ownership is unchanged", { cause });
+  }
+}
+
+export function readProcessIdentity(pid: number, procRoot = "/proc"): ProcessIdentity | undefined {
+  if (!Number.isSafeInteger(pid) || pid <= 0) throw new Error("Invalid process identity PID");
+  const bootId = bootIdentity(procRoot);
+  try {
+    const source = readFileSync(join(procRoot, String(pid), "stat"), "utf8");
+    const close = source.lastIndexOf(")");
+    if (!source.startsWith(`${pid} (`) || close < source.indexOf("(")) throw new Error("Invalid process stat identity");
+    const fields = source.slice(close + 1).trim().split(/\s+/);
+    if (!/^[A-Za-z]$/.test(fields[0])) throw new Error("Invalid process state");
+    if (fields[0] === "Z" || fields[0] === "X") return undefined;
+    const startTime = fields[19];
+    if (!startTime || !/^\d+$/.test(startTime)) throw new Error("Invalid process stat");
+    return { pid, bootId, startTime };
+  } catch (cause) {
+    if ((cause as NodeJS.ErrnoException).code === "ENOENT") {
+      try {
+        process.kill(pid, 0);
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === "ESRCH") return undefined;
+      }
+    }
+    throw new Error(`Cannot establish process identity for PID ${pid}; ownership is unchanged`, { cause });
+  }
+}
+
+export function isProcessAlive(owner: ProcessIdentity, procRoot = "/proc"): boolean {
+  if (bootIdentity(procRoot) !== owner.bootId) return false;
+  const identity = readProcessIdentity(owner.pid, procRoot);
+  return identity !== undefined && identity.startTime === owner.startTime;
+}
