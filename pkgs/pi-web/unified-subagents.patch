+        const { controller } = binding;
+        return {
+          assertOwnsState: controller.assertOwnsState,
+          quiesce: (files) => controller.withNotificationsPaused(async () => {
+            if (files.some((file) => file.path === path)) await shutdownParent(id);
+            else {
+              for (const task of controller.list().tasks) {
+                if (task.sessionFile && files.some((file) => file.id === task.sessionId
+                  && file.path === canonicalParentSessionFile(task.sessionFile!))) await controller.cancel(controller.parentActor, task.id);
+              }
+            }
+          }),
+        };
+      },
+    });
   }

   return {
-    extensionRuntime: { start, resume, get, steer, notifyParent },
-    getActiveStatus,
-    get,
-    steer,
-    abort,
+    getController, forParent, inspect, tasks, controlTask, get, shutdownParent, reactivateParent, beforeSettle, settled, guardDeletion,
+    hasActive: (id: string) => bindings.get(id)?.controller.list().tasks.some(active) ?? false,
+    getActiveStatus(id: string) {
+      for (const { controller } of bindings.values()) {
+        const task = controller.list().tasks.find((task) => task.sessionId === id);
+        if (task && active(task)) return task.status;
+      }
+      return undefined;
+    },
+    steer: (id: string, message: string) => controlChild(id, "steer", message),
+    abort: (id: string) => controlChild(id, "abort"),
   };
 }
