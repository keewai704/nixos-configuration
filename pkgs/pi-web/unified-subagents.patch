@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const load = () => createJiti(import.meta.url).import("./subagent-task-types.ts");
+
+test("structured assignments keep facts separate from ordered instructions", async () => {
+  const { formatAssignment } = await load();
+  assert.equal(formatAssignment("Inspect only"), "Inspect only");
+  assert.equal(formatAssignment({ goal: "Find caller", context: ["Scope is parser"], instructions: ["Read parser", "Report paths"] }),
+    "## Goal\n\nFind caller\n\n## Context\n\n- Scope is parser\n\n## Instructions\n\n1. Read parser\n2. Report paths");
+});
+
+test("malformed assignments are rejected before a child can receive them", async () => {
+  const { formatAssignment } = await load();
+  for (const value of [" ", { goal: "", context: [], instructions: ["Read"] },
+    { goal: "Inspect", context: "Not an array", instructions: ["Read"] },
+    { goal: "Inspect", context: [" "], instructions: ["Read"] },
+    { goal: "Inspect", context: [], instructions: [] }]) {
+    assert.throws(() => formatAssignment(value), /assignment/i);
+  }
+});
+
+test("reports distinguish completion from questions and enforce byte budgets", async () => {
+  const { validateReport, validateMessage, reportExcerpt } = await load();
+  const report = { outcome: "needs_input", report: "Cannot decide", needs: "Choose A or B" };
+  assert.deepEqual(validateReport(report), report);
+  for (const value of [{ outcome: "success", report: "Done" },
+    { outcome: "needs_input", report: "Need help" },
+    { outcome: "completed", report: "Done", needs: "Unexpected" },
+    { outcome: "failed", report: " " },
+    { outcome: "completed", report: "a".repeat(256 * 1024 - 1) },
+    { outcome: "completed", report: "あ".repeat(90_000) }]) {
+    assert.throws(() => validateReport(value), /report/i);
+  }
+  assert.throws(() => validateMessage("あ".repeat(3000)), /message/i);
+  assert.equal(validateMessage("Hello"), "Hello");
+  assert.ok(Buffer.byteLength(reportExcerpt("あ".repeat(20_000))) <= 32 * 1024);
+});
diff --git a/lib/subagent-task-types.ts b/lib/subagent-task-types.ts
new file mode 100644
index 0000000..fbab176
--- /dev/null
+++ b/lib/subagent-task-types.ts
@@ -0,0 +1,178 @@
+import type { ThinkingLevel } from "@earendil-works/pi-agent-core";
+import type { SubagentResourceSnapshot } from "./subagents";
+
+export type Assignment = string | {
+  goal: string;
+  context: string[];
+  instructions: string[];
+};
+
+export type Dependency = { taskId: string; input: "report" | "integrated_changes" };
+export type DelegationReport =
+  | { outcome: "completed" | "failed"; report: string }
+  | { outcome: "needs_input"; report: string; needs: string };
+export type TaskStatus =
+  | "blocked" | "queued" | "running" | "cancelling" | "needs_input"
+  | "completed" | "failed" | "aborted" | "interrupted";
+
+export type DelegationActor =
+  | { kind: "parent"; parentSessionId: string }
+  | { kind: "child"; parentSessionId: string; taskId: string; sessionId: string; attempt: number };
+
+export type DelegationNotification = {
+  deliveryId: string;
+  parentSessionId: string;
+  taskId: string;
+  attempt: number;
+  sessionId?: string;
+} & (
+  | { kind: "report"; status: TaskStatus; report: DelegationReport }
+  | { kind: "message"; from: string; text: string }
+);
+
+export interface TaskInput {
+  id: string;
+  parentToolCallId?: string;
+  profile?: string;
+  description: string;
+  assignment: Assignment;
+  needs: Dependency[];
+  inputRevision?: string;
+  specialistPrompt?: string;
+  model?: string;
+  thinking?: ThinkingLevel;
+  inputFiles?: string[];
+  inheritContext?: boolean;
+  runInBackground?: boolean;
+  maxTurns?: number;
+  isolation?: "worktree";
+}
+
+export interface ParentOwnership {
+  parentSessionFile: string;
+  token: string;
+  pid: number;
+  bootId: string;
+  startTime: string;
+}
+
+export interface TaskRecord extends TaskInput {
+  groupId: string;
+  status: TaskStatus;
+  attempt: number;
+  createdAt: string;
+  updatedAt: string;
+  sessionId?: string;
+  sessionFile?: string;
+  historyPersisted?: boolean;
+  resources?: SubagentResourceSnapshot;
+  worktreePath?: string;
+  worktreeBranch?: string;
+  report?: DelegationReport;
+  releaseRevision?: string;
+  closedAt?: string;
+  lastInput?: string;
+}
+
+export interface TaskMessage {
+  id: string;
+  groupId: string;
+  from: string;
+  to: string;
+  text: string;
+  createdAt: string;
+  deliveredAt?: string;
+}
+
+export type PendingDelivery = {
+  id: string;
+  taskId: string;
+  attempt: number;
+  createdAt: string;
+  acknowledgedAt?: string;
+} & (
+  | { kind: "report"; report: DelegationReport }
+  | { kind: "message"; messageId: string; text: string }
+);
+
+export interface DelegationState {
+  version: 1;
+  parentSessionFile: string;
+  parentSessionId?: string;
+  owner?: ParentOwnership;
+  groups: Array<{ id: string; createdAt: string }>;
+  tasks: TaskRecord[];
+  messages: TaskMessage[];
+  deliveries: PendingDelivery[];
+}
+
+export const MESSAGE_BYTE_LIMIT = 8 * 1024;
+export const REPORT_BYTE_LIMIT = 256 * 1024;
+export const REPORT_EXCERPT_BYTE_LIMIT = 32 * 1024;
+
+function nonBlank(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+export function formatAssignment(value: unknown): string {
+  if (typeof value === "string") {
+    if (!nonBlank(value)) throw new Error("The assignment must not be blank");
+    return value;
+  }
+  if (!record(value) || !nonBlank(value.goal)
+    || !Array.isArray(value.context) || !value.context.every(nonBlank)
+    || !Array.isArray(value.instructions) || value.instructions.length === 0 || !value.instructions.every(nonBlank)
+    || Object.keys(value).some((key) => !["goal", "context", "instructions"].includes(key))) {
+    throw new Error("The assignment requires a goal, context array, and nonempty instructions");
+  }
+  return [
+    "## Goal", "", value.goal, "", "## Context", "",
+    value.context.length ? value.context.map((item) => `- ${item}`).join("\n") : "None.",
+    "", "## Instructions", "", value.instructions.map((item, index) => `${index + 1}. ${item}`).join("\n"),
+  ].join("\n");
+}
+
+export function validateReport(value: unknown): DelegationReport {
+  if (!record(value) || typeof value.outcome !== "string" || !["completed", "failed", "needs_input"].includes(value.outcome)
+    || !nonBlank(value.report) || Buffer.byteLength(value.report, "utf8") > REPORT_BYTE_LIMIT
+    || Object.keys(value).some((key) => !["outcome", "report", "needs"].includes(key))) {
+    throw new Error("Invalid subagent report or report byte limit exceeded");
+  }
+  if (Buffer.byteLength(JSON.stringify(value), "utf8") > REPORT_BYTE_LIMIT) {
+    throw new Error("The structured report exceeds 256 KiB");
+  }
+  if (value.outcome === "needs_input") {
+    if (!nonBlank(value.needs) || Buffer.byteLength(value.needs, "utf8") > MESSAGE_BYTE_LIMIT) {
+      throw new Error("An input-required report needs a nonblank, bounded question");
+    }
+    return { outcome: "needs_input", report: value.report, needs: value.needs };
+  }
+  if (value.needs !== undefined) throw new Error("Only an input-required report may include needs");
+  return { outcome: value.outcome as "completed" | "failed", report: value.report };
+}
+
+export function validateMessage(value: unknown): string {
+  if (!nonBlank(value) || Buffer.byteLength(value, "utf8") > MESSAGE_BYTE_LIMIT) {
+    throw new Error("A subagent message must be nonblank and at most 8 KiB");
+  }
+  return value;
+}
+
+export function reportExcerpt(text: string): string {
+  if (Buffer.byteLength(text, "utf8") <= REPORT_EXCERPT_BYTE_LIMIT) return text;
+  const suffix = "\n\n[Truncated; open the child session for the complete report.]";
+  const limit = REPORT_EXCERPT_BYTE_LIMIT - Buffer.byteLength(suffix, "utf8");
+  let bytes = 0;
+  let end = 0;
+  for (const char of text) {
+    const size = Buffer.byteLength(char, "utf8");
+    if (bytes + size > limit) break;
+    bytes += size;
+    end += char.length;
+  }
+  return text.slice(0, end) + suffix;
+}
