+import test from "node:test";
+import { createJiti } from "jiti";
+const { createSubagentNotificationOutbox } = await createJiti(import.meta.url).import("./subagent-notifications.ts");
+const message = (id) => ({ customType: "native-subagent", content: "Report", display: true, details: { deliveryId: id } });
+const boundary = (pendingMessages = []) => ({ entries: [], continue: false, outcome: "completed", context: { pendingMessages, canContinue: false } });
+
+test("recovery composes with earlier boundary drafts and continuation requests", () => {
+  const outbox = createSubagentNotificationOutbox();
+  outbox.offer(message("one"));
+  const earlier = [{ type: "custom", customType: "earlier", data: { retained: true } },
+    { type: "context_edit", targetId: "old", replacement: "edited" }];
+  const result = outbox.beforeSettle({ ...boundary(), entries: earlier, continue: true }, []);
+  assert.deepEqual(result.entries, [...earlier, { type: "custom_message", ...message("one") }]);
+  assert.deepEqual(earlier.length, 2);
+  assert.equal(outbox.beforeSettle({ ...boundary(), entries: result.entries }, []), undefined);
+  assert.equal(outbox.beforeSettle({ ...boundary(), outcome: "error", continue: true }, []).continue, true);
+});
+
+test("a dropped offer is recovered at the SDK boundary rather than stranded behind inflight deduplication", () => {
+  const outbox = createSubagentNotificationOutbox();
+  outbox.offer(message("one"));
+  assert.equal(outbox.beforeSettle(boundary([{ role: "custom", ...message("one") }]), []), undefined);
+  const repair = outbox.beforeSettle(boundary(), []);
+  assert.deepEqual(repair, { entries: [{ type: "custom_message", ...message("one") }], continue: true });
+  assert.equal(outbox.beforeSettle(boundary(), [{ type: "custom_message", ...message("one") }]), undefined);
+  assert.equal(outbox.beforeSettle(boundary(), []), undefined);
+});
+
+test("buffered SDK entries prevent duplicate offers and an aborted boundary does not force another model turn", () => {
+  const outbox = createSubagentNotificationOutbox();
+  outbox.offer(message("one"));
+  assert.equal(outbox.beforeSettle(boundary(), [{ type: "custom_message", ...message("one") }]), undefined);
+  outbox.offer(message("two"));
+  assert.equal(outbox.beforeSettle({ ...boundary(), outcome: "aborted" }, []).continue, false);
+  assert.equal(outbox.beforeSettle({ ...boundary(), outcome: "error" }, []).continue, false);
+});
+
+test("the actual CLI SDK recovers a report discarded by clearQueue and abort on the next parent turn", async () => {
+  const directory = mkdtempSync(join(tmpdir(), "pi-notification-sdk-"));
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  process.env.PI_CODING_AGENT_DIR = directory;
+  mkdirSync(join(directory, "agents"));
+  writeFileSync(join(directory, "agents", "settings.json"), '{"version":1,"builtInEnabled":true,"maxConcurrent":4}');
+  let session;
+  let firstTurn;
+  try {
+    const { ModelRuntime, SessionManager, SettingsManager, DefaultResourceLoader, createAgentSession, initTheme } = await import("@earendil-works/pi-coding-agent");
+    const { InMemoryCredentialStore, createAssistantMessageEventStream, getCurrentTools } = await import("@earendil-works/pi-ai");
+    const { default: factory } = await createJiti(import.meta.url).import("./subagent-cli-extension.ts");
+    initTheme("dark");
+    const runtime = await ModelRuntime.create({ credentials: new InMemoryCredentialStore(), modelsPath: null,
+      modelsStorePath: join(directory, "models.json"), refreshOnCreate: false, allowModelNetwork: false });
+    let parentRequests = 0;
+    const parentContexts = [];
+    runtime.registerProvider("notification-fixture", { api: "openai-completions", baseUrl: "http://127.0.0.1:1", apiKey: "fixture",
+      models: [{ id: "fixture", name: "Fixture", reasoning: false, input: ["text"], contextWindow: 32768, maxTokens: 1024,
+        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }],
+      streamSimple(model, context, options) {
+        const events = createAssistantMessageEventStream();
+        const isChild = getCurrentTools(context.messages).some((tool) => tool.name === "report_subagent");
+        if (!isChild) parentContexts.push(structuredClone(context));
+        const held = !isChild && parentRequests++ === 0;
+        const base = { role: "assistant", provider: model.provider, model: model.id, api: model.api, timestamp: Date.now(),
+          usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2,
+            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } } };
+        const finish = () => {
+          if (held) events.push({ type: "error", reason: "aborted", error: { ...base, content: [], stopReason: "aborted", errorMessage: "Fixture aborted" } });
+          else events.push({ type: "done", reason: "stop", message: { ...base, content: [{ type: "text", text: "Fixture report" }], stopReason: "stop" } });
+          events.end();
+        };
+        if (held && !options.signal?.aborted) options.signal?.addEventListener("abort", finish, { once: true });
+        else queueMicrotask(finish);
+        return events;
+      },
+    });
+    const settingsManager = SettingsManager.inMemory({ compaction: { enabled: false } });
+    const loader = new DefaultResourceLoader({ cwd: directory, agentDir: directory, settingsManager, noExtensions: true,
+      noSkills: true, noPromptTemplates: true, noThemes: true, extensionFactories: [
+        { name: "earlier-boundary", factory(pi) {
+          pi.on("agent_before_settle", (event, ctx) => {
+            if (event.outcome === "completed" && !ctx.sessionManager.getEntries().some((entry) => entry.customType === "composition-fixture")) {
+              return { entries: [...event.entries, { type: "custom_message", customType: "composition-fixture",
+                content: "Earlier extension context", display: true }] };
+            }
+          });
+        } },
+        { name: "native-cli", factory },
+      ] });
+    await loader.reload();
+    assert.deepEqual(loader.getExtensions().errors, []);
+    ({ session } = await createAgentSession({ cwd: directory, agentDir: directory, settingsManager, resourceLoader: loader,
+      modelRuntime: runtime, model: runtime.getModel("notification-fixture", "fixture"), sessionManager: SessionManager.create(directory) }));
+    await session.bindExtensions({ mode: "json" });
+    assert.ok(session.getActiveToolNames().includes("Agent"));
+    const call = (name, args) => session.agent.state.tools.find((tool) => tool.name === name).execute("fixture-call", args);
+    const until = async (predicate) => {
+      const deadline = Date.now() + 10000;
+      while (!predicate()) {
+        if (Date.now() > deadline) throw new Error("Timed out waiting for the actual SDK notification");
+        await new Promise((resolve) => setTimeout(resolve, 5));
+      }
+    };
+    firstTurn = session.prompt("Wait while the child runs");
+    await until(() => parentRequests === 1);
+    const started = await call("Agent", { id: "notification", subagent_type: "scout", prompt: "Inspect", run_in_background: true });
+    assert.notEqual(started.isError, true);
+    await until(() => session.agent.peekQueuedMessages().some((message) => message.details?.deliveryId));
+    session.clearQueue();
+    await session.abort();
+    await firstTurn;
+    assert.equal(session.sessionManager.getEntries().filter((entry) => entry.type === "custom_message" && entry.details?.deliveryId).length, 0);
+    await session.prompt("Continue after clearing the queue");
+    const receipts = session.sessionManager.getEntries().filter((entry) => entry.type === "custom_message" && entry.details?.deliveryId);
+    assert.equal(receipts.length, 1);
+    assert.match(receipts[0].content, /Fixture report/);
+    assert.equal(parentRequests, 3);
+    assert.ok(JSON.stringify(parentContexts.at(-1).messages).includes(JSON.stringify(receipts[0].content).slice(1, -1)));
+    assert.match(JSON.stringify(parentContexts.at(-1).messages), /Earlier extension context/);
+    assert.equal(session.sessionManager.getEntries().filter((entry) => entry.customType === "composition-fixture").length, 1);
+    const state = await call("manage_subagents", { action: "list" });
+    assert.equal(state.details.pendingDeliveries.length, 0);
+  } finally {
+    if (session) {
+      await session.abort();
+      await firstTurn;
+      await session.extensionRunner.emit({ type: "session_shutdown", reason: "quit" });
+      session.dispose();
+    }
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
