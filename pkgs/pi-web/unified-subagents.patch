+++ b/lib/subagent-managed-files.ts
@@ -0,0 +1,32 @@
+import { readlinkSync, realpathSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+
+export class ManagedSubagentFileError extends Error {
+  readonly status = 403;
+}
+
+export function isManagedSubagentFile(path: string, seen = new Set<string>()): boolean {
+  let current = resolve(path);
+  while (true) {
+    if (current === "/nix/store" || current.startsWith("/nix/store/")) return true;
+    if (seen.has(current)) throw new Error("Cannot resolve cyclic subagent configuration links");
+    seen.add(current);
+    try {
+      const resolved = realpathSync(current);
+      return resolved === "/nix/store" || resolved.startsWith("/nix/store/");
+    } catch (error) {
+      if (!["ENOENT", "ENOTDIR"].includes((error as NodeJS.ErrnoException).code ?? "")) throw error;
+    }
+    try { return isManagedSubagentFile(resolve(dirname(current), readlinkSync(current)), seen); }
+    catch (error) {
+      if (!["ENOENT", "ENOTDIR", "EINVAL"].includes((error as NodeJS.ErrnoException).code ?? "")) throw error;
+    }
+    const parent = dirname(current);
+    if (parent === current) return false;
+    current = parent;
+  }
+}
+
+export function assertSubagentFileWritable(path: string): void {
+  if (isManagedSubagentFile(path)) throw new ManagedSubagentFileError("This subagent configuration is managed by Nix and is read-only");
+}
