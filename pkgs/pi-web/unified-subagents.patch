new file mode 100644
index 0000000..2f4f4b9
--- /dev/null
+++ b/lib/subagent-notifications.ts
@@ -0,0 +1,32 @@
+import type { AgentBeforeSettleEvent, BoundaryResult, CustomMessageEntryDraft } from "@earendil-works/pi-coding-agent";
+import type { SessionEntry } from "./types";
+
+function deliveryId(value: unknown): string | undefined {
+  if (!value || typeof value !== "object") return;
+  const entry = value as Record<string, unknown>;
+  if (entry.type !== "custom_message" && entry.role !== "custom") return;
+  if (!entry.details || typeof entry.details !== "object") return;
+  const id = (entry.details as Record<string, unknown>).deliveryId;
+  return typeof id === "string" ? id : undefined;
+}
+
+export function createSubagentNotificationOutbox() {
+  const offers = new Map<string, CustomMessageEntryDraft>();
+  return {
+    offer(message: Omit<CustomMessageEntryDraft, "type">): void {
+      const entry: CustomMessageEntryDraft = { type: "custom_message", ...message };
+      const id = deliveryId(entry);
+      if (!id) throw new Error("A notification requires a delivery ID");
+      offers.set(id, entry);
+    },
+    beforeSettle(event: AgentBeforeSettleEvent, entries: readonly SessionEntry[]): BoundaryResult | undefined {
+      for (const entry of entries) {
+        const id = deliveryId(entry);
+        if (id) offers.delete(id);
+      }
+      const pending = new Set([...event.entries, ...event.context.pendingMessages].map(deliveryId));
+      const missing = [...offers].filter(([id]) => !pending.has(id)).map(([, entry]) => entry);
+      if (missing.length) return { entries: [...event.entries, ...missing], continue: event.continue || event.outcome === "completed" };
+    },
+  };
+}
diff --git a/lib/subagent-ownership.test.mjs b/lib/subagent-ownership.test.mjs
new file mode 100644
index 0000000..a00e5ca
--- /dev/null
+++ b/lib/subagent-ownership.test.mjs
@@ -0,0 +1,295 @@
+import assert from "node:assert/strict";
+import { execFile, spawn } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const jiti = createJiti(import.meta.url);
+const load = () => jiti.import("./subagent-ownership.ts");
+const loadState = () => jiti.import("./subagent-state.ts");
+const run = promisify(execFile);
+
+function fixture(t) {
+  const dir = mkdtempSync(join(tmpdir(), "pi-native-owner-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const parent = join(dir, "parent.jsonl");
+  writeFileSync(parent, "");
+  return { dir, parent };
+}
+
+function childClaim(dir, parent) {
+  const entry = new URL("./subagent-ownership.ts", import.meta.url).pathname;
+  const script = `import { createJiti } from "jiti";
+    const { claimParent } = await createJiti(${JSON.stringify(import.meta.url)}).import(${JSON.stringify(entry)});
+    try { const token = await claimParent(process.argv[1], process.argv[2]); console.log(JSON.stringify(token)); }
+    catch (error) { console.error(error.message); process.exitCode = 1; }`;
+  return run(process.execPath, ["--input-type=module", "-e", script, dir, parent], { cwd: new URL("..", import.meta.url).pathname });
+}
+
+test("a live parent owner excludes another process but not another parent", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent, assertOwner, releaseParent } = await load();
+  const owner = await claimParent(dir, parent);
+  await assert.rejects(childClaim(dir, parent), /already owned/i);
+  const other = join(dir, "other.jsonl");
+  writeFileSync(other, "");
+  const independent = await childClaim(dir, other);
+  assert.notEqual(JSON.parse(independent.stdout).token, owner.token);
+  assertOwner(dir, parent, owner);
+  await assert.rejects(releaseParent(dir, parent, { ...owner, token: "wrong" }), /owner/i);
+  assertOwner(dir, parent, owner);
+  await releaseParent(dir, parent, owner);
+  assert.throws(() => assertOwner(dir, parent, owner), /owner/i);
+});
+
+test("dead owners and reused process IDs interrupt unfinished work without restarting it", async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent, assertOwner, releaseParent } = await load();
+  const { updateDelegationState, readDelegationState } = await loadState();
+  const old = JSON.parse((await childClaim(dir, parent)).stdout);
+  await updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id: "batch", createdAt: "2026-01-01T00:00:00.000Z" });
+    state.tasks.push({ id: "a", profile: "scout", description: "a", assignment: "Inspect", needs: [],
+      groupId: "batch", status: "running", attempt: 1, createdAt: "2026-01-01T00:00:00.000Z", updatedAt: "2026-01-01T00:00:00.000Z" });
+  });
+  const current = await claimParent(dir, parent);
+  assert.notEqual(current.token, old.token);
+  assert.equal(readDelegationState(dir, parent).tasks[0].status, "interrupted");
+  await updateDelegationState(dir, parent, (state) => { state.owner.startTime = String(BigInt(current.startTime) + 1n); });
+  const stale = readDelegationState(dir, parent).owner;
+  assert.throws(() => assertOwner(dir, parent, stale), /owner|identity/i);
+  const afterReuse = await claimParent(dir, parent);
+  assert.notEqual(afterReuse.token, current.token);
+  await assert.rejects(releaseParent(dir, parent, current), /owner/i);
+  await releaseParent(dir, parent, afterReuse);
+});
+
+test("uncertain process identity is an error, not permission to take ownership", async (t) => {
+  const { dir } = fixture(t);
+  const { readProcessIdentity, isOwnerAlive } = await load();
+  const identity = readProcessIdentity(process.pid);
+  assert.equal(isOwnerAlive({ ...identity, token: "test", parentSessionFile: "/unused" }), true);
+  assert.throws(() => isOwnerAlive({ ...identity, token: "test", parentSessionFile: "/unused" }, dir), /identity/i);
+  mkdirSync(join(dir, "sys/kernel/random"), { recursive: true });
+  writeFileSync(join(dir, "sys/kernel/random/boot_id"), identity.bootId);
+  mkdirSync(join(dir, String(process.pid)));
+  writeFileSync(join(dir, String(process.pid), "stat"), Array(25).fill("0").join(" "));
+  assert.throws(() => readProcessIdentity(process.pid, dir), /identity/i);
+});
+
+async function suspendedMetadataWriter(dir, parent) {
+  const script = `import { writeSync } from "node:fs";
+    import { createJiti } from "jiti";
+    const { updateDelegationState } = await createJiti(${JSON.stringify(import.meta.url)}).import("./subagent-state.ts");
+    await updateDelegationState(process.argv[1], process.argv[2], (state) => {
+      writeSync(1, "held\\n");
+      process.kill(process.pid, "SIGSTOP");
+      state.groups.push({ id: "holder", createdAt: "2026-01-01T00:00:00.000Z" });
+    });`;
+  const child = spawn(process.execPath, ["--input-type=module", "-e", script, dir, parent], {
+    cwd: new URL("..", import.meta.url).pathname, stdio: ["ignore", "pipe", "pipe"],
+  });
+  let stderr = "";
+  child.stderr.on("data", (chunk) => { stderr += chunk; });
+  const done = new Promise((resolve) => child.once("close", (code, signal) => resolve({ code, signal, stderr })));
+  const ready = new Promise((resolve, reject) => {
+    child.once("error", reject);
+    child.stdout.once("data", (chunk) => chunk.toString().includes("held") ? resolve() : reject(new Error(chunk.toString())));
+    void done.then((result) => reject(new Error(`Holder exited before ready: ${JSON.stringify(result)}`)));
+  });
+  await ready;
+  return { child, done };
+}
+
+test("a suspended metadata holder cannot be displaced by timestamp expiry", { timeout: 10000 }, async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent } = await load();
+  const { readDelegationState } = await loadState();
+  const { child, done } = await suspendedMetadataWriter(dir, parent);
+  const now = Date.now;
+  const clock = t.mock.method(Date, "now", () => now() + 60000);
+  try {
+    await assert.rejects(claimParent(dir, parent), /lock|held|owner/i);
+  } finally {
+    clock.mock.restore();
+    child.kill("SIGCONT");
+    const result = await done;
+    assert.equal(result.code, 0, result.stderr);
+  }
+  assert.equal(readDelegationState(dir, parent).groups[0].id, "holder");
+});
+
+test("a proven-dead metadata holder is recovered without losing concurrent updates", { timeout: 10000 }, async (t) => {
+  const { dir, parent } = fixture(t);
+  const { updateDelegationState, readDelegationState } = await loadState();
+  const { child, done } = await suspendedMetadataWriter(dir, parent);
+  child.kill("SIGKILL");
+  await done;
+  await Promise.all(["one", "two"].map((id) => updateDelegationState(dir, parent, (state) => {
+    state.groups.push({ id, createdAt: "2026-01-01T00:00:00.000Z" });
+  })));
+  assert.deepEqual(readDelegationState(dir, parent).groups.map((group) => group.id).sort(), ["one", "two"]);
+});
+
+test("missing and malformed metadata ownership proof is never reclaimed because of its age", { timeout: 10000 }, async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent } = await load();
+  const { updateDelegationState, delegationStatePath } = await loadState();
+  await updateDelegationState(dir, parent, () => {});
+  const path = delegationStatePath(dir, parent);
+  const before = readFileSync(path, "utf8");
+  mkdirSync(`${path}.lock`);
+  const now = Date.now;
+  const clock = t.mock.method(Date, "now", () => now() + 60000);
+  try {
+    await assert.rejects(claimParent(dir, parent), /lock/i);
+    rmSync(`${path}.lock`, { recursive: true });
+    writeFileSync(`${path}.lock`, "{");
+    await assert.rejects(claimParent(dir, parent));
+    assert.equal(readFileSync(path, "utf8"), before);
+  } finally {
+    clock.mock.restore();
+  }
+});
+
+async function stoppedClaimAt(dir, parent, boundary) {
+  const script = `import fs from "node:fs";
+    import { basename } from "node:path";
+    import { createJiti } from "jiti";
+    let armed = true;
+    const pause = () => {
+      if (!armed) return;
+      armed = false;
+      fs.writeSync(1, "stopped\\n");
+      process.kill(process.pid, "SIGSTOP");
+    };
+    for (const name of ["mkdirSync", "linkSync", "unlinkSync"]) {
+      const original = fs[name];
+      fs[name] = (...args) => {
+        const file = basename(String(args[name === "linkSync" ? 1 : 0]));
+        const recovery = (name === "mkdirSync" && file === "recovery")
+          || (name === "linkSync" && file.includes("recovery-"));
+        if (process.argv[3] === "before-recovery" && recovery) pause();
+        const result = original.apply(fs, args);
+        if (process.argv[3] === "recovery" && recovery) pause();
+        if (process.argv[3] === "acquire" && ["mkdirSync", "linkSync"].includes(name) && file.endsWith(".lock")) pause();
+        if (process.argv[3] === "release" && name === "unlinkSync"
+          && (file === "owner.json" || file.includes(".lock.retired-"))) pause();
+        return result;
+      };
+    }
+    const { claimParent } = await createJiti(${JSON.stringify(import.meta.url)}).import("./subagent-ownership.ts");
+    await claimParent(process.argv[1], process.argv[2]);`;
+  const child = spawn(process.execPath, ["--input-type=module", "-e", script, dir, parent, boundary], {
+    cwd: new URL("..", import.meta.url).pathname, stdio: ["ignore", "pipe", "pipe"],
+  });
+  let stderr = "";
+  child.stderr.on("data", (chunk) => { stderr += chunk; });
+  const done = new Promise((resolve) => child.once("close", (code, signal) => resolve({ code, signal, stderr })));
+  let timer;
+  try {
+    await new Promise((resolve, reject) => {
+      timer = setTimeout(() => reject(new Error(`Child did not reach ${boundary}: ${stderr}`)), 5000);
+      child.once("error", reject);
+      child.stdout.once("data", (chunk) => chunk.toString().includes("stopped") ? resolve() : reject(new Error(chunk.toString())));
+      void done.then((result) => reject(new Error(`Child exited before ${boundary}: ${JSON.stringify(result)}`)));
+    });
+    return { child, done };
+  } catch (error) {
+    child.kill("SIGKILL");
+    await done;
+    throw error;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+test("a killed metadata recoverer does not strand the parent's ownership", { timeout: 15000 }, async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent, assertOwner } = await load();
+  const writer = await suspendedMetadataWriter(dir, parent);
+  writer.child.kill("SIGKILL");
+  await writer.done;
+  const recoverer = await stoppedClaimAt(dir, parent, "recovery");
+  try {
+    await assert.rejects(claimParent(dir, parent), /lock|held/i);
+  } finally {
+    recoverer.child.kill("SIGKILL");
+    await recoverer.done;
+  }
+  await assert.doesNotReject(async () => assertOwner(dir, parent, await claimParent(dir, parent)));
+});
+
+test("death during metadata release leaves the parent reclaimable", { timeout: 15000 }, async (t) => {
+  const { dir, parent } = fixture(t);
+  const { claimParent, assertOwner } = await load();
