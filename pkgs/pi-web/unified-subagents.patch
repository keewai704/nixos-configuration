+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const jiti = createJiti(import.meta.url);
+const load = () => jiti.import("./subagent-execution.ts");
+const turn = () => new Promise(setImmediate);
+
+function fixture() {
+  const prompt = Promise.withResolvers();
+  const abort = Promise.withResolvers();
+  const shutdown = Promise.withResolvers();
+  const persist = Promise.withResolvers();
+  const started = Promise.withResolvers();
+  const events = [];
+  const session = {
+    sessionId: "child", sessionFile: "/tmp/child.jsonl",
+    sessionManager: { getEntries: () => [] },
+    prompt: async () => { events.push("prompt"); started.resolve(); await prompt.promise; },
+    abort: async () => { events.push("abort"); await abort.promise; },
+    getLastAssistantText: () => "Inspected the fixture",
+    subscribe: () => () => {}, steer: async () => {},
+    extensionRunner: { emit: async () => { events.push("shutdown"); await shutdown.promise; } },
+    dispose: () => events.push("dispose"),
+  };
+  const child = { session, delegatedTask: "Inspect", chatOnly: false,
+    metadata: { version: 1, parentSessionId: "parent", parentSessionPath: "/tmp/parent.jsonl", profile: "scout",
+      task: "Inspect", description: "Inspect", runInBackground: true, createdAt: "2026-01-01T00:00:00.000Z",
+      resourceSnapshot: { version: 1, appendSystemPrompt: [], tools: ["read"], loadSkills: false, loadExtensions: false } } };
+  return { prompt, abort, shutdown, persist, started, events, child };
+}
+
+test("cancellation waits for prompt, abort, SDK shutdown and terminal persistence", async () => {
+  const { createSubagentAttempt } = await load();
+  const f = fixture();
+  const attempt = createSubagentAttempt({ create: async () => f.child,
+    persist: async () => { f.events.push("persist"); await f.persist.promise; } });
+  const running = attempt.start();
+  await f.started.promise;
+  let cancelled = false;
+  const stopping = attempt.cancel().then(() => { cancelled = true; });
+  f.prompt.resolve();
+  await turn();
+  assert.equal(cancelled, false);
+  assert.deepEqual(f.events, ["prompt", "abort"]);
+  f.abort.resolve();
+  await turn();
+  assert.deepEqual(f.events, ["prompt", "abort", "shutdown"]);
+  assert.equal(cancelled, false);
+  f.shutdown.resolve();
+  await turn();
+  assert.deepEqual(f.events, ["prompt", "abort", "shutdown", "dispose", "persist"]);
+  assert.equal(cancelled, false);
+  f.persist.resolve();
+  await stopping;
+  assert.equal((await running).status, "aborted");
+  assert.equal(attempt.phase, "finished");
+});
+
+test("queued cancellation does not allocate a child and shares one completion", async () => {
+  const { createSubagentAttempt } = await load();
+  let created = 0;
+  const saved = [];
+  const attempt = createSubagentAttempt({ create: async () => { created++; throw new Error("must not create"); },
+    persist: async (result) => saved.push(result.status) });
+  const [first, second] = await Promise.all([attempt.cancel(), attempt.start()]);
+  assert.equal(created, 0);
+  assert.equal(first, second);
+  assert.deepEqual(saved, ["aborted"]);
+});
+
+test("a structured input request ends the turn without waiting on its own tool", async () => {
+  const { createSubagentAttempt } = await load();
+  const f = fixture();
+  f.child.session.abort = async () => { f.events.push("abort"); f.prompt.resolve(); };
+  f.shutdown.resolve();
+  let saved;
+  const attempt = createSubagentAttempt({ create: async () => f.child, persist: async (result) => { saved = result; } });
+  const running = attempt.start();
+  await f.started.promise;
+  const report = { outcome: "needs_input", report: "Two targets are available", needs: "Which target?" };
+  attempt.report(report);
+  assert.throws(() => attempt.report(report), /already|settling/i);
+  const result = await running;
+  assert.equal(result.status, "needs_input");
+  assert.deepEqual(result.report, report);
+  assert.equal(saved, result);
+  assert.equal(f.events.filter((event) => event === "abort").length, 1);
+});
+
+test("setup failures preserve a created worktree location", async () => {
+  const { createSubagentAttempt } = await load();
+  const attempt = createSubagentAttempt({ create: async () => {
+    throw Object.assign(new Error("Missing required resource"), { worktreePath: "/tmp/retained-checkout", worktreeBranch: "native-test" });
+  }, persist: async () => {} });
+  const result = await attempt.start();
+  assert.equal(result.status, "failed");
+  assert.match(result.report.report, /Missing required resource/);
+  assert.equal(result.worktreePath, "/tmp/retained-checkout");
+  assert.equal(result.worktreeBranch, "native-test");
+});
+
+test("the parent's queue slot stays occupied until cancelled SDK teardown finishes", async () => {
+  const { createSubagentAttempt } = await load();
+  const { SubagentQueue } = await jiti.import("./subagent-queue.ts");
+  const queue = new SubagentQueue();
+  const f = fixture();
+  f.shutdown.resolve();
+  const first = createSubagentAttempt({ create: async () => f.child, persist: async () => {} });
+  const one = queue.enqueue("parent", 1, first.start, () => {}, first.cancel);
+  await f.started.promise;
+  let secondStarted = false;
+  const two = queue.enqueue("parent", 1, async () => { secondStarted = true; }, () => {});
+  const stopping = first.cancel();
+  f.prompt.resolve();
+  await turn();
+  assert.equal(secondStarted, false);
+  f.abort.resolve();
+  await stopping;
+  await one.promise;
+  await two.promise;
+  assert.equal(secondStarted, true);
+});
+
+test("cancellation can detach a display while its session binding is still pending", async () => {
+  const { createSubagentAttempt } = await load();
+  const f = fixture();
+  const binding = Promise.withResolvers();
+  const registered = Promise.withResolvers();
+  f.abort.resolve();
+  f.shutdown.resolve();
+  let detached = 0;
+  const attempt = createSubagentAttempt({ create: async () => f.child, persist: async () => {},
+    onSession: () => {
+      registered.resolve();
+      return { ready: binding.promise, detach: () => { detached++; binding.resolve(); } };
+    } });
+  const running = attempt.start();
+  await registered.promise;
+  try {
+    await attempt.cancel();
+    assert.equal(detached, 1);
+    assert.equal((await running).status, "aborted");
+    assert.equal(f.events.includes("prompt"), false);
+  } finally {
+    binding.resolve();
+    f.prompt.resolve();
+    await running;
+  }
+});
+
+test("cancelled attempts still disclose SDK teardown failures", async () => {
+  const { createSubagentAttempt } = await load();
+  const f = fixture();
+  f.child.session.extensionRunner.emit = async () => { throw new Error("Extension shutdown failed"); };
+  const attempt = createSubagentAttempt({ create: async () => f.child, persist: async () => {} });
+  const running = attempt.start();
+  await f.started.promise;
+  const stopping = attempt.cancel();
+  f.prompt.resolve();
+  f.abort.resolve();
+  const result = await stopping;
+  assert.equal(result.status, "aborted");
+  assert.match(result.report.report, /Extension shutdown failed/);
+  assert.equal((await running).status, "aborted");
+  assert.equal(f.events.includes("dispose"), true);
+});
diff --git a/lib/subagent-execution.ts b/lib/subagent-execution.ts
new file mode 100644
index 0000000..9d3f418
--- /dev/null
+++ b/lib/subagent-execution.ts
@@ -0,0 +1,153 @@
+import type { CreatedSubagentSession } from "./subagent-session";
+import { reportExcerpt, validateReport, type DelegationReport } from "./subagent-task-types";
+
+export interface SubagentAttemptResult {
+  status: "completed" | "failed" | "needs_input" | "aborted";
+  report: DelegationReport;
+  child?: CreatedSubagentSession;
+  worktreePath?: string;
+  worktreeBranch?: string;
+}
+
+export interface SubagentSessionRegistration {
+  ready?: Promise<void>;
+  detach(): void;
+}
+
+interface AttemptOptions {
+  create(): Promise<CreatedSubagentSession>;
+  persist(result: SubagentAttemptResult): Promise<void>;
+  onState?(state: "running" | "cancelling"): void | Promise<void>;
+  onSession?(child: CreatedSubagentSession): SubagentSessionRegistration | void;
+}
+
+export interface SubagentAttempt {
+  readonly phase: "queued" | "running" | "cancelling" | "settling" | "finished";
+  start(): Promise<SubagentAttemptResult>;
+  cancel(): Promise<SubagentAttemptResult>;
+  report(value: unknown): void;
+}
+
+function lastProviderError(child: CreatedSubagentSession): string | undefined {
+  const entries = child.session.sessionManager.getEntries();
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const entry = entries[i];
+    if (entry.type !== "message" || entry.message.role !== "assistant") continue;
+    return entry.message.stopReason === "error" ? entry.message.errorMessage || "Provider returned an error" : undefined;
+  }
+}
+
+export function createSubagentAttempt(options: AttemptOptions): SubagentAttempt {
+  let phase: SubagentAttempt["phase"] = "queued";
+  let completion: Promise<SubagentAttemptResult> | undefined;
+  let child: CreatedSubagentSession | undefined;
+  let cancelled = false;
+  let reported: DelegationReport | undefined;
+  let aborting: Promise<void> | undefined;
+  let cancelling: Promise<void> | undefined;
+  let detach: (() => void) | undefined;
+  let detached = false;
+  const errors: string[] = [];
+  const remember = (error: unknown) => { errors.push(error instanceof Error ? error.message : String(error)); };
+  const detachOnce = () => {
+    if (!detached && detach) {
+      detached = true;
+      try { detach(); } catch (error) { remember(error); }
+    }
+  };
+  const requestAbort = () => {
+    if (!child || aborting) return;
+    detachOnce();
+    try { aborting = child.session.abort().catch(remember); } catch (error) { remember(error); aborting = Promise.resolve(); }
+  };
+
+  const execute = async (): Promise<SubagentAttemptResult> => {
+    let unsubscribe: (() => void) | undefined;
+    let worktreePath: string | undefined;
+    let worktreeBranch: string | undefined;
+    let maxTurnsReached = false;
+    try {
+      if (!cancelled) {
+        phase = "running";
+        await options.onState?.("running");
+      }
+      if (!cancelled) {
+        child = await options.create();
+        const registration = options.onSession?.(child);
+        detach = registration?.detach;
+        if (cancelled || reported) { detachOnce(); requestAbort(); }
+        await registration?.ready;
+        if (!cancelled && !reported) {
+          const limit = child.maxTurns;
+          let turns = 0;
+          if (limit) unsubscribe = child.session.subscribe((event) => {
+            if (event.type !== "turn_end") return;
+            turns++;
+            if (turns === limit) {
+              void child!.session.steer("You have reached your turn limit. Wrap up and provide your final answer now.").catch(remember);
+            } else if (turns > limit) {
+              maxTurnsReached = true;
+              requestAbort();
+            }
+          });
+          await child.session.prompt(child.delegatedTask, { source: "rpc" });
+          if (!cancelled && !reported) {
+            const error = lastProviderError(child);
+            if (error) errors.push(error);
+          }
+        }
+      }
+    } catch (error) {
+      if (!cancelled && !reported && !maxTurnsReached) remember(error);
+      if (error && typeof error === "object") {
+        if ("worktreePath" in error && typeof error.worktreePath === "string") worktreePath = error.worktreePath;
+        if ("worktreeBranch" in error && typeof error.worktreeBranch === "string") worktreeBranch = error.worktreeBranch;
+      }
+    } finally {
+      phase = "settling";
+      unsubscribe?.();
+      await cancelling;
+      await aborting;
+      detachOnce();
+      if (child) {
+        try { await child.session.extensionRunner.emit({ type: "session_shutdown", reason: "quit" }); } catch (error) { remember(error); }
+        try { child.session.dispose(); } catch (error) { remember(error); }
+      }
+    }
+    let report: DelegationReport;
+    try {
+      report = validateReport(cancelled ? { outcome: "failed", report: reportExcerpt(["Cancelled by the parent.", ...errors].join("\n")) }
+        : errors.length ? { outcome: "failed", report: reportExcerpt(errors.join("\n")) }
+        : reported ?? { outcome: "completed", report: child?.session.getLastAssistantText()?.trim() || "Completed without text output." });
+    } catch (error) {
+      report = { outcome: "failed", report: reportExcerpt(error instanceof Error ? error.message : String(error)) };
+    }
+    const result: SubagentAttemptResult = {
+      status: cancelled ? "aborted" : report.outcome, report, child,
+      worktreePath: child?.metadata.worktreePath ?? worktreePath,
+      worktreeBranch: child?.metadata.worktreeBranch ?? worktreeBranch,
+    };
+    await options.persist(result);
+    phase = "finished";
+    return result;
+  };
+  const start = () => completion ??= Promise.resolve().then(execute);
+  return {
+    get phase() { return phase; },
+    start,
+    cancel() {
+      if (!cancelled && !reported && phase !== "settling" && phase !== "finished") {
+        cancelled = true;
+        phase = "cancelling";
+        cancelling = Promise.resolve().then(() => options.onState?.("cancelling")).catch(remember);
+        requestAbort();
+      }
+      return start();
+    },
+    report(value) {
+      if (!child || phase !== "running" || reported) throw new Error("The attempt is not running, is settling, or already reported");
+      reported = validateReport(value);
+      requestAbort();
+    },
+  };
+}
