+  let reopened = 0;
+  let detached = 0;
+  let enabled = true;
+  const parent = { cwd, sessionFile: file, isAlive: () => true, isRunning: () => false, waitUntilReady: async () => {},
+    inner: { sessionId: id, sessionManager: manager, modelRuntime: runtime, model: runtime.getModel("adapter-fixture", "one"),
