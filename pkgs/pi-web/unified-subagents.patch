index 0000000..cdc7622
--- /dev/null
+++ b/lib/subagent-session.ts
@@ -0,0 +1,246 @@
+import { randomUUID } from "node:crypto";
+import { existsSync, realpathSync } from "node:fs";
+import { isAbsolute, relative, resolve, sep } from "node:path";
+import { getSupportedThinkingLevels, type Api, type Model } from "@earendil-works/pi-ai";
+import type { ThinkingLevel } from "@earendil-works/pi-agent-core";
+import {
+  createAgentSessionFromServices, createAgentSessionServices, getAgentDir, initTheme, SessionManager, SettingsManager,
+  type AgentSession, type ModelRuntime, type ToolDefinition,
+} from "@earendil-works/pi-coding-agent";
+import type { SessionEntry } from "./types";
+import type { StartSubagentRequest } from "./subagent-extension";
+import {
+  readSubagentRun, readSubagentParentSessionFile, resolveSubagentProfile, selectSubagentExtensionTools, withSubagentExtensionTools,
+  SUBAGENT_CONTROL_TOOL_NAMES, SUBAGENT_META_TYPE,
+  type SubagentMetadata, type SubagentResourceSnapshot, type SubagentSessionResources,
+} from "./subagents";
+import { buildSubagentPromptPlan } from "./subagent-prompt";
+import { appendSubagentInputFiles, loadSubagentInputFiles } from "./subagent-input";
+import { projectTrustReloadOptions } from "./project-trust";
+import { resolveShellTools } from "./powershell-settings";
+import { addWorktree, listWorktrees, resolveCommitRevision } from "./worktree";
+import { reportExcerpt, type DelegationNotification } from "./subagent-task-types";
+import { canonicalParentSessionFile } from "./subagent-state";
+
+export interface SubagentParentHost {
+  parentSessionId: string;
+  sessionFile: string;
+  cwd: string;
+  effectiveModel: { provider: string; id: string };
+  thinking?: ThinkingLevel;
+  resolveModelRuntime(): Promise<ModelRuntime>;
+  prepareModel?(runtime: ModelRuntime, model: Model<Api>): Promise<void>;
+  readEntries(): readonly SessionEntry[];
+  readContext(): unknown[];
+  sendNotification(message: DelegationNotification): Promise<void>;
+}
+
+export type ChildSessionInput = Omit<StartSubagentRequest, "parentContext" | "signal" | "onUpdate"> & {
+  inputRevision?: string;
+  specialistPrompt?: string;
+};
+
+export interface CreatedSubagentSession {
+  session: AgentSession;
+  metadata: SubagentMetadata;
+  delegatedTask: string;
+  maxTurns?: number;
+  chatOnly: boolean;
+}
+
+export function resolveSubagentModel(runtime: ModelRuntime, requested: string | undefined, inherited: { provider: string; id: string }) {
+  if (!requested) {
+    const model = runtime.getModel(inherited.provider, inherited.id);
+    if (!model) throw new Error(`Subagent model is unavailable: ${inherited.provider}/${inherited.id}`);
+    return model;
+  }
+  const slash = requested.indexOf("/");
+  const matches = slash > 0
+    ? [runtime.getModel(requested.slice(0, slash), requested.slice(slash + 1))].filter((model) => model !== undefined)
+    : runtime.getModels().filter((model) => model.id === requested);
+  if (matches.length !== 1) throw new Error(`Subagent model is unavailable or ambiguous: ${requested}`);
+  return matches[0];
+}
+
+function validateThinking(model: ReturnType<typeof resolveSubagentModel>, value: string): ThinkingLevel {
+  if (!(getSupportedThinkingLevels(model) as string[]).includes(value)) {
+    throw new Error(`Unsupported thinking level ${value} for ${model.provider}/${model.id}`);
+  }
+  return value as ThinkingLevel;
+}
+
+function requireTools(session: AgentSession, names: readonly string[]): void {
+  const available = new Set(session.getAllTools().map((tool) => tool.name));
+  const missing = names.filter((name) => !available.has(name));
+  if (missing.length) throw new Error(`Missing required subagent tools: ${missing.join(", ")}`);
+}
+
+async function servicesFor(cwd: string, runtime: ModelRuntime, resources: SubagentSessionResources, restoring: boolean) {
+  const agentDir = getAgentDir();
+  if (restoring) {
+    if ((resources.loadExtensions && !resources.extensionFiles) || (resources.loadSkills && !resources.skillFiles)) {
+      throw new Error("The legacy resource snapshot lacks the required resource paths; start a new task instead");
+    }
+    for (const path of [...(resources.extensionFiles ?? []), ...(resources.skillFiles ?? [])]) {
+      if (!existsSync(path)) throw new Error(`Missing required subagent resource: ${path}`);
+    }
+  }
+  initTheme();
+  const services = await createAgentSessionServices({
+    cwd, agentDir, modelRuntime: runtime, settingsManager: SettingsManager.create(cwd, agentDir),
+    resourceLoaderOptions: {
+      noExtensions: restoring || !resources.loadExtensions,
+      noSkills: restoring || !resources.loadSkills,
+      noPromptTemplates: true, noThemes: true,
+      ...(restoring ? { additionalExtensionPaths: resources.extensionFiles ?? [], additionalSkillPaths: resources.skillFiles ?? [] } : {}),
+      ...(resources.exactSystemPrompt !== undefined ? {
+        systemPrompt: resources.exactSystemPrompt,
+        systemPromptOverride: () => resources.exactSystemPrompt,
+      } : {}),
+      appendSystemPrompt: resources.exactSystemPrompt === undefined
+        ? resources.appendSystemPrompt
+        : resources.appendSystemPrompt.filter((prompt) => prompt !== resources.exactSystemPrompt),
+    },
+    resourceLoaderReloadOptions: projectTrustReloadOptions(cwd, agentDir),
+  });
+  const failures = [
+    ...services.diagnostics.filter((item) => item.type === "error").map((item) => item.message),
+    ...services.resourceLoader.getExtensions().errors.map((item) => item.error),
+    ...services.resourceLoader.getSkills().diagnostics.filter((item) => item.type === "error").map((item) => item.message),
+  ];
+  if (failures.length) throw new Error(failures.join("\n"));
+  return services;
+}
+
+export async function validateSubagentSelection(
+  parent: SubagentParentHost,
+  input: ChildSessionInput,
+) {
+  const profile = resolveSubagentProfile(parent.cwd, input.profile);
+  if (!profile) throw new Error(`Unknown or disabled subagent profile: ${input.profile}`);
+  const runtime = await parent.resolveModelRuntime();
+  const model = resolveSubagentModel(runtime, input.model ?? profile.model, parent.effectiveModel);
+  const thinking = validateThinking(model, input.thinking ?? profile.thinking ?? parent.thinking ?? "off");
+  const maxTurns = input.maxTurns ?? profile.maxTurns;
+  if (maxTurns !== undefined && (!Number.isSafeInteger(maxTurns) || maxTurns < 0)) throw new Error("max_turns must be a non-negative integer");
+  const writer = profile.loadExtensions || profile.tools.some((tool) => ["bash", "powershell", "write", "edit"].includes(tool));
+  if (writer && profile.isolation === "off") throw new Error("Native writers cannot disable worktree isolation");
+  return { profile, runtime, model, thinking, maxTurns, writer };
+}
+
+export async function createSubagentSession(
+  parent: SubagentParentHost,
+  input: ChildSessionInput,
+  customTools: ToolDefinition[] = [],
+  retained?: { path: string; branch: string },
+): Promise<CreatedSubagentSession> {
+  const { profile, runtime, model, thinking, maxTurns, writer } = await validateSubagentSelection(parent, input);
+  await parent.prepareModel?.(runtime, model);
+  const isolated = writer || input.isolation === "worktree" || profile.isolation === "worktree" || input.inputRevision !== undefined || !!retained;
+  if (isolated && !retained && !input.inputRevision?.trim()) throw new Error("An explicit committed input revision is required for an isolated task");
+  const revision = isolated && !retained ? await resolveCommitRevision(parent.cwd, input.inputRevision!) : undefined;
+  let worktree = retained;
+  let session: AgentSession | undefined;
+  try {
+    if (retained) await requireRetainedWorktree(parent.cwd, retained);
+    else if (isolated) worktree = await addWorktree(parent.cwd, `pi-native-agent-${randomUUID()}`, revision);
+    const cwd = worktree?.path ?? parent.cwd;
+    const inherit = input.inheritContext ?? profile.inheritContext;
+    const prompt = buildSubagentPromptPlan({
+      profileSystemPrompt: input.specialistPrompt ?? profile.systemPrompt, tools: profile.tools,
+      loadSkills: profile.loadSkills, loadExtensions: profile.loadExtensions, promptMode: profile.promptMode,
+      task: appendSubagentInputFiles(input.task, loadSubagentInputFiles(parent.cwd, input.inputFiles ?? [])),
+      ...(inherit ? { inheritedParentContext: `Parent conversation, for background only:\n${reportExcerpt(JSON.stringify(parent.readContext()))}` } : {}),
+    });
+    const resources: SubagentResourceSnapshot = {
+      version: 1, appendSystemPrompt: prompt.appendSystemPrompt, tools: profile.tools,
+      loadSkills: profile.loadSkills, loadExtensions: profile.loadExtensions,
+      ...(prompt.exactSystemPrompt !== undefined ? { exactSystemPrompt: prompt.exactSystemPrompt } : {}),
+    };
+    const services = await servicesFor(cwd, runtime, resources, false);
+    await parent.prepareModel?.(runtime, model);
+    const extensions = services.resourceLoader.getExtensions().extensions;
+    const extensionTools = profile.extensionTools?.length
+      ? selectSubagentExtensionTools(extensions, profile.extensionTools)
+      : extensions.flatMap((extension) => [...extension.tools.keys()]);
+    resources.tools = resolveShellTools(withSubagentExtensionTools(profile.tools,
+      [...extensionTools, ...customTools.map((tool) => tool.name)]), services.settingsManager.getDefaultTools());
+    resources.extensionFiles = extensions.map((extension) => extension.path);
+    resources.skillFiles = services.resourceLoader.getSkills().skills.map((skill) => skill.filePath);
+    const manager = SessionManager.create(cwd, undefined, { parentSession: parent.sessionFile });
+    const metadata: SubagentMetadata = {
+      version: 1, parentSessionId: parent.parentSessionId, parentSessionPath: parent.sessionFile,
+      parentToolCallId: input.parentToolCallId, profile: profile.name,
+      description: input.description.trim() || profile.displayName, task: input.task,
+      runInBackground: input.runInBackground ?? profile.runInBackground, createdAt: new Date().toISOString(),
+      resourceSnapshot: resources,
+      ...(worktree ? { worktreePath: worktree.path, worktreeBranch: worktree.branch } : {}),
+    };
+    manager.appendCustomEntry(SUBAGENT_META_TYPE, metadata);
+    manager.appendSessionInfo(metadata.description);
+    ({ session } = await createAgentSessionFromServices({ services, sessionManager: manager, model, thinkingLevel: thinking,
+      tools: resources.tools, excludeTools: [...SUBAGENT_CONTROL_TOOL_NAMES], customTools }));
+    requireTools(session, resources.tools);
+    return { session, metadata, delegatedTask: prompt.delegatedTask, ...(maxTurns ? { maxTurns } : {}),
+      chatOnly: resources.tools.length === 0 && !resources.loadExtensions && !resources.loadSkills };
+  } catch (cause) {
+    session?.dispose();
+    const error = new Error(`${cause instanceof Error ? cause.message : String(cause)}${worktree ? `; worktree retained at ${worktree.path}` : ""}`, { cause });
+    if (worktree) Object.assign(error, { worktreePath: worktree.path, worktreeBranch: worktree.branch });
+    throw error;
+  }
+}
+
+async function requireRetainedWorktree(parentCwd: string, retained: { path: string; branch: string }): Promise<void> {
+  if (!existsSync(retained.path)) throw new Error(`Retained worktree is missing: ${retained.path}`);
+  const path = realpathSync(retained.path);
+  const parentRelative = relative(path, realpathSync(parentCwd));
+  const containsParent = parentRelative === "" || (!isAbsolute(parentRelative) && parentRelative !== ".." && !parentRelative.startsWith(`..${sep}`));
+  const worktree = (await listWorktrees(parentCwd)).find((item) => resolve(item.path) === path);
+  if (!worktree || worktree.isMain || worktree.branch !== retained.branch || containsParent) {
+    throw new Error(`Retained worktree identity changed: ${retained.path}`);
+  }
+}
+
+export async function restoreSubagentSession(
+  parent: SubagentParentHost,
+  sessionFile: string,
+  resources: SubagentSessionResources,
+  overrides: { model?: string; thinking?: string } = {},
+  customTools: ToolDefinition[] = [],
+): Promise<{ session: AgentSession; chatOnly: boolean }> {
+  if (!existsSync(sessionFile)) throw new Error("The child has no persisted conversation to restore");
+  const manager = SessionManager.open(sessionFile);
+  const entries = manager.getEntries() as unknown as SessionEntry[];
+  const run = readSubagentRun(entries, manager.getSessionId(), sessionFile);
+  const parentFile = readSubagentParentSessionFile(entries);
+  if (!run || run.parentSessionId !== parent.parentSessionId || !parentFile
+    || canonicalParentSessionFile(parentFile) !== canonicalParentSessionFile(parent.sessionFile)) {
+    throw new Error("The child does not belong to this parent");
+  }
+  if ((resources.loadExtensions || resources.tools.some((tool) => ["bash", "powershell", "write", "edit"].includes(tool)))
+    && !run.worktreePath) throw new Error("Historical writers require their retained isolated worktree");
+  if (run.worktreePath) {
+    if (!run.worktreeBranch || resolve(manager.getCwd()) !== resolve(run.worktreePath)) throw new Error("Retained worktree identity changed");
+    await requireRetainedWorktree(parent.cwd, { path: run.worktreePath, branch: run.worktreeBranch });
+  }
+  const runtime = await parent.resolveModelRuntime();
+  const context = manager.buildSessionContext();
+  const inherited = context.model ? { provider: context.model.provider, id: context.model.modelId } : parent.effectiveModel;
+  const model = resolveSubagentModel(runtime, overrides.model, inherited);
+  const thinking = validateThinking(model, overrides.thinking ?? context.thinkingLevel ?? parent.thinking ?? "off");
+  await parent.prepareModel?.(runtime, model);
+  const services = await servicesFor(manager.getCwd(), runtime, resources, true);
+  await parent.prepareModel?.(runtime, model);
+  const { session } = await createAgentSessionFromServices({ services, sessionManager: manager, model, thinkingLevel: thinking,
+    tools: resources.tools, excludeTools: [...SUBAGENT_CONTROL_TOOL_NAMES], customTools });
+  try {
+    requireTools(session, resources.tools);
+    if (overrides.model) manager.appendModelChange(model.provider, model.id);
+    if (overrides.thinking) manager.appendThinkingLevelChange(thinking);
+    return { session, chatOnly: resources.tools.length === 0 && !resources.loadExtensions && !resources.loadSkills };
+  } catch (error) {
+    session.dispose();
+    throw error;
+  }
+}
