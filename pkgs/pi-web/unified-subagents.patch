+    if (typeof revision !== "string" || !OID.test(revision)) {
+      throw new Error("Release requires an explicit integrated commit OID, not HEAD or a branch");
+    }
+    const resolved = await resolveCommitRevision(host.cwd, revision);
+    if (resolved !== revision) throw new Error("Release must name the integrated commit itself");
+    await update((current) => {
+      requireOpen();
+      const task = taskIn(current, id);
+      if (task.status !== "completed" || task.report?.outcome !== "completed" || active.has(id)) {
+        throw new Error("Only a successful, fully settled prerequisite can be released");
+      }
+      if (task.releaseRevision && task.releaseRevision !== revision
+        && current.tasks.some((candidate) => candidate.attempt > 0
+          && candidate.needs.some((edge) => edge.taskId === id && edge.input === "integrated_changes"))) {
+        throw new Error("An attempted dependent already uses this integrated revision");
+      }
+      task.releaseRevision = revision;
+      task.updatedAt = now();
+    });
+    await scheduleReady();
+    return taskIn(ownedState(), id);
+  }
+
+  function acknowledgeChildMessages(current: DelegationState, task: TaskRecord): void {
+    if (!task.sessionFile || !existsSync(task.sessionFile)) return;
+    const receipts = new Set(SessionManager.open(task.sessionFile).getEntries().flatMap((entry) =>
+      entry.type === "custom_message" && object(entry.details) && typeof entry.details.nativeDelegationMessageId === "string"
+        ? [entry.details.nativeDelegationMessageId] : []));
+    for (const message of current.messages) {
+      if (message.to === task.id && !message.deliveredAt && receipts.has(message.id)) message.deliveredAt = now();
+    }
+  }
+
+  async function sendChildMessage(run: ActiveTask, message: TaskMessage): Promise<void> {
+    messageInflight.add(message.id);
+    run.offeredMessages.push(message.id);
+    await run.child!.session.sendCustomMessage({ customType: "native-subagent-message", display: true,
+      content: messageText(message), details: { nativeDelegationMessageId: message.id, from: message.from, to: message.to },
+    }, { deliverAs: "steer" });
+  }
+
+  async function deliverChildMessage(id: string): Promise<void> {
+    if (messageInflight.has(id)) return;
+    const current = ownedState();
+    const saved = current.messages.find((item) => item.id === id);
+    if (!saved || saved.deliveredAt || saved.to === "parent") return;
+    const run = active.get(saved.to);
+    if (!run?.child || !run.acceptingMessages || run.control?.phase !== "running") return;
+    await sendChildMessage(run, saved);
+  }
+
+  async function message(actor: DelegationActor, to: string, text: string): Promise<TaskMessage> {
+    validateMessage(text);
+    if (typeof to !== "string" || !to.trim()) throw new Error("A message recipient is required");
+    if (actor === parentActor) await claim();
+    else requireChild(actor);
+    const id = randomUUID();
+    await update((current) => {
+      requireOpen();
+      const from = actor === parentActor ? "parent" : requireChild(actor, current).id;
+      if (from === "parent" && to === "parent") throw new Error("A parent message needs a child recipient");
+      const source = from === "parent" ? undefined : taskIn(current, from);
+      const target = to === "parent" ? undefined : taskIn(current, to);
+      if (source && target && source.groupId !== target.groupId) {
+        throw new Error("Child messages cannot cross delegation groups");
+      }
+      const groupId = source?.groupId ?? target!.groupId;
+      const createdAt = now();
+      current.messages.push({ id, groupId, from, to, text, createdAt });
+      if (to === "parent") {
+        current.deliveries.push({
+          id: randomUUID(), kind: "message", messageId: id, text,
+          taskId: source!.id, attempt: source!.attempt, createdAt,
+        });
+      }
+    });
+    if (to === "parent") await reconcileInternal();
+    else await deliverChildMessage(id);
+    return ownedState().messages.find((item) => item.id === id)!;
+  }
+
+  function report(actor: DelegationActor, value: unknown): void {
+    const run = requireChild(actor);
+    run.control!.report(validateReport(value));
+  }
+
+  async function close(actor: DelegationActor, id: string, deliveryId: string): Promise<TaskRecord> {
+    requireParent(actor);
+    await claim();
+    if (active.has(id)) throw new Error("The attempt has not finished teardown");
+    await update((current) => {
+      requireOpen();
+      const task = taskIn(current, id);
+      const delivery = current.deliveries.find((item) => item.id === deliveryId);
+      if (active.has(id) || !delivery || delivery.kind !== "report"
+        || delivery.taskId !== id || delivery.attempt !== task.attempt || !task.report
+        || !["completed", "failed", "needs_input", "aborted", "interrupted"].includes(task.status)) {
+        throw new Error("The delivery is stale, unrelated, or not ready for verified close");
+      }
+      delivery.acknowledgedAt ??= now();
+      task.closedAt ??= now();
+      task.updatedAt = now();
+    });
+    inflight.delete(deliveryId);
+    return taskIn(ownedState(), id);
+  }
+
+  async function reconcileDeliveries(actor: DelegationActor): Promise<DeliveryResult> {
+    requireParent(actor);
+    await claim();
+    return reconcileInternal();
+  }
+
+  function shutdown(): Promise<void> {
+    if (shutdownPromise) return shutdownPromise;
+    stopping = true;
+    shutdownPromise = (async () => {
+      if (claiming) await claiming;
+      const results = await Promise.allSettled([...active.values()].map(stopRun));
+      await Promise.allSettled([...deliveryJobs]);
+      if (owner) {
+        await releaseParent(agentDir, parentFile, owner);
+        owner = undefined;
+      }
+      inflight.clear();
+      messageInflight.clear();
+      const rejected = results.find((result) => result.status === "rejected");
+      if (rejected?.status === "rejected") throw rejected.reason;
+      if (failure !== undefined) throw failure;
+    })();
+    return shutdownPromise;
+  }
+
+  return {
+    parentActor, startBatch, list, wait, assign, resume, history, cancel, release,
+    message, report, close, reconcileDeliveries, shutdown, assertOwnsState, withNotificationsPaused,
+  };
+}
diff --git a/lib/subagent-deletion.test.mjs b/lib/subagent-deletion.test.mjs
new file mode 100644
index 0000000..147ea18
--- /dev/null
+++ b/lib/subagent-deletion.test.mjs
@@ -0,0 +1,181 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync, mkdtempSync, readFileSync, rmSync, symlinkSync, unlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const jiti = createJiti(import.meta.url);
+const { guardSubagentDeletion } = await jiti.import("./subagent-deletion.ts");
+const { claimParent, releaseParent } = await jiti.import("./subagent-ownership.ts");
+const { readDelegationState, updateDelegationState } = await jiti.import("./subagent-state.ts");
+
+function fixture(t) {
+  const agentDir = mkdtempSync(join(tmpdir(), "pi-delete-guard-"));
+  t.after(() => rmSync(agentDir, { recursive: true, force: true }));
+  function session(name, parent) {
+    const file = { id: randomUUID(), path: join(agentDir, name + ".jsonl") };
+    const entries = [{ type: "session", id: file.id, version: 3, cwd: agentDir, timestamp: new Date().toISOString() }];
+    if (parent) entries.push({ type: "custom", customType: "pi-web:subagent", data: { version: 1,
+      parentSessionId: parent.id, parentSessionPath: parent.path, profile: "scout", description: "Inspect" } });
+    writeFileSync(file.path, entries.map((entry) => JSON.stringify(entry)).join("\n") + "\n");
+    return file;
+  }
+  const parent = session("parent");
+  const child = session("child", parent);
+  const plan = { deleted: [child], rewritten: [] };
+  const before = [parent, child].map((file) => readFileSync(file.path));
+  let shutdowns = 0;
+  let mutations = 0;
+  const options = { agentDir, plan, localOwner: () => undefined,
+    async shutdown() { shutdowns++; },
+    mutate() { mutations++; for (const file of plan.deleted) unlinkSync(file.path); } };
+  return { agentDir, parent, child, plan, options, session,
+    get shutdowns() { return shutdowns; }, get mutations() { return mutations; },
+    unchanged() { assert.deepEqual([parent, child].map((file) => readFileSync(file.path)), before); } };
+}
+
+test("a same-PID owner without the registered controller token cannot delete a child or its parent", async (t) => {
+  const f = fixture(t);
+  await claimParent(f.agentDir, f.parent.path);
+  for (const deleted of [[f.child], [f.parent, f.child]]) {
+    f.plan.deleted = deleted;
+    await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+    f.unchanged();
+  }
+  assert.equal(f.shutdowns, 0);
+  assert.equal(f.mutations, 0);
+});
+
+test("native parent aliases and rewritten forks are included in authorization before shutdown", async (t) => {
+  const f = fixture(t);
+  const alias = join(f.agentDir, "parent-alias.jsonl");
+  symlinkSync(f.parent.path, alias);
+  const child = f.session("alias-child", { id: f.parent.id, path: alias });
+  await claimParent(f.agentDir, f.parent.path);
+  f.plan.deleted = [child];
+  await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+  const ordinary = f.session("ordinary");
+  f.plan.deleted = [ordinary];
+  f.plan.rewritten = [f.parent];
+  await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+  assert.equal(f.shutdowns, 0);
+  assert.equal(f.mutations, 0);
+});
+
+test("a claim during shutdown is rejected by final locked authorization without deleting anything", async (t) => {
+  const f = fixture(t);
+  f.options.shutdown = async () => { await claimParent(f.agentDir, f.parent.path); };
+  await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+  f.unchanged();
+  assert.equal(f.mutations, 0);
+});
+
+test("shutdown may await a state write and flush a previously absent transcript without deadlocking", async (t) => {
+  const f = fixture(t);
+  unlinkSync(f.child.path);
+  f.options.shutdown = async () => {
+    await updateDelegationState(f.agentDir, f.child.path, () => {});
+    writeFileSync(f.child.path, JSON.stringify({ type: "session", id: f.child.id, version: 3, cwd: f.agentDir }) + "\n");
+  };
+  await guardSubagentDeletion(f.options);
+  assert.equal(existsSync(f.child.path), false);
+  assert.equal(f.mutations, 1);
+  assert.equal(readDelegationState(f.agentDir, f.child.path).owner, undefined);
+});
+
+test("scope changes while shutting down fail closed before filesystem mutation", async (t) => {
+  const f = fixture(t);
+  const other = f.session("other");
+  const replacement = readFileSync(f.child.path, "utf8").replaceAll(f.parent.path, other.path).replaceAll(f.parent.id, other.id);
+  f.options.shutdown = async () => { writeFileSync(f.child.path, replacement); };
+  await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+  assert.equal(f.mutations, 0);
+});
+
+test("unclaimed and released histories need no model allocation or ownership claim to delete", async (t) => {
+  const f = fixture(t);
+  const owner = await claimParent(f.agentDir, f.parent.path);
+  await releaseParent(f.agentDir, f.parent.path, owner);
+  await guardSubagentDeletion(f.options);
+  assert.equal(existsSync(f.child.path), false);
+  assert.equal(readDelegationState(f.agentDir, f.parent.path).owner, undefined);
+  assert.equal(f.shutdowns, 1);
+});
+
+test("malformed native metadata cannot bypass parent ownership checks", async (t) => {
+  const f = fixture(t);
+  writeFileSync(f.child.path, JSON.stringify({ type: "session", id: f.child.id, version: 3 }) + "\n"
+    + JSON.stringify({ type: "custom", customType: "pi-web:subagent", data: {} }) + "\n");
+  await assert.rejects(guardSubagentDeletion(f.options), { status: 409 });
+  assert.equal(f.shutdowns, 0);
+});
+
+test("a child first persisted while its parent shuts down is included in the deletion scope", async (t) => {
+  const f = fixture(t);
+  f.plan.deleted = [f.parent];
+  f.options.shutdown = async () => {
+    await updateDelegationState(f.agentDir, f.parent.path, (state) => {
+      state.parentSessionId = f.parent.id;
+      const now = new Date().toISOString();
+      state.groups.push({ id: "late", createdAt: now });
+      state.tasks.push({ id: "late-child", groupId: "late", profile: "scout", description: "Inspect", assignment: "Inspect",
+        needs: [], status: "interrupted", attempt: 1, createdAt: now, updatedAt: now,
+        sessionId: f.child.id, sessionFile: f.child.path });
+    });
+  };
+  await guardSubagentDeletion(f.options);
+  assert.equal(existsSync(f.child.path), false);
+});
+
+test("the authorization locks remain held through the synchronous unlink boundary", async (t) => {
+  const f = fixture(t);
+  const marker = join(f.agentDir, "inside-mutation");
+  const script = `import {createJiti} from 'jiti';
+    import {writeFileSync,unlinkSync} from 'node:fs';
+    const {guardSubagentDeletion}=await createJiti(import.meta.url).import('./lib/subagent-deletion.ts');
+    await guardSubagentDeletion({agentDir:${JSON.stringify(f.agentDir)},
+      plan:{deleted:[${JSON.stringify(f.parent)}],rewritten:[]},localOwner:()=>undefined,shutdown:async()=>{},
+      mutate(){writeFileSync(${JSON.stringify(marker)},'ready');process.kill(process.pid,'SIGSTOP');unlinkSync(${JSON.stringify(f.parent.path)});}});`;
+  const child = spawn(process.execPath, ["--input-type=module", "-e", script], { cwd: process.cwd(), stdio: ["ignore", "ignore", "pipe"] });
+  let errors = "";
+  child.stderr.on("data", (chunk) => { errors += chunk; });
+  const exited = new Promise((resolve) => child.once("exit", (code) => resolve(code)));
+  t.after(async () => {
+    if (child.exitCode === null && child.signalCode === null) { child.kill("SIGCONT"); child.kill("SIGTERM"); }
+    await exited;
+  });
+  const deadline = Date.now() + 10000;
+  while (!existsSync(marker)) {
+    if (Date.now() > deadline || child.exitCode !== null) throw new Error("Mutation boundary not reached: " + errors);
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  }
+  let claimed = false;
+  const claim = claimParent(f.agentDir, f.parent.path).then((owner) => { claimed = true; return owner; });
+  try {
+    await new Promise((resolve) => setTimeout(resolve, 150));
+    assert.equal(claimed, false);
+    assert.equal(existsSync(f.parent.path), true);
+  } finally { child.kill("SIGCONT"); }
+  assert.equal(await exited, 0, errors);
+  const owner = await claim;
+  assert.equal(existsSync(f.parent.path), false);
+  await releaseParent(f.agentDir, f.parent.path, owner);
+});
+
+test("history whose execution owner has exited can be deleted without taking its lease", async (t) => {
+  const f = fixture(t);
+  const script = `import {createJiti} from 'jiti';
+    const {claimParent}=await createJiti(import.meta.url).import('./lib/subagent-ownership.ts');
+    await claimParent(${JSON.stringify(f.agentDir)},${JSON.stringify(f.parent.path)});`;
+  const child = spawn(process.execPath, ["--input-type=module", "-e", script], { cwd: process.cwd(), stdio: ["ignore", "ignore", "pipe"] });
+  let errors = "";
+  child.stderr.on("data", (chunk) => { errors += chunk; });
+  assert.equal(await new Promise((resolve) => child.once("exit", resolve)), 0, errors);
+  const owner = readDelegationState(f.agentDir, f.parent.path).owner;
+  await guardSubagentDeletion(f.options);
+  assert.equal(existsSync(f.child.path), false);
+  assert.deepEqual(readDelegationState(f.agentDir, f.parent.path).owner, owner);
+});
diff --git a/lib/subagent-deletion.ts b/lib/subagent-deletion.ts
new file mode 100644
index 0000000..6d53b8f
--- /dev/null
+++ b/lib/subagent-deletion.ts
@@ -0,0 +1,167 @@
+import { existsSync, readFileSync } from "node:fs";
+import { dirname } from "node:path";
+import { canonicalParentSessionFile, lockDelegationState, readDelegationState } from "./subagent-state";
+import { isOwnerAlive } from "./subagent-ownership";
+import { readSubagentParentSessionFile, readSubagentRun, SUBAGENT_META_TYPE } from "./subagents";
+import type { DelegationState } from "./subagent-task-types";
+import type { SessionEntry } from "./types";
+
+export interface DeletionFile { id: string; path: string }
+export interface DeletionPlan { deleted: DeletionFile[]; rewritten: DeletionFile[] }
+export interface LocalDeletionOwner {
+  assertOwnsState(state: DelegationState): void;
+  quiesce(files: DeletionFile[]): Promise<void>;
+}
+
+export class SessionDeletionConflict extends Error {
+  readonly status = 409;
+}
+
+function normalize(files: DeletionFile[]): DeletionFile[] {
+  const paths = new Map<string, DeletionFile>();
+  const ids = new Map<string, string>();
+  for (const file of files) {
+    const path = canonicalParentSessionFile(file.path);
+    const previous = paths.get(path);
+    if ((previous && previous.id !== file.id) || (ids.has(file.id) && ids.get(file.id) !== path)) throw new SessionDeletionConflict("Session identities disagree");
+    paths.set(path, { id: file.id, path });
+    ids.set(file.id, path);
+  }
+  return [...paths.values()];
+}
+
+export async function guardSubagentDeletion(options: {
+  agentDir: string;
+  plan: DeletionPlan;
+  localOwner(path: string): LocalDeletionOwner | undefined;
+  liveEntries?(file: DeletionFile): SessionEntry[] | undefined;
+  shutdown(files: DeletionFile[]): Promise<void>;
+  mutate(plan: DeletionPlan): undefined;
+}): Promise<void> {
+  const { agentDir, plan } = options;
+  plan.deleted = normalize(plan.deleted);
+  plan.rewritten = normalize(plan.rewritten);
+  const rememberedEntries = new Map<string, SessionEntry[]>();
+  const derivedParents = new Map<string, string>();
+
+  function withPersistedHistories(): DeletionFile[] {
+    const files = [...plan.deleted];
+    const seen = new Set(files.map((file) => file.path));
+    for (const file of files) {
+      for (const task of readDelegationState(agentDir, file.path, file.id)?.tasks ?? []) {
+        if (!task.sessionId || !task.sessionFile || !existsSync(dirname(task.sessionFile))) continue;
+        const path = canonicalParentSessionFile(task.sessionFile);
+        if (seen.has(path)) continue;
+        seen.add(path);
+        files.push({ id: task.sessionId, path });
+        derivedParents.set(path, file.path);
+      }
+    }
+    return normalize(files);
+  }
+  plan.deleted = withPersistedHistories();
+
+  function inspect() {
+    const scopes = new Set<string>();
+    const identities = new Map<string, string>();
+    for (const file of [...plan.deleted, ...plan.rewritten]) {
+      scopes.add(file.path);
+      let entries: SessionEntry[];
+      let persisted = false;
+      try {
+        const parsed = readFileSync(file.path, "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line));
+        if (parsed[0]?.type !== "session" || parsed[0].id !== file.id) throw new SessionDeletionConflict("Session history identity changed");
+        entries = parsed.slice(1);
+        persisted = true;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw new SessionDeletionConflict("Cannot verify session history", { cause: error });
+        entries = options.liveEntries?.(file) ?? rememberedEntries.get(file.path) ?? [];
+      }
+      rememberedEntries.set(file.path, structuredClone(entries.filter((entry) => entry.type === "custom" && entry.customType === SUBAGENT_META_TYPE)));
+      let parent = "";
+      if (entries.some((entry) => entry.type === "custom" && entry.customType === SUBAGENT_META_TYPE)) {
+        const run = readSubagentRun(entries, file.id, file.path);
+        const saved = readSubagentParentSessionFile(entries);
+        if (!run || !saved) throw new SessionDeletionConflict("Cannot verify native child ownership");
+        const path = canonicalParentSessionFile(saved);
+        if (derivedParents.has(file.path) && derivedParents.get(file.path) !== path) throw new SessionDeletionConflict("Recorded child belongs to another parent");
+        scopes.add(path);
+        parent = `${run.parentSessionId}\0${path}`;
+      }
+      if (persisted && derivedParents.has(file.path) && !parent) throw new SessionDeletionConflict("Recorded child has no native ownership metadata");
+      identities.set(file.path, `${file.id}\0${parent}`);
+    }
+    return { scopes: [...scopes].sort(), identities };
+  }
+
+  const initial = inspect();
+  const owners = new Map<string, LocalDeletionOwner>();
+  function authorize(path: string, findOwner: (path: string) => LocalDeletionOwner | undefined) {
+    const state = readDelegationState(agentDir, path);
+    if (!state?.owner || !isOwnerAlive(state.owner)) return;
+    const owner = findOwner(path);
+    if (!owner) throw new SessionDeletionConflict("The session is owned by another execution controller");
+    try { owner.assertOwnsState(state); }
+    catch (error) { throw new SessionDeletionConflict("The session execution owner changed", { cause: error }); }
+    return owner;
+  }
+  for (const path of initial.scopes) {
+    const owner = authorize(path, options.localOwner);
+    if (owner) owners.set(path, owner);
+  }
+  for (const owner of owners.values()) await owner.quiesce(plan.deleted);
+  plan.deleted = withPersistedHistories();
+  const attempts = new Map<string, Map<string, string>>();
+  const attemptIdentity = (task: DelegationState["tasks"][number]) => JSON.stringify([task.attempt, task.status, task.sessionId, task.sessionFile]);
+  function selectedAttempts(state: DelegationState | undefined): Map<string, string> {
+    const selected = new Map<string, string>();
+    for (const task of state?.tasks ?? []) {
+      if (task.sessionFile && plan.deleted.some((file) => file.id === task.sessionId && file.path === canonicalParentSessionFile(task.sessionFile!))) {
+        selected.set(task.id, attemptIdentity(task));
+      }
+    }
+    return selected;
+  }
+  for (const path of inspect().scopes) {
+    attempts.set(path, selectedAttempts(readDelegationState(agentDir, path)));
+  }
+  for (const path of inspect().scopes) authorize(path, (path) => owners.get(path));
+  await options.shutdown(plan.deleted);
+  plan.deleted = withPersistedHistories();
+  plan.rewritten = plan.rewritten.filter((file) => !plan.deleted.some((deleted) => deleted.path === file.path));
+  const refreshed = inspect();
+  for (const [path, identity] of initial.identities) {
+    if (refreshed.identities.get(path) !== identity) throw new SessionDeletionConflict("Native ownership scope changed during shutdown");
+  }
+  const locks: Awaited<ReturnType<typeof lockDelegationState>>[] = [];
+  try {
+    for (const path of refreshed.scopes) locks.push(await lockDelegationState(agentDir, path));
+    if (JSON.stringify(withPersistedHistories()) !== JSON.stringify(plan.deleted)) throw new SessionDeletionConflict("Child history changed before deletion");
+    const current = inspect();
+    if (JSON.stringify([...current.identities]) !== JSON.stringify([...refreshed.identities])
+      || JSON.stringify(current.scopes) !== JSON.stringify(refreshed.scopes)) {
+      throw new SessionDeletionConflict("Native ownership scope changed before deletion");
+    }
+    for (const path of current.scopes) authorize(path, (path) => owners.get(path));
+    for (const path of current.scopes) {
+      const state = readDelegationState(agentDir, path);
+      const selected = attempts.get(path) ?? new Map<string, string>();
+      const alive = state?.owner && isOwnerAlive(state.owner);
+      if (alive && [...selectedAttempts(state).keys()].some((id) => !selected.has(id))) {
+        throw new SessionDeletionConflict("A new task became associated with the history during deletion");
+      }
+      for (const [id, identity] of selected) {
+        const task = state?.tasks.find((task) => task.id === id);
+        if (!task || attemptIdentity(task) !== identity
+          || (alive && ["queued", "running", "cancelling"].includes(task.status))) {
+          throw new SessionDeletionConflict("The task attempt changed or resumed during deletion");
+        }
+      }
+    }
+    for (const lock of locks) lock.assertHeld();
+    const result: unknown = options.mutate(plan);
+    if (result && typeof (result as PromiseLike<unknown>).then === "function") throw new Error("Session filesystem mutations must be synchronous");
+  } finally {
+    for (const lock of locks.reverse()) await lock.release();
+  }
+}
