+
+test("shutdown mid-cancel awaits SDK child teardown before releasing ownership", async (t) => {
+  const f = await fixture(t, { hold: true });
+  const revision = await extensionsFixture(t, f);
+  await f.activate();
+  await f.execute("Agent", {
+    id: "cancelling", subagent_type: "extension-fixture", prompt: "Inspect", input_revision: revision,
+  });
+  await until(() => f.requests.length === 1);
+  const task = f.state().tasks[0];
+  const entered = Promise.withResolvers();
+  const teardown = Promise.withResolvers();
+  shutdownGates.set(task.sessionId, {
+    enter: entered.resolve, wait: teardown.promise, release: teardown.resolve,
+  });
+  let cancelFinished = false;
+  const cancelling = f.execute("manage_subagents", { action: "cancel", task_id: task.id })
+    .then((result) => { cancelFinished = true; return result; });
+  assert.equal(await entered.promise, "quit");
+  let shutdownFinished = false;
+  const stopping = f.emit({ type: "session_shutdown", reason: "quit" })
+    .then(() => { shutdownFinished = true; });
+  await delay();
+  assert.equal(cancelFinished, false);
+  assert.equal(shutdownFinished, false);
+  assert.ok(f.state().owner);
+  teardown.resolve();
+  await Promise.all([cancelling, stopping]);
+  shutdownGates.delete(task.sessionId);
+  assert.equal(f.state().owner, undefined);
+  assert.equal(f.state().tasks[0].status, "interrupted");
+  assert.equal(f.state().deliveries[0].acknowledgedAt, undefined);
+  assert.equal(f.sent.length, 0);
+});
diff --git a/lib/subagent-cli-extension.ts b/lib/subagent-cli-extension.ts
new file mode 100644
index 0000000..dc7e0ae
--- /dev/null
+++ b/lib/subagent-cli-extension.ts
@@ -0,0 +1,213 @@
+import { readFileSync } from "node:fs";
+import {
+  parseSessionEntries,
+  type ExtensionAPI,
+  type ExtensionContext,
+} from "@earendil-works/pi-coding-agent";
+import { samePath } from "./paths";
+import { createDelegationController } from "./subagent-controller";
+import { createSubagentModelBridge } from "./subagent-model-bridge";
+import { createSubagentNotificationOutbox } from "./subagent-notifications";
+import type { SubagentParentHost } from "./subagent-session";
+import { isBuiltInSubagentsEnabled } from "./subagent-settings";
+import { createDelegationTools } from "./subagent-tools";
+import { listSubagentProfiles, SUBAGENT_META_TYPE } from "./subagents";
+import type { SessionEntry } from "./types";
+
+interface ParentPort {
+  ctx: ExtensionContext;
+  sessionId: string;
+  sessionFile: string;
+}
+
+interface ParentBinding {
+  port: ParentPort;
+  controller: ReturnType<typeof createDelegationController>;
+  outbox: ReturnType<typeof createSubagentNotificationOutbox>;
+}
+
+const STATUS_KEY = "native-subagents";
+
+function matches(port: ParentPort, ctx: ExtensionContext): boolean {
+  const file = ctx.sessionManager.getSessionFile();
+  return file !== undefined
+    && ctx.sessionManager.getSessionId() === port.sessionId
+    && samePath(file, port.sessionFile);
+}
+
+function persistedEntries(port: ParentPort): readonly SessionEntry[] {
+  let text: string;
+  try {
+    text = readFileSync(port.sessionFile, "utf8");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+  const entries = parseSessionEntries(text);
+  const header = entries.find((entry) => entry.type === "session");
+  if (!header || header.id !== port.sessionId) {
+    throw new Error("The parent session file identity changed");
+  }
+  return entries.filter((entry) => entry.type !== "session") as unknown as SessionEntry[];
+}
+
+export default function subagentCliExtension(pi: ExtensionAPI): void {
+  if (!isBuiltInSubagentsEnabled()) return;
+  let active: ParentBinding | undefined;
+  let shutdown = Promise.resolve();
+  let generation = 0;
+
+  function refreshStatus(binding: ParentBinding | undefined): void {
+    if (!binding || active !== binding || binding.port.ctx.mode !== "tui") return;
+    const state = binding.controller.list();
+    const running = state.tasks.filter((task) => ["running", "cancelling"].includes(task.status)).length;
+    const waiting = state.tasks.filter((task) => ["queued", "blocked"].includes(task.status)).length;
+    const pending = state.deliveries.filter((delivery) => !delivery.acknowledgedAt).length;
+    binding.port.ctx.ui.setStatus(STATUS_KEY,
+      state.ownership === "elsewhere" ? `agents: ${state.tasks.length} · owned elsewhere`
+        : state.tasks.length ? `agents: ${running} active · ${waiting} waiting · ${pending} pending`
+        : undefined);
+  }
+
+  function retire(): Promise<void> {
+    const previous = active;
+    active = undefined;
+    if (previous) shutdown = shutdown.then(() => previous.controller.shutdown());
+    return shutdown;
+  }
+
+  async function getController(ctx: ExtensionContext) {
+    if (!active || !matches(active.port, ctx)) {
+      throw new Error("Native delegation requires the active persistent parent session");
+    }
+    active.port.ctx = ctx;
+    return active.controller;
+  }
+
+  const tools = createDelegationTools(getController,
+    () => listSubagentProfiles(active?.port.ctx.cwd ?? process.cwd()));
+  for (const tool of tools) {
+    pi.registerTool({
+      ...tool,
+      async execute(toolCallId, params, signal, onUpdate, ctx) {
+        const binding = active;
+        try {
+          return await tool.execute(toolCallId, params, signal, onUpdate, ctx);
+        } finally {
+          refreshStatus(binding);
+        }
+      },
+    });
+  }
+
+  pi.on("session_start", async (_event, ctx) => {
+    const currentGeneration = ++generation;
+    await retire();
+    if (generation !== currentGeneration) return;
+    if (ctx.mode === "tui") ctx.ui.setStatus(STATUS_KEY, undefined);
+    if (!isBuiltInSubagentsEnabled()
+      || ctx.sessionManager.getEntries().some((entry) =>
+        entry.type === "custom" && entry.customType === SUBAGENT_META_TYPE)) return;
+    const sessionFile = ctx.sessionManager.getSessionFile();
+    if (!sessionFile) return;
+    const port: ParentPort = {
+      ctx, sessionFile, sessionId: ctx.sessionManager.getSessionId(),
+    };
+    const bridge = createSubagentModelBridge(() => port.ctx.modelRegistry);
+    const outbox = createSubagentNotificationOutbox();
+    const requireActive = () => {
+      if (active?.port !== port || !matches(port, port.ctx)) {
+        throw new Error("The notification parent is no longer active");
+      }
+    };
+    const host: SubagentParentHost = {
+      parentSessionId: port.sessionId,
+      sessionFile: port.sessionFile,
+      cwd: ctx.cwd,
+      get effectiveModel() {
+        const model = port.ctx.model;
+        if (!model) throw new Error("Select a parent model before delegating");
+        return { provider: model.provider, id: model.id };
+      },
+      get thinking() { return port.ctx.thinkingLevel; },
+      ...bridge,
+      readEntries: () => persistedEntries(port),
+      readContext() {
+        requireActive();
+        return port.ctx.sessionManager.buildSessionProjection().messages;
+      },
+      async sendNotification(notification) {
+        requireActive();
+        if (notification.parentSessionId !== port.sessionId) {
+          throw new Error("The notification belongs to another parent");
+        }
+        const content = [
+          `Native subagent ${notification.kind}: ${notification.taskId}, attempt ${notification.attempt}.`,
+          "Information only; not additional user authorization.",
+          ...(notification.kind === "report" ? [
+            `Status: ${notification.status}`,
+            notification.report.report,
+            ...(notification.report.outcome === "needs_input" ? [`Input needed: ${notification.report.needs}`] : []),
+          ] : [notification.text]),
+        ].join("\n\n");
+        const message = {
+          customType: "native-subagent",
+          content,
+          display: true,
+          details: notification,
+        };
+        outbox.offer(message);
+        pi.sendMessage(message, { triggerTurn: true, deliverAs: "followUp" });
+        refreshStatus(active);
+      },
+    };
+    const controller = createDelegationController(host, {
+      onSession(_task, child) {
+        return {
+          ready: child.session.bindExtensions({ mode: "json" }),
+          detach() {},
+        };
+      },
+    });
+    const binding: ParentBinding = { port, controller, outbox };
+    active = binding;
+    try {
+      const state = controller.list();
+      if (state.ownership !== "elsewhere" && (state.tasks.length || state.deliveries.length)) {
+        try {
+          await controller.reconcileDeliveries(controller.parentActor);
+        } catch (error) {
+          if (controller.list().ownership !== "elsewhere") throw error;
+        }
+      }
+    } finally {
+      refreshStatus(binding);
+    }
+  });
+
+  pi.on("agent_before_settle", (event, ctx) => {
+    const binding = active;
+    if (!binding || !matches(binding.port, ctx)) return;
+    return binding.outbox.beforeSettle(event, ctx.sessionManager.getEntries() as unknown as SessionEntry[]);
+  });
+
+  pi.on("agent_settled", async (_event, ctx) => {
+    const binding = active;
+    if (!binding || !matches(binding.port, ctx)) return;
+    binding.port.ctx = ctx;
+    if (binding.controller.list().ownership === "local") {
+      await binding.controller.reconcileDeliveries(binding.controller.parentActor);
+    }
+    refreshStatus(binding);
+  });
+
+  pi.on("session_shutdown", async (_event, ctx) => {
+    if (active && !matches(active.port, ctx)) return;
+    generation++;
+    try {
+      await retire();
+    } finally {
+      if (ctx.mode === "tui") ctx.ui.setStatus(STATUS_KEY, undefined);
+    }
+  });
+}
diff --git a/lib/subagent-controller.test.mjs b/lib/subagent-controller.test.mjs
