+    if (prerequisite.status !== "completed" || prerequisite.report?.outcome !== "completed") {
+      return `Awaiting successful prerequisite ${edge.taskId}: ${prerequisite.status}`;
+    }
+    if (edge.input === "integrated_changes" && !prerequisite.releaseRevision) {
