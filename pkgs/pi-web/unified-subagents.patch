+++ b/app/api/subagents/tasks/route.ts
@@ -0,0 +1,41 @@
+import { NextResponse } from "next/server";
+import { getSubagentTasks, manageSubagentTask } from "@/lib/rpc-manager";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+import type { SubagentTaskActionRequest } from "@/lib/api-types";
+
+export const dynamic = "force-dynamic";
+
+function failure(error: unknown, fallback: number) {
+  const message = error instanceof Error ? error.message : String(error);
+  const status = /not found/i.test(message) ? 404 : /owned|ownership|identity|shutting down/i.test(message) ? 409 : fallback;
+  return NextResponse.json({ error: message }, { status });
+}
+
+export async function GET(req: Request) {
+  const parent = new URL(req.url).searchParams.get("parentSessionId");
+  if (!parent?.trim()) return NextResponse.json({ error: "parentSessionId is required" }, { status: 400 });
+  try { return NextResponse.json(await getSubagentTasks(parent)); }
+  catch (error) { return failure(error, 500); }
+}
+
+export async function POST(req: Request) {
+  if (!isApiRequestAllowed(req)) return NextResponse.json({ error: "Untrusted API request" }, { status: 403 });
+  if (!hasJsonContentType(req)) return NextResponse.json({ error: "Content-Type must be application/json" }, { status: 415 });
+  try {
+    const body: unknown = await req.json();
+    if (!body || typeof body !== "object" || Array.isArray(body)) throw new Error("A task action object is required");
+    const input = body as Record<string, unknown>;
+    for (const field of ["parentSessionId", "task_id", "action"]) {
+      if (typeof input[field] !== "string" || !input[field].trim()) throw new Error(`${field} is required`);
+    }
+    if (!["message", "cancel", "resume", "assign", "release", "close"].includes(input.action as string)) throw new Error("Unknown task action");
+    for (const field of ["message", "profile", "input_revision", "revision", "delivery_id", "model", "thinking"]) {
+      if (input[field] !== undefined && (typeof input[field] !== "string" || !input[field].trim())) throw new Error(`${field} must be a non-empty string`);
+    }
+    const required = { message: "message", assign: "profile", release: "revision", close: "delivery_id" }[input.action as string];
+    if (required && input[required] === undefined) throw new Error(`${required} is required`);
+    if (input.thinking !== undefined && !["off", "minimal", "low", "medium", "high", "xhigh", "max"].includes(input.thinking as string)) throw new Error("Invalid thinking level");
+    const action = input as unknown as SubagentTaskActionRequest;
+    return NextResponse.json(await manageSubagentTask(action.parentSessionId, action));
+  } catch (error) { return failure(error, 400); }
+}
