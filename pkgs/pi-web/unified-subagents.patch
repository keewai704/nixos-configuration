@@ -0,0 +1,101 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test, { after } from "node:test";
+import { createJiti } from "jiti";
+
+const previousAgentDir = process.env.PI_CODING_AGENT_DIR;
+const agentDir = mkdtempSync(join(tmpdir(), "pi-delete-route-"));
+process.env.PI_CODING_AGENT_DIR = agentDir;
+after(() => {
+  if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;
+  else process.env.PI_CODING_AGENT_DIR = previousAgentDir;
+  rmSync(agentDir, { recursive: true, force: true });
+});
+const jiti = createJiti(import.meta.url, { alias: { "@": process.cwd() } });
+const { DELETE } = await jiti.import("./route.ts");
+const { cacheSessionPath, invalidateSessionPathCache, invalidateSessionListCache } = await jiti.import("../../../../lib/session-reader.ts");
+const { claimParent } = await jiti.import("../../../../lib/subagent-ownership.ts");
+const { delegationStatePath } = await jiti.import("../../../../lib/subagent-state.ts");
+
+function fixture(t) {
+  const dir = mkdtempSync(join(agentDir, "workspace-"));
+  const files = [];
+  const previousRegistry = globalThis.__piSessions;
+  globalThis.__piSessions = new Map();
+  t.after(() => {
+    globalThis.__piSessions = previousRegistry;
+    for (const file of files) invalidateSessionPathCache(file.id);
+    invalidateSessionListCache();
+  });
+  function session(name, parent, native = false) {
+    const file = { id: randomUUID(), path: join(dir, name + ".jsonl") };
+    const entries = [{ type: "session", version: 3, id: file.id, cwd: dir, timestamp: new Date().toISOString(),
+      ...(parent ? { parentSession: parent.path } : {}) }];
+    if (native) entries.push({ type: "custom", customType: "pi-web:subagent", id: randomUUID(), parentId: null,
+      timestamp: new Date().toISOString(), data: { version: 1, parentSessionId: parent.id, parentSessionPath: parent.path,
+        profile: "scout", description: "Inspect", task: "Inspect", createdAt: new Date().toISOString() } });
+    writeFileSync(file.path, entries.map((entry) => JSON.stringify(entry)).join("\n") + "\n");
+    files.push(file);
+    cacheSessionPath(file.id, file.path);
+    return file;
+  }
+  const parent = session("parent");
+  const child = session("child", parent, true);
+  const fork = session("fork", parent);
+  return { session, parent, child, fork, files, remove: (file) => DELETE(new Request(`http://localhost/pi/api/sessions/${file.id}`, { method: "DELETE" }),
+    { params: Promise.resolve({ id: file.id }) }) };
+}
+
+async function foreignOwner(t, file) {
+  const script = `import {createJiti} from 'jiti';
+    const {claimParent}=await createJiti(import.meta.url).import('./lib/subagent-ownership.ts');
+    await claimParent(${JSON.stringify(agentDir)},${JSON.stringify(file.path)});
+    process.stdout.write('ready\\n'); setInterval(()=>{},1000);`;
+  const child = spawn(process.execPath, ["--input-type=module", "-e", script], { cwd: process.cwd(), stdio: ["ignore", "pipe", "pipe"] });
+  let errors = "";
+  child.stderr.on("data", (chunk) => { errors += chunk; });
+  const exited = new Promise((resolve) => child.once("exit", resolve));
+  t.after(async () => { if (child.exitCode === null && child.signalCode === null) child.kill("SIGTERM"); await exited; });
+  await Promise.race([
+    new Promise((resolve) => child.stdout.once("data", resolve)),
+    exited.then(() => { throw new Error("Owner process exited: " + errors); }),
+  ]);
+}
+
+test("DELETE rejects foreign-owned parent and child histories before rewriting forks or shutting down wrappers", async (t) => {
+  const f = fixture(t);
+  await foreignOwner(t, f.parent);
+  const paths = [...f.files.map((file) => file.path), delegationStatePath(agentDir, f.parent.path)];
+  const bytes = paths.map((path) => readFileSync(path));
+  let shutdowns = 0;
+  globalThis.__piSessions.set(f.parent.id, { isRunning: () => false, shutdown: async () => { shutdowns++; } });
+  for (const target of [f.child, f.parent]) {
+    const response = await f.remove(target);
+    assert.equal(response.status, 409, await response.text());
+    assert.deepEqual(paths.map((path) => readFileSync(path)), bytes);
+  }
+  assert.equal(shutdowns, 0);
+});
+
+test("DELETE also protects an ordinary fork's own delegation scope from reparenting", async (t) => {
+  const f = fixture(t);
+  await claimParent(agentDir, f.fork.path);
+  const bytes = f.files.map((file) => readFileSync(file.path));
+  const response = await f.remove(f.parent);
+  assert.equal(response.status, 409, await response.text());
+  assert.deepEqual(f.files.map((file) => readFileSync(file.path)), bytes);
+});
+
+test("unclaimed histories retain cascade deletion and ordinary-fork reparenting", async (t) => {
+  const f = fixture(t);
+  const response = await f.remove(f.parent);
+  assert.equal(response.status, 200, await response.text());
+  assert.equal(existsSync(f.parent.path), false);
+  assert.equal(existsSync(f.child.path), false);
+  assert.equal(JSON.parse(readFileSync(f.fork.path, "utf8").split("\n")[0]).parentSession, undefined);
+  assert.equal(existsSync(delegationStatePath(agentDir, f.parent.path)), false);
+});
