diff --git a/lib/subagent-ownership.ts b/lib/subagent-ownership.ts
new file mode 100644
index 0000000..25119e3
--- /dev/null
+++ b/lib/subagent-ownership.ts
@@ -0,0 +1,54 @@
+import { randomUUID } from "node:crypto";
+import { assertDelegationParent, canonicalParentSessionFile, readDelegationState, updateDelegationState } from "./subagent-state";
+import type { DelegationState, ParentOwnership } from "./subagent-task-types";
+import { readProcessIdentity, isProcessAlive as isOwnerAlive } from "./subagent-process";
+export { readProcessIdentity, isProcessAlive as isOwnerAlive } from "./subagent-process";
+
+export function requireOwner(state: DelegationState, owner: ParentOwnership): void {
+  const current = readProcessIdentity(process.pid);
+  if (state.parentSessionFile !== owner.parentSessionFile || state.owner?.token !== owner.token
+    || state.owner.pid !== process.pid || state.owner.startTime !== owner.startTime || state.owner.bootId !== owner.bootId
+    || current?.startTime !== owner.startTime || current.bootId !== owner.bootId) {
+    throw new Error("This process is not the parent execution owner");
+  }
+}
+
+function interruptUnfinished(state: DelegationState): void {
+  const now = new Date().toISOString();
+  for (const task of state.tasks) {
+    if (["blocked", "queued", "running", "cancelling"].includes(task.status)) {
+      task.status = "interrupted";
+      task.updatedAt = now;
+    }
+  }
+}
+
+export async function claimParent(agentDir: string, parentSessionFile: string, parentSessionId?: string): Promise<ParentOwnership> {
+  const identity = readProcessIdentity(process.pid);
+  if (!identity) throw new Error("Cannot establish this process identity");
+  const owner: ParentOwnership = { ...identity, parentSessionFile: canonicalParentSessionFile(parentSessionFile), token: randomUUID() };
+  await updateDelegationState(agentDir, parentSessionFile, (state) => {
+    if (parentSessionId !== undefined) {
+      assertDelegationParent(state, parentSessionId);
+      state.parentSessionId = parentSessionId;
+    }
+    if (state.owner && isOwnerAlive(state.owner)) throw new Error("The parent session is already owned by a live process");
+    interruptUnfinished(state);
+    state.owner = owner;
+  });
+  return owner;
+}
+
+export function assertOwner(agentDir: string, parentSessionFile: string, owner: ParentOwnership): void {
+  const state = readDelegationState(agentDir, parentSessionFile);
+  if (!state) throw new Error("The parent has no execution owner");
+  requireOwner(state, owner);
+}
+
+export async function releaseParent(agentDir: string, parentSessionFile: string, owner: ParentOwnership): Promise<void> {
+  await updateDelegationState(agentDir, parentSessionFile, (state) => {
+    requireOwner(state, owner);
+    interruptUnfinished(state);
+    delete state.owner;
+  });
+}
