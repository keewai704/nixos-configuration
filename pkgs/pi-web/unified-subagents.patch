index 0000000..3ec5d9d
--- /dev/null
+++ b/lib/subagent-tools.test.mjs
@@ -0,0 +1,140 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const { createDelegationTools } = await createJiti(import.meta.url).import("./subagent-tools.ts");
+function fixture() {
+  const calls = [];
+  const actor = Object.freeze({ kind: "parent", parentSessionId: "parent" });
+  const tasks = [];
+  const controller = { parentActor: actor, list: () => ({ tasks, deliveries: [], messages: [], ownership: "local" }),
+    async startBatch(scope, inputs) {
+      assert.equal(scope, actor);
+      calls.push({ operation: "start", inputs });
+      tasks.push(...inputs.map((input) => ({ ...input, groupId: "batch", status: "queued", attempt: 1 })));
+      return { groupId: "batch", tasks };
+    },
+    async wait(scope, ids) {
+      assert.equal(scope, actor);
+      return tasks.filter((task) => ids.includes(task.id)).map((task) => Object.assign(task, {
+        status: "completed", report: { outcome: "completed", report: "Complete fixture result" },
+      }));
+    },
+    async resume(scope, id, options) { calls.push({ operation: "resume", scope, id, options }); return { task: tasks.find((task) => task.id === id), history: "retained" }; },
+    async message(scope, to, text) { calls.push({ operation: "message", scope, to, text }); return { from: "parent", to, text }; },
+    async close(scope, id, deliveryId) { calls.push({ operation: "close", scope, id, deliveryId }); return tasks.find((task) => task.id === id); },
+  };
+  const ctx = { cwd: "/tmp", sessionManager: { getSessionFile: () => "/tmp/parent.jsonl" } };
+  const tools = createDelegationTools(async (actual) => { assert.equal(actual, ctx); return controller; }, () => []);
+  const execute = (name, args, signal) => tools.find((tool) => tool.name === name).execute("sdk-call", args, signal, undefined, ctx);
+  return { calls, tasks, controller, tools, execute, actor };
+}
+
+test("native parent tools preserve structured and legacy requests and default to background", async () => {
+  const f = fixture();
+  assert.deepEqual(f.tools.map((tool) => tool.name), ["Agent", "get_subagent_result", "steer_subagent", "manage_subagents"]);
+  const assignment = { goal: "Inspect", context: ["Fixture only"], instructions: ["Read", "Report"] };
+  const result = await f.execute("Agent", { assignment, subagent_type: "scout", description: "Inspect", input_revision: "base", max_turns: 0 });
+  assert.equal(result.isError, undefined);
+  assert.deepEqual(f.calls[0].inputs[0].assignment, assignment);
+  assert.equal(f.calls[0].inputs[0].parentToolCallId, "sdk-call");
+  assert.equal(f.calls[0].inputs[0].runInBackground, true);
+  assert.equal(f.calls[0].inputs[0].inputRevision, "base");
+  assert.equal(f.calls[0].inputs[0].maxTurns, 0);
+  assert.match(result.content[0].text, /queued/);
+  const foreground = await f.execute("Agent", { prompt: "Legacy prompt", description: "Legacy", run_in_background: false });
+  assert.match(foreground.content[0].text, /Complete fixture result/);
+  assert.equal(f.calls[1].inputs[0].profile, "general-purpose");
+});
+
+test("historical result lookup stays read-only and resume passes an unimported session ID to the controller", async () => {
+  const f = fixture();
+  f.controller.history = async (actor, id) => {
+    assert.equal(actor, f.actor);
+    return { run: { sessionId: id, sessionPath: "/tmp/old-child.jsonl", status: "completed", result: "Old plain text report" } };
+  };
+  const result = await f.execute("get_subagent_result", { agent_id: "old-session", wait: true });
+  assert.equal(result.isError, undefined);
+  assert.match(result.content[0].text, /Old plain text report/);
+  assert.equal(result.details.reportFile, "/tmp/old-child.jsonl");
+  assert.equal(f.calls.length, 0);
+  f.controller.resume = async (scope, id, options) => {
+    f.calls.push({ operation: "resume", scope, id, options });
+    return { task: { id: "adopted", status: "queued", sessionId: id }, history: "retained" };
+  };
+  const resumed = await f.execute("Agent", { resume: "old-session", prompt: "Continue" });
+  assert.equal(resumed.isError, undefined);
+  assert.equal(f.calls[0].id, "old-session");
+});
+
+test("role discovery uses the bound workspace at inspection time, not a frozen startup description", async () => {
+  const f = fixture();
+  let profiles = [{ name: "workspace-a", description: "A", enabled: true, tools: ["read"] }];
+  const tools = createDelegationTools(async () => f.controller, () => profiles);
+  assert.doesNotMatch(tools[0].description, /workspace-a/);
+  profiles = [{ name: "workspace-b", description: "B", enabled: true, tools: ["read"] },
+    { name: "disabled", description: "Disabled", enabled: false, tools: ["read"] }];
+  const result = await tools.find((tool) => tool.name === "manage_subagents").execute("call", { action: "list" }, undefined, undefined,
+    { sessionManager: { getSessionFile: () => "/tmp/parent.jsonl" } });
+  assert.deepEqual(result.details.roles.map((role) => role.name), ["workspace-b"]);
+  assert.equal(result.details.roles[0].description, "B");
+  assert.deepEqual(result.details.messages, []);
+  assert.equal(result.details.messagesOmitted, 0);
+});
+
+test("batches and control operations bind the real parent actor, never argument identities", async () => {
+  const f = fixture();
+  await f.execute("Agent", { tasks: [{ id: "one", profile: "scout", assignment: "Inspect", description: "First" },
+    { id: "two", assignment: "Review", description: "Second", needs: [{ taskId: "one", input: "report" }] }] });
+  assert.equal(f.calls[0].inputs[1].profile, undefined);
+  assert.deepEqual(f.calls[0].inputs[1].needs, [{ taskId: "one", input: "report" }]);
+  await f.execute("manage_subagents", { action: "message", task_id: "one", message: "Evidence", parent_id: "forged" });
+  assert.equal(f.calls[1].scope, f.actor);
+  await f.execute("manage_subagents", { action: "close", task_id: "one", delivery_id: "delivery" });
+  assert.equal(f.calls[2].deliveryId, "delivery");
+  f.tasks[0].sessionId = "child-session";
+  await f.execute("Agent", { resume: "child-session", prompt: "Continue", model: "provider/new", thinking: "high" });
+  assert.equal(f.calls[3].id, "one");
+  assert.deepEqual(f.calls[3].options, { message: "Continue", model: "provider/new", thinking: "high" });
+});
+
+test("ambiguous request shapes fail without launch and queued results are not mislabeled failures", async () => {
+  const f = fixture();
+  const invalid = await f.execute("Agent", { tasks: [], prompt: "Also single" });
+  assert.equal(invalid.isError, true);
+  assert.equal(f.calls.length, 0);
+  await f.execute("Agent", { tasks: [{ id: "queued", profile: "scout", assignment: "Inspect", description: "Queued" }] });
+  const result = await f.execute("get_subagent_result", { agent_id: "queued" });
+  assert.match(result.content[0].text, /queued/);
+  assert.doesNotMatch(result.content[0].text, /Unknown error/);
+  await f.execute("steer_subagent", { agent_id: "queued", message: "Keep this input" });
+  assert.equal(f.calls.at(-1).to, "queued");
+});
+
+test("explicit failed results retain the native tool error signal", async () => {
+  const f = fixture();
+  await f.execute("Agent", { id: "failure", prompt: "Inspect", description: "Failure" });
+  Object.assign(f.tasks[0], { status: "failed", report: { outcome: "failed", report: "Fixture failure" } });
+  const result = await f.execute("get_subagent_result", { agent_id: "failure" });
+  assert.equal(result.isError, true);
+  assert.match(result.content[0].text, /Fixture failure/);
+});
+
+test("foreground cancellation waits for teardown without leaving an unhandled cancellation rejection", async () => {
+  const f = fixture();
+  const waiting = Promise.withResolvers();
+  const teardown = Promise.withResolvers();
+  const finished = Promise.withResolvers();
+  f.controller.wait = async () => { waiting.resolve(); await finished.promise; return f.tasks; };
+  f.controller.cancel = async () => { await teardown.promise; f.tasks[0].status = "aborted"; finished.resolve(); throw new Error("Fixture cancellation persistence failed"); };
+  const abort = new AbortController();
+  let settled = false;
+  const result = f.execute("Agent", { prompt: "Inspect", description: "Inspect", run_in_background: false }, abort.signal);
+  void result.then(() => { settled = true; });
+  await waiting.promise;
+  abort.abort();
+  await Promise.resolve();
+  assert.equal(settled, false);
+  teardown.resolve();
+  assert.match((await result).content[0].text, /cancellation persistence failed/);
+});
diff --git a/lib/subagent-tools.ts b/lib/subagent-tools.ts
new file mode 100644
index 0000000..70dc0ab
--- /dev/null
+++ b/lib/subagent-tools.ts
@@ -0,0 +1,223 @@
+import { randomUUID } from "node:crypto";
+import { Type } from "@earendil-works/pi-ai";
+import { defineTool, getAgentDir, type ExtensionContext, type ToolDefinition } from "@earendil-works/pi-coding-agent";
+import type { createDelegationController } from "./subagent-controller";
+import { delegationStatePath } from "./subagent-state";
+import { formatAssignment, reportExcerpt, type TaskInput, type TaskRecord } from "./subagent-task-types";
+import type { SubagentProfile } from "./subagents";
+import { MAX_SUBAGENT_INPUT_FILES } from "./subagent-input";
+import { subagentMessageHistory, subagentRoleView, subagentTaskView } from "./subagent-task-view";
+
+type Controller = ReturnType<typeof createDelegationController>;
+const assignmentSchema = Type.Union([Type.String({ minLength: 1 }), Type.Object({
+  goal: Type.String({ minLength: 1 }), context: Type.Array(Type.String()),
+  instructions: Type.Array(Type.String({ minLength: 1 }), { minItems: 1 }),
+})]);
+const thinkingSchema = Type.Union(["off", "minimal", "low", "medium", "high", "xhigh", "max"].map((value) => Type.Literal(value)));
+const taskOptions = {
+  model: Type.Optional(Type.String()), thinking: Type.Optional(thinkingSchema),
+  input_revision: Type.Optional(Type.String()), specialist_prompt: Type.Optional(Type.String()),
+  input_files: Type.Optional(Type.Array(Type.String(), { maxItems: MAX_SUBAGENT_INPUT_FILES })),
+  max_turns: Type.Optional(Type.Integer({ minimum: 0 })), inherit_context: Type.Optional(Type.Boolean()),
+  run_in_background: Type.Optional(Type.Boolean()), isolation: Type.Optional(Type.Literal("worktree")),
+};
+const batchTaskSchema = Type.Object({
+  id: Type.String(), profile: Type.Optional(Type.String()), description: Type.String(), assignment: assignmentSchema,
+  needs: Type.Optional(Type.Array(Type.Object({ taskId: Type.String(), input: Type.Union([Type.Literal("report"), Type.Literal("integrated_changes")]) }))),
+  ...taskOptions,
+});
+
+function taskById(controller: Controller, id: string): TaskRecord {
+  const task = controller.list().tasks.find((item) => item.id === id || item.sessionId === id);
+  if (!task) throw new Error(`Subagent task or session not found: ${id}`);
+  return task;
+}
+
+function optionsFrom(value: Record<string, unknown>) {
+  return {
+    model: value.model, thinking: value.thinking, inputRevision: value.input_revision,
+    specialistPrompt: value.specialist_prompt, inputFiles: value.input_files, maxTurns: value.max_turns,
+    inheritContext: value.inherit_context, runInBackground: value.run_in_background ?? true, isolation: value.isolation,
+  };
+}
+
+function response(value: unknown, ctx: ExtensionContext, historyFile?: string) {
+  const file = ctx.sessionManager.getSessionFile();
+  const reportFile = historyFile ?? (file ? delegationStatePath(getAgentDir(), file) : undefined);
+  return { content: [{ type: "text" as const, text: reportExcerpt(JSON.stringify({ ...value as object, reportFile }, null, 2)) }],
+    details: { kind: "native-subagents", ...value as object, reportFile } };
+}
+
+async function guarded(run: () => Promise<ReturnType<typeof response>>) {
+  try { return await run(); }
+  catch (error) { return { content: [{ type: "text" as const, text: error instanceof Error ? error.message : String(error) }],
+    details: undefined, isError: true }; }
+}
+
+async function pause(signal?: AbortSignal) {
+  signal?.throwIfAborted();
+  await new Promise<void>((resolve, reject) => {
+    const finish = () => { signal?.removeEventListener("abort", abort); resolve(); };
+    const timer = setTimeout(finish, 100);
+    const abort = () => { clearTimeout(timer); signal?.removeEventListener("abort", abort); reject(new Error("Result wait aborted")); };
+    signal?.addEventListener("abort", abort, { once: true });
+  });
+}
+
+export function createDelegationTools(
+  getController: (ctx: ExtensionContext) => Promise<Controller>,
+  getProfiles: () => readonly SubagentProfile[],
+): ToolDefinition[] {
+  return [
+    defineTool({
+      name: "Agent", label: "Agent", executionMode: "parallel",
+      description: "Delegate a focused task or dependency batch. Default: fresh context and background execution. Writers require an explicit committed input. Discover the current workspace's exact roles with manage_subagents(action: list).",
+      promptSnippet: "Delegate self-contained tasks to inspectable native subagents",
+      promptGuidelines: ["Batch independent tasks together and do not duplicate delegated work.",
+        "Use needs edges for prerequisites; file changes require parent integration and explicit release.",
+        "Foreground waits are for results needed immediately. Never recursively delegate from a child."],
+      parameters: Type.Object({
+        tasks: Type.Optional(Type.Array(batchTaskSchema, { minItems: 1 })),
+        id: Type.Optional(Type.String()), subagent_type: Type.Optional(Type.String()),
+        prompt: Type.Optional(Type.String()), assignment: Type.Optional(assignmentSchema),
+        description: Type.Optional(Type.String()), resume: Type.Optional(Type.String()), ...taskOptions,
+      }),
+      async execute(toolCallId, params, signal, onUpdate, ctx) {
+        return guarded(async () => {
+          signal?.throwIfAborted();
+          if (params.tasks && (params.prompt !== undefined || params.assignment !== undefined || params.resume !== undefined)) {
+            throw new Error("Choose a batch, a single assignment, or a resume request");
+          }
+          if (params.prompt !== undefined && params.assignment !== undefined) throw new Error("Choose prompt or assignment, not both");
+          const controller = await getController(ctx);
+          let tasks: TaskRecord[];
+          let history: string | undefined;
+          let notice: string | undefined;
+          if (params.resume) {
+            const original = controller.list().tasks.find((task) => task.id === params.resume || task.sessionId === params.resume);
+            const result = await controller.resume(controller.parentActor, original?.id ?? params.resume, {
+              ...(params.prompt !== undefined || params.assignment !== undefined ? { message: formatAssignment(params.assignment ?? params.prompt) } : {}),
+              ...(params.model !== undefined ? { model: params.model } : {}),
+              ...(params.thinking !== undefined ? { thinking: params.thinking as TaskInput["thinking"] } : {}),
+            });
+            tasks = [result.task]; history = result.history; notice = result.notice;
+          } else {
+            const inputs = params.tasks ? params.tasks.map((task) => ({
+              id: task.id, profile: task.profile, description: task.description, assignment: task.assignment,
+              needs: task.needs ?? [], ...optionsFrom(task), parentToolCallId: toolCallId,
+            })) : [{ id: params.id ?? `task-${randomUUID()}`, profile: params.subagent_type ?? "general-purpose",
+              description: params.description ?? "Delegated task", assignment: params.assignment ?? params.prompt,
+              needs: [], ...optionsFrom(params), parentToolCallId: toolCallId }];
+            tasks = (await controller.startBatch(controller.parentActor, inputs)).tasks;
+          }
+          const ids = tasks.map((task) => task.id);
+          onUpdate?.(response({ tasks: tasks.map((task) => subagentTaskView(task, [], false)) }, ctx));
+          if (params.run_in_background === false) {
+            let cancellation: Promise<unknown> | undefined;
+            const abort = () => {
+              cancellation ??= Promise.all(ids.map((id) => controller.cancel(controller.parentActor, id)));
+              void cancellation.catch(() => {});
+            };
+            signal?.addEventListener("abort", abort, { once: true });
+            if (signal?.aborted) abort();
+            try {
+              tasks = await controller.wait(controller.parentActor, ids);
+            } finally { signal?.removeEventListener("abort", abort); await cancellation; }
+          }
+          const deliveries = controller.list().deliveries;
+          return { ...response({ tasks: tasks.map((task) => subagentTaskView(task, deliveries)), history, notice }, ctx),
+            ...(tasks.some((task) => task.status === "failed") ? { isError: true } : {}) };
+        });
+      },
+    }),
+    defineTool({
+      name: "get_subagent_result", label: "Get agent result", description: "Inspect a native task or child session. Read-only; does not claim execution ownership or resume work.",
+      parameters: Type.Object({ agent_id: Type.String(), wait: Type.Optional(Type.Boolean()) }),
+      async execute(_id, params, signal, _update, ctx) {
+        return guarded(async () => {
+          const controller = await getController(ctx);
+          let task = controller.list().tasks.find((item) => item.id === params.agent_id || item.sessionId === params.agent_id);
+          if (!task) {
+            const history = await controller.history(controller.parentActor, params.agent_id);
+            if (!history) throw new Error(`Subagent task or session not found: ${params.agent_id}`);
+            const { run } = history;
+            return { ...response({ historical: { ...run, task: reportExcerpt(run.task ?? ""),
+              result: reportExcerpt(run.result ?? ""), error: reportExcerpt(run.error ?? "") } }, ctx, run.sessionPath),
+              ...(run.status === "failed" ? { isError: true } : {}) };
+          }
+          while (params.wait && ["queued", "running", "cancelling"].includes(task.status)) {
+            await pause(signal);
+            task = taskById(controller, params.agent_id);
+          }
+          const delivery = controller.list().deliveries.find((item) => item.kind === "report" && item.taskId === task.id && item.attempt === task.attempt);
+          return { ...response({ task: subagentTaskView(task, delivery ? [delivery] : []), deliveryId: delivery?.id }, ctx),
+            ...(task.status === "failed" ? { isError: true } : {}) };
+        });
+      },
+    }),
+    defineTool({
+      name: "steer_subagent", label: "Steer agent", description: "Send information to a native task or child session. Pending messages survive explicit resume and do not grant new user authority.",
+      parameters: Type.Object({ agent_id: Type.String(), message: Type.String() }),
+      async execute(_id, params, _signal, _update, ctx) {
+        return guarded(async () => {
+          const controller = await getController(ctx);
+          const task = taskById(controller, params.agent_id);
+          const message = await controller.message(controller.parentActor, task.id, params.message);
+          return response({ message }, ctx);
+        });
+      },
+    }),
+    defineTool({
+      name: "manage_subagents", label: "Manage subagents", description: "Inspect tasks, assign pending work, answer input requests, message, cancel, verify and close a delivery, or release integrated file changes. Never commits, merges or deletes worktrees.",
+      parameters: Type.Object({
+        action: Type.Union(["list", "assign", "message", "answer", "cancel", "close", "release"].map((value) => Type.Literal(value))),
+        task_id: Type.Optional(Type.String()), profile: Type.Optional(Type.String()), assignment: Type.Optional(assignmentSchema),
+        description: Type.Optional(Type.String()), message: Type.Optional(Type.String()),
+        delivery_id: Type.Optional(Type.String()), revision: Type.Optional(Type.String()),
+        input_revision: Type.Optional(Type.String()),
+        model: Type.Optional(Type.String()), thinking: Type.Optional(thinkingSchema), specialist_prompt: Type.Optional(Type.String()),
+      }),
+      async execute(_id, params, _signal, _update, ctx) {
+        return guarded(async () => {
+          const controller = await getController(ctx);
+          if (params.action === "list") {
+            const state = controller.list();
+            return response({ ownership: state.ownership, ...subagentMessageHistory(state.messages),
+              roles: getProfiles().filter((role) => role.enabled).map(subagentRoleView),
+              tasks: state.tasks.map((task) => subagentTaskView(task, state.deliveries, false)),
+              pendingDeliveries: state.deliveries.filter((item) => !item.acknowledgedAt).map((item) => ({ id: item.id, taskId: item.taskId, attempt: item.attempt, kind: item.kind })) }, ctx);
+          }
+          if (!params.task_id) throw new Error("task_id is required for this action");
+          const task = taskById(controller, params.task_id);
+          const actor = controller.parentActor;
+          if (params.action === "message") {
+            if (!params.message) throw new Error("message is required");
+            return response({ message: await controller.message(actor, task.id, params.message) }, ctx);
+          }
+          if (params.action === "answer") {
+            if (!params.message) throw new Error("message is required");
+            const resumed = await controller.resume(actor, task.id, { message: params.message,
+              model: params.model, thinking: params.thinking as TaskInput["thinking"] });
+            return response({ task: subagentTaskView(resumed.task, controller.list().deliveries), history: resumed.history, notice: resumed.notice }, ctx);
+          }
+          let changed: TaskRecord;
+          if (params.action === "assign") {
+            if (!params.profile) throw new Error("profile is required");
+            changed = await controller.assign(actor, task.id, { profile: params.profile, assignment: params.assignment,
+              inputRevision: params.input_revision,
+              description: params.description, specialistPrompt: params.specialist_prompt, model: params.model,
+              thinking: params.thinking as TaskInput["thinking"] });
+          } else if (params.action === "cancel") changed = await controller.cancel(actor, task.id);
+          else if (params.action === "close") {
+            if (!params.delivery_id) throw new Error("delivery_id is required after verifying the report");
+            changed = await controller.close(actor, task.id, params.delivery_id);
+          } else if (params.action === "release") {
+            if (!params.revision) throw new Error("An integrated commit OID is required");
+            changed = await controller.release(actor, task.id, params.revision);
