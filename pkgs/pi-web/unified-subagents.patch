+import assert from "node:assert/strict";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const { subagentTaskView, subagentRoleView } = await createJiti(import.meta.url).import("./subagent-task-view.ts");
+const { projectDelegationList } = await createJiti(import.meta.url).import("./subagent-controller.ts");
+
+test("inspection projects orphaned active work as interrupted without mutating saved state", () => {
+  const state = { version: 1, parentSessionFile: "/tmp/parent.jsonl", groups: [], messages: [], deliveries: [],
+    tasks: ["queued", "running", "cancelling", "blocked", "completed"].map((status) => ({ id: status, status, needs: [] })) };
+  const before = JSON.stringify(state);
+  for (const owner of ["unclaimed", "interrupted"]) {
+    assert.deepEqual(projectDelegationList(state, owner).tasks.map((task) => task.status),
+      ["interrupted", "interrupted", "interrupted", "blocked", "completed"]);
+  }
+  assert.equal(projectDelegationList(state, "elsewhere").tasks[1].status, "running");
+  assert.equal(JSON.stringify(state), before);
+});
+
+test("compact task views retain current acknowledged report identity, not prompts or resources", () => {
+  const task = { id: "one", groupId: "group", profile: "scout", description: "Inspect", status: "needs_input", attempt: 2,
+    needs: [], assignment: "private assignment", resources: { exactSystemPrompt: "private resources" }, lastInput: "private input",
+    model: "provider/model", thinking: "high", inputRevision: "base", report: { outcome: "needs_input", report: "Evidence", needs: "Decision" } };
+  const deliveries = [{ id: "old", taskId: "one", kind: "report", attempt: 1 },
+    { id: "current", taskId: "one", kind: "report", attempt: 2, acknowledgedAt: "now" }];
+  const view = subagentTaskView(task, deliveries);
+  assert.equal(view.reportDeliveryId, "current");
+  assert.equal(view.model, "provider/model");
+  assert.equal(view.thinking, "high");
+  assert.equal(view.inputRevision, "base");
+  assert.deepEqual(view.report, task.report);
+  assert.doesNotMatch(JSON.stringify(view), /private|resources|assignment|lastInput/);
+  assert.equal(subagentTaskView(task, deliveries, false).report, undefined);
+  assert.equal(subagentTaskView({ ...task, attempt: 3 }, deliveries).reportDeliveryId, undefined);
+});
+
+test("roles describe explicit input requirements for writers, extensions, and isolated readers", () => {
+  const role = { name: "reader", description: "Read", tools: ["read"], loadExtensions: false };
+  assert.equal(subagentRoleView(role).requiresInputRevision, false);
+  assert.equal(subagentRoleView({ ...role, loadExtensions: true }).requiresInputRevision, true);
+  assert.equal(subagentRoleView({ ...role, tools: ["bash"] }).requiresInputRevision, true);
+  assert.equal(subagentRoleView({ ...role, isolation: "worktree" }).requiresInputRevision, true);
+});
diff --git a/lib/subagent-task-view.ts b/lib/subagent-task-view.ts
new file mode 100644
index 0000000..34974b8
--- /dev/null
+++ b/lib/subagent-task-view.ts
@@ -0,0 +1,28 @@
+import type { SubagentTaskView, SubagentTasksResponse } from "./api-types";
+import { reportExcerpt, type PendingDelivery, type TaskMessage, type TaskRecord } from "./subagent-task-types";
+import type { SubagentProfile } from "./subagents";
+
+export function subagentTaskView(task: TaskRecord & { blockedReason?: string }, deliveries: readonly PendingDelivery[] = [], includeReport = true): SubagentTaskView {
+  return {
+    id: task.id, groupId: task.groupId, profile: task.profile, description: task.description,
+    status: task.status, attempt: task.attempt, needs: task.needs, sessionId: task.sessionId,
+    sessionFile: task.sessionFile, worktreePath: task.worktreePath, worktreeBranch: task.worktreeBranch,
+    model: task.model, thinking: task.thinking, inputRevision: task.inputRevision,
+    releaseRevision: task.releaseRevision, closedAt: task.closedAt, blockedReason: task.blockedReason,
+    reportDeliveryId: deliveries.find((item) => item.kind === "report" && item.taskId === task.id && item.attempt === task.attempt)?.id,
+    ...(includeReport && task.report ? { report: { ...task.report, report: reportExcerpt(task.report.report) } } : {}),
+  };
+}
+
+export function subagentRoleView(role: SubagentProfile): SubagentTasksResponse["roles"][number] {
+  return { name: role.name, description: role.description, tools: role.tools,
+    requiresInputRevision: role.loadExtensions || role.isolation === "worktree" || role.tools.some((tool) => ["bash", "powershell", "write", "edit"].includes(tool)) };
+}
+
+export function subagentMessageHistory(messages: readonly TaskMessage[]): Pick<SubagentTasksResponse, "messages" | "messagesOmitted"> {
+  return {
+    messages: messages.slice(-100).map(({ id, from, to, text, createdAt, deliveredAt }) =>
+      ({ id, from, to, text, createdAt, ...(deliveredAt ? { deliveredAt } : {}) })),
+    messagesOmitted: Math.max(0, messages.length - 100),
+  };
+}
