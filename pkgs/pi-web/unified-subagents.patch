diff --git a/lib/subagent-state-lock.ts b/lib/subagent-state-lock.ts
new file mode 100644
index 0000000..062ce35
--- /dev/null
+++ b/lib/subagent-state-lock.ts
@@ -0,0 +1,137 @@
+import { randomUUID } from "node:crypto";
+import fs from "node:fs";
+import { dirname } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import lockfile from "proper-lockfile";
+import { syncDirectorySync } from "./atomic-file";
+import { isProcessAlive, readProcessIdentity, type ProcessIdentity } from "./subagent-process";
+
+type Holder = ProcessIdentity & { token: string };
+const UUID = /^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/i;
+
+function readProof(path: string): Holder | undefined {
+  try {
+    const holder = JSON.parse(fs.readFileSync(path, "utf8"));
+    if (!holder || !Number.isSafeInteger(holder.pid) || holder.pid < 1
+      || typeof holder.bootId !== "string" || !UUID.test(holder.bootId)
+      || typeof holder.token !== "string" || !UUID.test(holder.token)
+      || typeof holder.startTime !== "string" || !/^\d+$/.test(holder.startTime)) {
+      throw new Error(`Cannot verify native metadata lock identity: ${path}`);
+    }
+    return holder;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+    throw new Error(`Cannot verify native metadata lock identity: ${path}`, { cause: error });
+  }
+}
+
+function unlinkIfPresent(path: string): void {
+  try { fs.unlinkSync(path); } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+  }
+}
+
+function retireOwnedProof(path: string): void {
+  const retired = `${path}.retired-${randomUUID()}`;
+  fs.renameSync(path, retired);
+  syncDirectorySync(dirname(path));
+  unlinkIfPresent(retired);
+}
+
+function publishProof(path: string, holder: Holder): void {
+  const candidate = `${path}.candidate-${randomUUID()}.json`;
+  try {
+    fs.writeFileSync(candidate, JSON.stringify(holder), { flag: "wx", mode: 0o600, flush: true });
+    fs.linkSync(candidate, path);
+  } finally {
+    unlinkIfPresent(candidate);
+  }
+}
+
+function recoverDeadHolder(proof: string, recoverer: Holder): boolean {
+  const previous = readProof(proof);
+  if (!previous || isProcessAlive(previous)) return false;
+  const candidate = `${proof}.candidate-${randomUUID()}.json`;
+  const claims: string[] = [];
+  const seen = new Set<string>();
+  let predecessor = previous.token;
+  try {
+    fs.writeFileSync(candidate, JSON.stringify(recoverer), { flag: "wx", mode: 0o600, flush: true });
+    for (;;) {
+      if (seen.has(predecessor)) throw new Error("Cyclic native metadata recovery identity");
+      seen.add(predecessor);
+      const claim = `${proof}.recovery-${previous.token}-${predecessor}.json`;
+      claims.push(claim);
+      try {
+        fs.linkSync(candidate, claim);
+        break;
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+      }
+      const winner = readProof(claim);
+      if (!winner || isProcessAlive(winner)) return false;
+      predecessor = winner.token;
+    }
+    const current = readProof(proof);
+    if (!current || current.token !== previous.token || isProcessAlive(current)) return false;
+    retireOwnedProof(proof);
+    for (const claim of claims) unlinkIfPresent(claim);
+    return true;
+  } finally {
+    unlinkIfPresent(candidate);
+  }
+}
+
+export async function lockSubagentState(path: string): Promise<{ assertHeld(): void; release(): Promise<void> }> {
+  const identity = readProcessIdentity(process.pid);
+  if (!identity) throw new Error("Cannot establish metadata lock process identity");
+  const holder: Holder = { ...identity, token: randomUUID() };
+  const proof = `${path}.lock`;
+  let compromised: Error | undefined;
+  const requireHolder = () => {
+    if (readProof(proof)?.token !== holder.token) throw new Error("Native metadata lock ownership changed");
+  };
+  const backend = {
+    ...fs,
+    mkdir(target: string, callback: fs.NoParamCallback) {
+      try { publishProof(target, holder); } catch (error) { callback(error as NodeJS.ErrnoException); return; }
+      callback(null);
+    },
+    stat(_target: string, callback: (error: NodeJS.ErrnoException | null, stats?: fs.Stats) => void) {
+      let stats: fs.Stats;
+      try { stats = fs.statSync(proof); } catch (error) { callback(error as NodeJS.ErrnoException); return; }
+      callback(null, stats);
+    },
+    utimes(_target: string, atime: Date, mtime: Date, callback: fs.NoParamCallback) {
+      try { requireHolder(); fs.utimesSync(proof, atime, mtime); } catch (error) { callback(error as NodeJS.ErrnoException); return; }
+      callback(null);
+    },
+    rmdir(_target: string, callback: fs.NoParamCallback) {
+      try { requireHolder(); retireOwnedProof(proof); } catch (error) { callback(error as NodeJS.ErrnoException); return; }
+      callback(null);
+    },
+  };
+  for (let attempt = 0; ; attempt++) {
+    try {
+      const release = await lockfile.lock(path, {
+        realpath: false, stale: Number.MAX_SAFE_INTEGER, update: 1000, retries: 0, fs: backend,
+        onCompromised: (error) => { compromised = error; },
+      });
+      return {
+        assertHeld() {
+          if (compromised) throw compromised;
+          requireHolder();
+        },
+        async release() {
+          await release();
+          syncDirectorySync(dirname(path));
+        },
+      };
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ELOCKED") throw error;
+      if (recoverDeadHolder(proof, holder)) continue;
+      if (attempt >= 30) throw new Error(`Native metadata lock is held or its owner cannot be verified: ${proof}`, { cause: error });
+      await delay(Math.min(10 * 1.2 ** attempt, 100));
+    }
+  }
+}
