+const { createSubagentModelBridge } = await createJiti(import.meta.url).import("./subagent-model-bridge.ts");
+const model = (provider, id = "one") => ({ provider, id, name: id, api: "openai-completions",
+  baseUrl: "http://127.0.0.1:1", reasoning: false, input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32768, maxTokens: 512 });
+const context = { messages: [{ role: "user", content: "Fixture request", timestamp: 0 }] };
+
+function transport(requests) {
+  return (selected, supplied, options) => {
+    requests.push({ model: selected, context: supplied, options });
+    const stream = createAssistantMessageEventStream();
+    const message = { role: "assistant", provider: selected.provider, model: selected.id, api: selected.api,
+      content: [{ type: "text", text: "Synthetic response" }], stopReason: "stop", timestamp: 0,
+      usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2,
+        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } } };
+    stream.push({ type: "start", partial: message });
+    stream.push({ type: "done", reason: "stop", message });
+    stream.end();
+    return stream;
+  };
+}
