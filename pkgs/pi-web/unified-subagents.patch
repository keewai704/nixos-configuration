+test("a same-controller resume during deletion cannot unlink the new attempt's history", async (t) => {
+  const f = await fixture(t, { holdChildren: true });
+  const controller = await f.facade.getController(f.ctx);
+  await controller.startBatch(controller.parentActor, [input("racing")]);
+  await until(() => f.requests.length === 1);
+  const task = controller.list().tasks[0];
+  const reached = Promise.withResolvers();
+  const proceed = Promise.withResolvers();
+  t.after(() => proceed.resolve());
+  let mutated = false;
+  const deletion = f.facade.guardDeletion({ deleted: [{ id: task.sessionId, path: task.sessionFile }], rewritten: [] },
+    async () => { reached.resolve(); await proceed.promise; }, () => { mutated = true; unlinkSync(task.sessionFile); });
+  const settled = deletion.then(() => undefined, (error) => error);
+  await reached.promise;
+  await controller.resume(controller.parentActor, task.id, { message: "Resume during deletion" });
+  await until(() => f.requests.length === 2);
+  proceed.resolve();
+  assert.match(String(await settled), /attempt|history.*changed|running/i);
+  assert.equal(mutated, false);
+  assert.equal(existsSync(task.sessionFile), true);
+});
