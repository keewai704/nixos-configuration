+++ b/e2e/subagents.mjs
@@ -0,0 +1,191 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { createServer } from "node:http";
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { createJiti } from "jiti";
+
+const { updateDelegationState, readDelegationState } = await createJiti(import.meta.url).import("../lib/subagent-state.ts");
+const { enLocale } = await createJiti(import.meta.url).import("../lib/i18n/messages/en.ts");
+
+export async function seedSubagents(agentDir, project, sessionDir) {
+  const requests = [];
+  const provider = createServer(async (req, res) => {
+    if (req.url !== "/v1/chat/completions" || req.method !== "POST") {
+      res.writeHead(404).end();
+      return;
+    }
+    let body = "";
+    for await (const chunk of req) body += chunk;
+    const input = JSON.parse(body);
+    requests.push(input);
+    res.writeHead(200, { "Content-Type": "text/event-stream" });
+    const frame = { id: randomUUID(), object: "chat.completion.chunk", created: 1, model: input.model };
+    for (const choice of [
+      { index: 0, delta: { role: "assistant", content: "E2E native completion" }, finish_reason: null },
+      { index: 0, delta: {}, finish_reason: "stop" },
+    ]) res.write(`data: ${JSON.stringify({ ...frame, choices: [choice] })}\n\n`);
+    res.end("data: [DONE]\n\n");
+  });
+  await new Promise((resolve, reject) => { provider.once("error", reject); provider.listen(0, "127.0.0.1", resolve); });
+  const close = () => new Promise((resolve, reject) => provider.close((error) => error ? reject(error) : resolve()));
+  try {
+    const models = [1280, 390].map((width) => ({ id: `fixture-${width}`, name: `E2E ${width}`, reasoning: false,
+      input: ["text"], contextWindow: 32768, maxTokens: 1024, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } }));
+    writeFileSync(join(agentDir, "models.json"), JSON.stringify({ providers: { "e2e-native": {
+      baseUrl: `http://127.0.0.1:${provider.address().port}/v1`, api: "openai-completions", apiKey: "fixture-only", models,
+    } } }));
+    writeFileSync(join(agentDir, "settings.json"), JSON.stringify({ defaultProvider: "e2e-native", defaultModel: "fixture-1280",
+      defaultThinkingLevel: "off", packages: [], skills: [], extensions: [join(agentDir, "extensions/e2e-dialog.js")], checkForUpdates: false }));
+    mkdirSync(join(agentDir, "agents"), { recursive: true });
+    writeFileSync(join(agentDir, "agents", "settings.json"), JSON.stringify({ builtInEnabled: true, maxConcurrent: 4 }));
+    const git = (...args) => execFileSync("git", ["-C", project, ...args], { encoding: "utf8", env: {
+      PATH: process.env.PATH, HOME: agentDir, GIT_CONFIG_NOSYSTEM: "1", GIT_CONFIG_GLOBAL: "/dev/null",
+    } }).trim();
+    git("init", "-q");
+    writeFileSync(join(project, "README.md"), "E2E committed input\n");
+    git("add", "README.md");
+    git("-c", "user.name=E2E", "-c", "user.email=e2e@invalid", "-c", "commit.gpgsign=false", "commit", "-qm", "Fixture input");
+    const revision = git("rev-parse", "HEAD");
+    const fixtures = new Map();
+    const sessionIds = [];
+    for (const width of [1280, 390]) {
+      const id = randomUUID();
+      const file = join(sessionDir, `2026-08-23T00-00-00-000Z_${id}.jsonl`);
+      const timestamp = new Date().toISOString();
+      const header = (sessionId) => ({ type: "session", version: 3, id: sessionId, cwd: project, timestamp });
+      const entries = [{ type: "model_change", id: "model", parentId: null, timestamp, provider: "e2e-native", modelId: `fixture-${width}` },
+        { type: "message", id: "user", parentId: "model", timestamp, message: { role: "user", content: `E2E native parent ${width}`, timestamp: Date.now() } }];
+      const tasks = [];
+      const deliveries = [];
+      for (const name of ["needs-input", "done"]) {
+        const sessionId = randomUUID();
+        const sessionFile = join(sessionDir, `2026-08-23T00-00-00-000Z_${sessionId}.jsonl`);
+        const resources = { version: 1, appendSystemPrompt: [], tools: [], loadSkills: false, loadExtensions: false };
+        const report = name === "done" ? { outcome: "completed", report: "Fixture evidence verified" }
+          : { outcome: "needs_input", report: "Waiting for parent input", needs: "Choose the next fixture step" };
+        const task = { id: name, groupId: "fixture", profile: "scout", description: `Fixture ${name}`, assignment: "Inspect fixture only",
+          needs: [], status: report.outcome, attempt: 1, createdAt: timestamp, updatedAt: timestamp,
+          sessionId, sessionFile, resources, historyPersisted: true, report, model: `e2e-native/fixture-${width}`, thinking: "off" };
+        tasks.push(task);
+        const metadata = { version: 1, parentSessionId: id, parentSessionPath: file, parentToolCallId: name,
+          profile: "scout", description: task.description, task: task.assignment, runInBackground: true, createdAt: timestamp,
+          resourceSnapshot: resources };
+        writeFileSync(sessionFile, [header(sessionId), entries[0],
+          { type: "custom", id: "metadata", parentId: "model", timestamp, customType: "pi-web:subagent", data: metadata },
+          { type: "message", id: "child-user", parentId: "metadata", timestamp,
+            message: { role: "user", content: `E2E retained child ${width} ${name}`, timestamp: Date.now() } },
+        ].map((entry) => JSON.stringify(entry)).join("\n") + "\n");
+        const deliveryId = randomUUID();
+        deliveries.push({ id: deliveryId, taskId: name, attempt: 1, kind: "report", createdAt: timestamp, acknowledgedAt: timestamp, report });
+        entries.push({ type: "custom_message", id: `receipt-${name}`, parentId: entries.at(-1).id, timestamp,
+          customType: "native-subagent", content: report.report, display: true, details: { deliveryId, parentSessionId: id, taskId: name, attempt: 1 } });
+        sessionIds.push(sessionId);
+      }
+      for (const name of ["dependent", "cancel-me"]) tasks.push({ id: name, groupId: "fixture", description: `Fixture ${name}`,
+        assignment: "Inspect fixture only", needs: name === "dependent" ? [{ taskId: "done", input: "integrated_changes" }] : [],
+        status: "blocked", attempt: 0, createdAt: timestamp, updatedAt: timestamp });
+      writeFileSync(file, [header(id), ...entries].map((entry) => JSON.stringify(entry)).join("\n") + "\n");
+      await updateDelegationState(agentDir, file, (state) => {
+        state.parentSessionId = id;
+        state.groups.push({ id: "fixture", createdAt: timestamp });
+        state.tasks.push(...tasks);
+        state.deliveries.push(...deliveries);
+      });
+      sessionIds.push(id);
+      fixtures.set(width, { id, file, revision, state: () => readDelegationState(agentDir, file),
+        requests: () => requests.filter((request) => request.model === `fixture-${width}`) });
+    }
+    return { fixtures, sessionIds, close };
+  } catch (error) { await close(); throw error; }
+}
+
+export async function checkSubagents(page, base, fixture, artifacts, width) {
+  const get = async () => {
+    const response = await page.request.get(`${base}/api/subagents/tasks?parentSessionId=${fixture.id}`);
+    assert.equal(response.status(), 200);
+    return response.json();
+  };
+  const until = async (predicate) => {
+    const deadline = Date.now() + 30_000;
+    while (!await predicate()) {
+      assert.ok(Date.now() < deadline, "Native task operation timed out");
+      await delay(100);
+    }
+  };
+  const open = async () => {
+    const response = await page.goto(`${base}/?session=${fixture.id}`, { waitUntil: "domcontentloaded" });
+    assert.equal(response.status(), 200, "Native task page must compile before UI assertions");
+    await page.locator('[data-entry-id="user"]:not([data-message-role])')
+      .getByText(`E2E native parent ${width}`, { exact: true }).waitFor();
+    if (width < 600) await page.locator('[aria-controls="mobile-toolbar-actions"]').click();
+    await page.getByRole("button", { name: enLocale.messages["agentSwitcher.title"], exact: true }).click();
+    await page.getByRole("article", { name: "needs-input: Fixture needs-input", exact: true }).waitFor();
+  };
+  const row = (id) => page.getByRole("article", { name: `${id}: Fixture ${id}`, exact: true });
+  const controls = async (id) => {
+    const summary = row(id).getByText("Parent controls", { exact: true });
+    if (!await summary.locator("..").evaluate((element) => element.open)) await summary.click();
+    return row(id);
+  };
+  const act = async (id, button) => {
+    const response = page.waitForResponse((response) => response.url().endsWith("/api/subagents/tasks")
+      && response.request().method() === "POST" && response.request().postDataJSON().task_id === id);
+    await row(id).getByRole("button", { name: button, exact: true }).click();
+    const result = await response;
+    assert.equal(result.status(), 200, await result.text());
+  };
+  await open();
+  await row("needs-input").getByText("Choose the next fixture step", { exact: false }).waitFor();
+  assert.match(await row("dependent").innerText(), /done/);
+  assert.match(await row("dependent").innerText(), /Blocked/);
+  assert.equal(fixture.requests().length, 0, "Viewing tasks must not start a model");
+  await controls("needs-input");
+  assert.equal(await row("needs-input").getByRole("button", { name: "Resume", exact: true }).isDisabled(), true);
+  const message = `Evidence from browser ${width}`;
+  await row("needs-input").getByLabel("Message or resume input (needs-input)", { exact: true }).fill(message);
+  await act("needs-input", "Send message");
+  await row("needs-input").getByText("Messages", { exact: true }).click();
+  await row("needs-input").getByText(message, { exact: true }).waitFor();
+  assert.match(await row("needs-input").innerText(), /parent → needs-input/);
+  assert.ok(fixture.state().messages.some((item) => item.to === "needs-input" && item.from === "parent" && item.text === message));
+  assert.equal((await get()).tasks.find((task) => task.id === "needs-input").status, "needs_input");
+  assert.equal(fixture.requests().length, 0, "Sending information must not resume paused work");
+  await row("needs-input").getByLabel("Message or resume input (needs-input)", { exact: true }).fill("Proceed with the fixture");
+  await act("needs-input", "Resume");
+  await until(async () => (await get()).tasks.find((task) => task.id === "needs-input").status === "completed");
+  assert.ok(fixture.requests().some((request) => JSON.stringify(request.messages).includes(message)));
+  const resumed = fixture.state().tasks.find((task) => task.id === "needs-input");
+  assert.match(readFileSync(resumed.sessionFile, "utf8"), new RegExp(message));
+  await controls("dependent");
+  await row("dependent").getByLabel("Exact role (dependent)", { exact: true }).selectOption("worker");
+  assert.equal(await row("dependent").getByRole("button", { name: "Assign pending task", exact: true }).isDisabled(), true);
+  await row("dependent").getByLabel("Exact role (dependent)", { exact: true }).selectOption("scout");
+  await act("dependent", "Assign pending task");
+  assert.equal((await get()).tasks.find((task) => task.id === "dependent").status, "blocked");
+  await controls("done");
+  await row("done").getByLabel("Integrated commit OID (done)", { exact: true }).fill(fixture.revision);
+  await act("done", "Release integrated revision");
+  await until(async () => (await get()).tasks.find((task) => task.id === "dependent").status === "completed");
+  await controls("done");
+  assert.equal(await row("done").getByRole("button", { name: "Close verified delivery", exact: true }).isDisabled(), true);
+  await row("done").getByLabel("I verified this report and its evidence (done)", { exact: true }).check();
+  await act("done", "Close verified delivery");
+  assert.ok(fixture.state().tasks.find((task) => task.id === "done").closedAt);
+  await controls("cancel-me");
+  await act("cancel-me", "Cancel task");
+  assert.equal((await get()).tasks.find((task) => task.id === "cancel-me").status, "aborted");
+  await until(async () => (await get()).pendingDeliveries.length === 0);
+  await page.screenshot({ path: join(artifacts, `native-tasks-${width}.png`) });
+  const attempts = fixture.state().tasks.map((task) => [task.id, task.attempt]);
+  await open();
+  assert.deepEqual(fixture.state().tasks.map((task) => [task.id, task.attempt]), attempts);
+  assert.equal((await get()).tasks.some((task) => ["queued", "running"].includes(task.status)), false);
+  await row("needs-input").getByRole("link", { name: "Open child conversation (needs-input)", exact: true }).click();
+  await page.waitForURL((url) => url.searchParams.get("session") === resumed.sessionId);
+  await page.locator('[data-entry-id="child-user"]:not([data-message-role])')
+    .getByText(`E2E retained child ${width} needs-input`, { exact: true }).waitFor();
+  console.log(`PASS: ${width}px native task states, messages, assign/resume/cancel/release/verified-close, retained history and reconnect`);
+}
