diff --git a/lib/subagent-model-bridge.ts b/lib/subagent-model-bridge.ts
new file mode 100644
index 0000000..313e4b6
--- /dev/null
+++ b/lib/subagent-model-bridge.ts
@@ -0,0 +1,131 @@
+import { InMemoryCredentialStore, type Api, type AuthResult, type Model, type Provider } from "@earendil-works/pi-ai";
+import { ModelRuntime, type ModelRegistry } from "@earendil-works/pi-coding-agent";
+import { isDeepStrictEqual } from "node:util";
+
+const modelKey = (model: Pick<Model<Api>, "provider" | "id">) => `${model.provider}\0${model.id}`;
+
+interface RuntimeScope {
+  registry: ModelRegistry;
+  models: Map<string, Model<Api>>;
+  available: Set<string>;
+  adapters: Map<string, Provider>;
+  bindings: Map<string, Provider | undefined>;
+  runtime?: ModelRuntime;
+  selected?: Model<Api>;
+}
+
+export function createSubagentModelBridge(getRegistry: () => ModelRegistry) {
+  const scopes = new WeakMap<ModelRuntime, RuntimeScope>();
+
+  function requireCapturedBinding(scope: RuntimeScope, selected: Model<Api>): void {
+    if (getRegistry() !== scope.registry || scope.registry.getProvider(selected.provider) !== scope.bindings.get(selected.provider)
+      || !isDeepStrictEqual(scope.registry.find(selected.provider, selected.id), selected)
+      || scope.runtime?.getRegisteredNativeProvider(selected.provider) !== scope.adapters.get(selected.provider)) {
+      throw new Error("The parent model binding changed or was removed; create a new delegation runtime");
+    }
+  }
+
+  async function requestAuth(scope: RuntimeScope, selected: Model<Api>): Promise<AuthResult> {
+    requireCapturedBinding(scope, selected);
+    if (!scope.registry.find(selected.provider, selected.id)
+      || !scope.registry.getAvailable().some((model) => modelKey(model) === modelKey(selected))) {
+      throw new Error(`Parent model is unavailable or removed: ${selected.provider}/${selected.id}`);
+    }
+    const result = await scope.registry.getApiKeyAndHeaders(selected);
+    requireCapturedBinding(scope, selected);
+    if (!result.ok) throw new Error(result.error);
+    if (!Object.hasOwn(result, "apiKey") || !Object.hasOwn(result, "env")) {
+      throw new Error("Parent authentication is unavailable or the pinned SDK authentication result contract changed");
+    }
+    return { auth: { apiKey: result.apiKey, headers: result.headers, baseUrl: result.baseUrl }, env: result.env };
+  }
+
+  async function resolveModelRuntime(): Promise<ModelRuntime> {
+    const registry = getRegistry();
+    const models = registry.getAll();
+    const parentIds = new Set([...registry.getRegisteredProviderIds(), ...models.map((model) => model.provider)]);
+    const scope: RuntimeScope = {
+      registry,
+      models: new Map(models.map((model) => [modelKey(model), structuredClone(model)])),
+      available: new Set(registry.getAvailable().map(modelKey)),
+      adapters: new Map(),
+      bindings: new Map([...parentIds].map((id) => [id, registry.getProvider(id)])),
+    };
+    const runtime = await ModelRuntime.create({ credentials: new InMemoryCredentialStore(), modelsPath: null,
+      refreshOnCreate: false, allowModelNetwork: false });
+    const refresh = runtime.refresh.bind(runtime);
+    runtime.refresh = (options = {}) => refresh({ ...options, allowNetwork: false });
+    scope.runtime = runtime;
+    const register = runtime.registerProvider.bind(runtime);
+    const registerNative = runtime.registerNativeProvider.bind(runtime);
+    const unregister = runtime.unregisterProvider.bind(runtime);
+    runtime.registerProvider = (id, config) => { if (id !== scope.selected?.provider) register(id, config); };
+    runtime.registerNativeProvider = (provider) => { if (provider.id !== scope.selected?.provider) registerNative(provider); };
+    runtime.unregisterProvider = (id) => { if (id !== scope.selected?.provider) unregister(id); };
+    const ids = new Set([...runtime.getProviders().map((provider) => provider.id), ...parentIds]);
+    for (const id of ids) {
+      const binding = scope.bindings.get(id) ?? runtime.getProvider(id);
+      if (!binding) throw new Error(`Parent provider binding is unavailable: ${id}`);
+      const catalog = [...scope.models.values()].filter((model) => model.provider === id).map((model) => {
+        const childModel = structuredClone(model);
+        delete childModel.headers;
+        return childModel;
+      });
+      const requireSelected = (model: Model<Api>) => {
+        if (!scope.selected || modelKey(model) !== modelKey(scope.selected)) {
+          throw new Error("A different model requires a new prepared delegation runtime");
+        }
+        requireCapturedBinding(scope, scope.selected);
+      };
+      const adapter: Provider = {
+        id, name: binding.name, baseUrl: binding.baseUrl, headers: binding.headers,
+        getModels: () => catalog,
+        filterModels: (models) => models.filter((model) => scope.available.has(modelKey(model))),
+        auth: { apiKey: {
+          name: "Parent session authentication",
+          check: async () => catalog.some((model) => scope.available.has(modelKey(model))) ? { type: "api_key" } : undefined,
+          resolve: async () => {
+            if (!scope.selected || scope.selected.provider !== id) throw new Error("The delegation model has not been prepared");
+            return requestAuth(scope, scope.selected);
+          },
+        } },
+        stream(model, context, options) {
+          requireSelected(model);
+          return binding.stream(model, context, options);
+        },
+        streamSimple(model, context, options) {
+          requireSelected(model);
+          return binding.streamSimple(model, context, options);
+        },
+        ...(binding.fetchDeferred ? { fetchDeferred: (model, handle, options) => {
+          requireSelected(model);
+          return binding.fetchDeferred!(model, handle, options);
+        } } : {}),
+        ...(binding.cancelDeferred ? { cancelDeferred: (model, handle, options) => {
+          requireSelected(model);
+          return binding.cancelDeferred!(model, handle, options);
+        } } : {}),
+      };
+      scope.adapters.set(id, adapter);
+      runtime.registerNativeProvider(adapter);
+    }
+    await runtime.refresh({ allowNetwork: false });
+    scopes.set(runtime, scope);
+    return runtime;
+  }
+
+  async function prepareModel(runtime: ModelRuntime, model: Model<Api>): Promise<void> {
+    const scope = scopes.get(runtime);
+    const selected = scope?.models.get(modelKey(model));
+    if (!scope || !selected || !scope.available.has(modelKey(selected))) {
+      throw new Error(`Parent model is unavailable: ${model.provider}/${model.id}`);
+    }
+    if (scope.selected && modelKey(scope.selected) !== modelKey(selected)) {
+      throw new Error("A different model requires a new prepared delegation runtime");
+    }
+    await requestAuth(scope, selected);
+    scope.selected = selected;
+  }
+
+  return { resolveModelRuntime, prepareModel };
+}
