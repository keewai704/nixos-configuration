+function legacySession(f, options = {}) {
+  const manager = SessionManager.create(options.cwd ?? f.cwd);
+  const timestamp = new Date().toISOString();
+  const metadata = {
+    version: 1, parentSessionId: f.parent.parentSessionId, parentSessionPath: f.sessionFile,
+    parentToolCallId: "old-call", profile: "retired-custom-role", description: "Old native child",
+    task: "Continue the old assignment", createdAt: timestamp, runInBackground: true,
+    resourceSnapshot: { version: 1, appendSystemPrompt: ["Original scope"], tools: ["read"], loadSkills: false, loadExtensions: false },
+    ...options.metadata,
+  };
+  const entries = [
+    { type: "session", version: 3, id: manager.getSessionId(), timestamp, cwd: options.cwd ?? f.cwd },
+    { type: "custom", id: "metadata", parentId: null, timestamp, customType: "pi-web:subagent", data: metadata },
+    { type: "model_change", id: "model", parentId: "metadata", timestamp, provider: "controller-fixture", modelId: "fixture" },
+    { type: "message", id: "assistant", parentId: "model", timestamp, message: {
+      role: "assistant", provider: "controller-fixture", model: "fixture", api: "openai-completions",
+      content: [{ type: "text", text: "Original historical evidence" }], stopReason: "stop", timestamp: Date.now(),
+      usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2,
+        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+    } },
+    { type: "custom", id: "result", parentId: "assistant", timestamp, customType: "pi-web:subagent-result",
+      data: { version: 1, status: "completed", result: "Original report", completedAt: timestamp } },
+  ];
+  const text = entries.map((entry) => JSON.stringify(entry)).join("\n") + "\n";
+  writeFileSync(manager.getSessionFile(), text);
+  return { id: manager.getSessionId(), file: manager.getSessionFile(), text, metadata };
+}
