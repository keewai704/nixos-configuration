+      assert.equal(observations.sessions.get(running.sessionId).preflightAvailable, true);
+
+      const pending = await f.call("get_subagent_result", { agent_id: running.sessionId });
+      assert.equal(pending.details.task.status, "running");
+      const steering = `STEER_FIXTURE_${randomUUID()}`;
+      await f.call("steer_subagent", { agent_id: running.sessionId, message: steering });
+      assert.equal(run.requests[0].finished, false, "The child was really withheld");
+
+      run.release();
+      await f.delivered("background");
+      const completed = await f.call("get_subagent_result", {
+        agent_id: running.sessionId, wait: true,
+      });
+      assert.equal(completed.details.task.status, "completed");
+      assert.ok(run.requests.some((request) => JSON.stringify(request.context).includes(steering)));
+      assertChild(run, f.state().tasks.find((task) => task.id === "background"));
+
+      const queued = f.child([
+        toolCall("exec", { code: "text(2)" }),
+        toolCall("exec", { code: probeCode }),
+      ]);
+      f.holdNextParentFinal();
+      const foreground = f.call("Agent", {
+        id: "foreground",
+        subagent_type: "codemode-fixture",
+        prompt: queued.marker,
+        input_revision: f.revision,
+        run_in_background: false,
+      });
+      await until(() => queued.requests.length === 1, "foreground child request");
+      assert.equal(f.parent.isStreaming, true);
+      queued.release();
+      await until(() => f.heldFinal !== undefined, "parent final response withheld");
+      await until(() => f.state().deliveries.some((item) => item.taskId === "foreground"), "queued report record");
+      const delivery = f.state().deliveries.find((item) => item.taskId === "foreground");
+      await until(() => f.parent.agent.peekQueuedMessages().some((message) =>
+        message.details?.deliveryId === delivery.id), "actual SDK queued custom report");
+      assert.equal(f.receipts(delivery.id).length, 0);
+      assert.equal(delivery.acknowledgedAt, undefined);
+
+      f.parent.clearQueue();
+      assert.equal(f.parent.agent.peekQueuedMessages().some((message) =>
+        message.details?.deliveryId === delivery.id), false);
+      f.heldFinal.finish();
+      await foreground;
+      assert.ok(f.requests.some((request) => request.kind === "parent"
+        && JSON.stringify(request.context.messages).includes(JSON.stringify(text(f.receipts(delivery.id)[0]?.content)).slice(1, -1))),
+      "Recovered report reaches a provider without another user prompt");
+
+      if (f.facade) await bounded(f.facade.reactivateParent(f.parent.sessionId), "Web report reconciliation");
+      await f.delivered("foreground");
+      await f.call("manage_subagents", { action: "list" });
+      if (f.facade) await bounded(f.facade.reactivateParent(f.parent.sessionId), "Web receipt reconciliation");
+      assert.equal(f.receipts(delivery.id).length, 1);
+      assert.ok(f.state().deliveries.find((item) => item.id === delivery.id).acknowledgedAt);
+      assertChild(queued, f.state().tasks.find((task) => task.id === "foreground"));
+
+      for (const request of f.requests.filter((item) => item.kind === "parent")) {
+        for (const name of required) assert.ok(request.tools.includes(name), `${name} is model-declared`);
+        assert.deepEqual(request.model, {
+          provider: "codemode-test", id: "codex-fixture", api: "openai-completions",
+        });
+      }
+      assert.equal(fetchAttempts, 0);
+    });
+}
