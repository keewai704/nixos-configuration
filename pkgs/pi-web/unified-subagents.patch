+  const credentials = new InMemoryCredentialStore();
+  const runtime = await ModelRuntime.create({ credentials, modelsPath: null, refreshOnCreate: false, allowModelNetwork: false });
+  const registry = new ModelRegistry(runtime);
+  const bridge = createSubagentModelBridge(() => registry);
+  const requests = [];
+  const stream = transport(requests);
+  return { runtime, registry, bridge, credentials, requests, stream };
