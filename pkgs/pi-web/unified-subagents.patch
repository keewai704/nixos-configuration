+      refreshModels: async () => { catalogRefreshes++; },
+      auth: { apiKey: { name: "Fixture", check: async () => ({ type: "api_key" }), resolve: async () => {
+        if (id === "unrelated") unrelatedAuth++;
+        else selectedAuth++;
+        return { auth: { apiKey: token, headers: { "x-fixture": "header-secret", "x-delete": null }, baseUrl: "http://127.0.0.1:2" },
+          env: { FIXTURE_REGION: "fixture-region" } };
+      } } }, stream: f.stream, streamSimple: f.stream });
+  }
+  await f.runtime.refresh({ allowNetwork: false });
+  const before = catalogRefreshes;
+  const child = await f.bridge.resolveModelRuntime();
