+  assert.equal(second.attempt, 2);
+  const entries = SessionManager.open(second.sessionFile).getEntries();
+  const bindings = entries.filter((entry) => entry.type === "custom" && entry.customType === "cli-fixture:bound");
+  assert.equal(bindings.length, 2);
