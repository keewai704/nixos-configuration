@@ -27,6 +27,65 @@ function makePromptInner(prompt) {
   };
 }

+test("a managed child wrapper detaches without shutting down or disposing the shared SDK session", () => {
+  const calls = [];
+  const inner = makePromptInner(async () => {});
+  inner.isBashRunning = true;
+  inner.abortBash = () => calls.push("abort");
+  inner.dispose = () => calls.push("dispose");
+  inner.extensionRunner.emit = async () => calls.push("shutdown");
+  const wrapper = new AgentSessionWrapper(inner, { ownsSession: false });
+  wrapper.destroy();
+  assert.equal(wrapper.isAlive(), false);
+  assert.deepEqual(calls, []);
+});
+
+test("wrapper shutdown awaits shared child cancellation and leaves SDK teardown to its owner", async () => {
+  const gate = Promise.withResolvers();
+  const calls = [];
+  const inner = makePromptInner(async () => {});
+  inner.dispose = () => calls.push("dispose");
+  inner.extensionRunner.emit = async () => calls.push("sdk-shutdown");
+  const wrapper = new AgentSessionWrapper(inner, { ownsSession: false, beforeShutdown: async () => {
+    calls.push("cancel"); await gate.promise; calls.push("cancelled");
+  } });
+  const stopping = wrapper.shutdown();
+  await nextTurn();
+  assert.equal(wrapper.isAlive(), true);
+  assert.deepEqual(calls, ["cancel"]);
+  gate.resolve();
+  await stopping;
+  assert.equal(wrapper.isAlive(), false);
+  assert.deepEqual(calls, ["cancel", "cancelled"]);
+});
+
+test("parent shutdown awaits the delegation owner before emitting SDK shutdown and disposing", async () => {
+  const gate = Promise.withResolvers();
+  const calls = [];
+  const inner = makePromptInner(async () => {});
+  inner.dispose = () => calls.push("dispose");
+  inner.extensionRunner.emit = async () => calls.push("sdk-shutdown");
+  const wrapper = new AgentSessionWrapper(inner, { beforeShutdown: async () => {
+    calls.push("children"); await gate.promise; calls.push("released");
+  } });
+  const stopping = wrapper.shutdown();
+  await nextTurn();
+  assert.deepEqual(calls, ["children"]);
+  gate.resolve();
+  await stopping;
+  assert.deepEqual(calls, ["children", "released", "sdk-shutdown", "dispose"]);
+});
+
+test("managed child commands cannot bypass the shared task controller", async () => {
+  const inner = makePromptInner(async () => assert.fail("direct child prompt"));
+  const wrapper = new AgentSessionWrapper(inner, { ownsSession: false });
+  try {
+    for (const type of ["prompt", "steer", "follow_up", "set_tools", "set_model", "reload", "fork", "bash", "abort"]) {
+      await assert.rejects(wrapper.send({ type, message: "unexpected" }), /parent task controls/i);
+    }
+  } finally { wrapper.destroy(); }
+});
+
