+test("child controls report through the bound actor without awaiting their own turn's completion", async () => {
+  const { createSubagentChildTools } = await load();
+  const reports = [];
+  const tools = createSubagentChildTools({ report: (value) => reports.push(value), message: async () => {} });
+  assert.deepEqual(tools.map((tool) => tool.name), ["report_subagent", "send_subagent_message"]);
+  const report = { outcome: "needs_input", report: "The input is ambiguous", needs: "Which target?" };
+  const result = await tools[0].execute("call", report, undefined, undefined, {});
+  assert.deepEqual(reports, [report]);
+  assert.match(result.content[0].text, /recorded/i);
+  await assert.rejects(tools[0].execute("bad", { outcome: "needs_input", report: "Missing question" }, undefined, undefined, {}), /needs|input/i);
+});
+
+test("child messages have a bound sender and enforce the UTF-8 byte limit", async () => {
+  const { createSubagentChildTools } = await load();
+  const messages = [];
+  const tools = createSubagentChildTools({ report: () => {}, message: async (to, text) => messages.push({ to, text }) });
+  await tools[1].execute("call", { to: "sibling", text: "The parser is ready", from: "forged" }, undefined, undefined, {});
+  assert.deepEqual(messages, [{ to: "sibling", text: "The parser is ready" }]);
+  await assert.rejects(tools[1].execute("large", { to: "parent", text: "あ".repeat(3000) }, undefined, undefined, {}), /8 KiB/);
+  assert.equal(messages.length, 1);
