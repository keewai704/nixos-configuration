index 0000000..996c143
--- /dev/null
+++ b/lib/subagent-controller.test.mjs
@@ -0,0 +1,803 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import {
+  appendFileSync, existsSync, mkdirSync, mkdtempSync, readFileSync,
+  readdirSync, rmSync, symlinkSync, writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import test, { after } from "node:test";
+import { createJiti } from "jiti";
+
+const previousAgentDir = process.env.PI_CODING_AGENT_DIR;
+const agentDir = mkdtempSync(join(tmpdir(), "pi-controller-"));
+process.env.PI_CODING_AGENT_DIR = agentDir;
+after(() => {
+  if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;
+  else process.env.PI_CODING_AGENT_DIR = previousAgentDir;
+  rmSync(agentDir, { recursive: true, force: true });
+});
+
+const jiti = createJiti(import.meta.url);
+const { createDelegationController } = await jiti.import("./subagent-controller.ts");
+const {
+  readDelegationState, updateDelegationState,
+} = await jiti.import("./subagent-state.ts");
+const { claimParent } = await jiti.import("./subagent-ownership.ts");
+const { saveProjectSubagentProfile, readSubagentRun } = await jiti.import("./subagents.ts");
+const { ModelRuntime, SessionManager } = await import("@earendil-works/pi-coding-agent");
+const { createAssistantMessageEventStream } = await import("@earendil-works/pi-ai");
+const exec = promisify(execFile);
+const delay = (ms = 5) => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function until(predicate, description = "condition") {
+  const deadline = Date.now() + 15000;
+  while (!predicate()) {
+    if (Date.now() > deadline) throw new Error(`Timed out waiting for ${description}`);
+    await delay();
+  }
+}
+
+function task(id, overrides = {}) {
+  return {
+    id, profile: "scout", description: `Inspect ${id}`,
+    assignment: `TASK:${id}\nInspect the fixture.`,
+    needs: [], parentToolCallId: `sdk-call-${id}`,
+    ...overrides,
+  };
+}
+
+async function fixture(t, options = {}) {
+  mkdirSync(join(agentDir, "agents"), { recursive: true });
+  writeFileSync(join(agentDir, "agents", "settings.json"), JSON.stringify({
+    version: 1, builtInEnabled: true, maxConcurrent: options.limit ?? 4,
+  }));
+  const cwd = mkdtempSync(join(agentDir, "workspace-"));
+  const sessionFile = join(cwd, "parent.jsonl");
+  const parentSessionId = randomUUID();
+  writeFileSync(sessionFile, `${JSON.stringify({
+    type: "session", version: 3, id: parentSessionId,
+    timestamp: new Date().toISOString(), cwd,
+  })}\n`);
+  writeFileSync(join(cwd, "AGENTS.md"), "Controller fixture repository instructions.\n");
+  const requests = [];
+  const notifications = [];
+  const children = new Map();
+  const controllers = [];
+  let streaming = 0;
+  let peak = 0;
+  const runtime = await ModelRuntime.create({
+    authPath: join(cwd, "fixture-auth.json"),
+    modelsPath: null,
+    modelsStorePath: join(cwd, "fixture-models.json"),
+    refreshOnCreate: false,
+  });
+  runtime.registerProvider("controller-fixture", {
+    baseUrl: "http://127.0.0.1:1",
+    apiKey: "synthetic-fixture-only",
+    api: "openai-completions",
+    models: [{
+      id: "fixture", name: "Controller fixture", reasoning: false, input: ["text"],
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      contextWindow: 262144, maxTokens: 131072,
+    }],
+    streamSimple(model, context, streamOptions) {
+      const stream = createAssistantMessageEventStream();
+      const base = {
+        role: "assistant", api: model.api, provider: model.provider, model: model.id,
+        content: [], stopReason: "stop", timestamp: Date.now(),
+        usage: {
+          input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2,
+          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+        },
+      };
+      streaming++;
+      peak = Math.max(peak, streaming);
+      const request = {
+        context: structuredClone(context),
+        finished: false,
+        finish(value = "Fixture completed") {
+          if (request.finished) return;
+          request.finished = true;
+          streaming--;
+          if (value === "ABORT") {
+            stream.push({
+              type: "error", reason: "aborted",
+              error: { ...base, stopReason: "aborted", errorMessage: "Fixture aborted" },
+            });
+          } else if (typeof value === "object") {
+            stream.push({
+              type: "done", reason: "toolUse",
+              message: {
+                ...base, stopReason: "toolUse",
+                content: [{
+                  type: "toolCall", id: randomUUID(), name: "report_subagent", arguments: value,
+                }],
+              },
+            });
+          } else {
+            stream.push({
+              type: "done", reason: "stop",
+              message: { ...base, content: [{ type: "text", text: value }] },
+            });
+          }
+          stream.end();
+        },
+      };
+      requests.push(request);
+      stream.push({ type: "start", partial: base });
+      if (streamOptions?.signal?.aborted) request.finish("ABORT");
+      else streamOptions?.signal?.addEventListener("abort", () => request.finish("ABORT"), { once: true });
+      if (!options.hold) {
+        queueMicrotask(() => request.finish(options.reply?.(request, requests.length - 1) ?? "Fixture completed"));
+      }
+      return stream;
+    },
+  });
+  const parent = {
+    parentSessionId, sessionFile, cwd,
+    effectiveModel: { provider: "controller-fixture", id: "fixture" },
+    thinking: "off",
+    resolveModelRuntime: async () => runtime,
+    readEntries: () => readFileSync(sessionFile, "utf8").trim().split("\n")
+      .map((line) => JSON.parse(line)).filter((entry) => entry.type !== "session"),
+    readContext: () => [{ role: "user", content: "PRIVATE PARENT CONTEXT" }],
+    async sendNotification(notification) {
+      notifications.push(structuredClone(notification));
+      if (options.receipts !== false) persistReceipt(notification.deliveryId);
+      if (options.sendError) throw new Error("Uncertain notification send");
+    },
+  };
+  function persistReceipt(deliveryId) {
+    appendFileSync(sessionFile, `${JSON.stringify({
+      type: "custom_message", id: randomUUID(), parentId: null,
+      timestamp: new Date().toISOString(), customType: "native-subagent",
+      content: "Receipt", display: true, details: { deliveryId },
+    })}\n`);
+  }
+  function controllerFor(host = parent) {
+    const controller = createDelegationController(host, {
+      agentDir,
+      onSession(record, child, actor) {
+        children.set(record.id, { task: record, child, actor });
+        return options.onSession?.(record, child, actor);
+      },
+    });
+    controllers.push(controller);
+    return controller;
+  }
+  const controller = controllerFor();
+  t.after(async () => {
+    for (const request of requests) request.finish("ABORT");
+    for (const current of controllers) await current.shutdown();
+  });
+  return {
+    cwd, sessionFile, parent, runtime, controller, controllerFor,
+    requests, notifications, children, persistReceipt,
+    get peak() { return peak; },
+    get streaming() { return streaming; },
+  };
+}
+
+async function drain(f, ids) {
+  let finished = false;
+  const waiting = f.controller.wait(f.controller.parentActor, ids);
+  void waiting.then(() => { finished = true; }, () => { finished = true; });
+  const deadline = Date.now() + 15000;
+  while (!finished) {
+    for (const request of f.requests) request.finish();
+    if (Date.now() > deadline) throw new Error("Timed out draining synthetic attempts");
+    await delay();
+  }
+  return waiting;
+}
