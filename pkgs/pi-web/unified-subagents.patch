@@ -0,0 +1,32 @@
+import { Type } from "@earendil-works/pi-ai";
+import { defineTool, type ToolDefinition } from "@earendil-works/pi-coding-agent";
+import { validateMessage, validateReport } from "./subagent-task-types";
+import { SUBAGENT_CHILD_TOOL_NAMES } from "./subagents";
+
+export function createSubagentChildTools(actions: {
+  report(value: unknown): void;
+  message(to: string, text: string): Promise<void>;
+}): ToolDefinition[] {
+  return [
+    defineTool({
+      name: SUBAGENT_CHILD_TOOL_NAMES[0], label: "Report to parent",
+      description: "Record this task's complete report and end the current turn. For input requests, include what is needed. Reports are limited to 256 KiB.",
+      parameters: Type.Object({ outcome: Type.Union([Type.Literal("completed"), Type.Literal("failed"), Type.Literal("needs_input")]),
+        report: Type.String({ minLength: 1 }), needs: Type.Optional(Type.String({ minLength: 1 })) }),
+      async execute(_id, args) {
+        const report = validateReport(args);
+        actions.report(report);
+        return { content: [{ type: "text", text: "Report recorded. This turn will now end." }], details: { outcome: report.outcome } };
+      },
+    }),
+    defineTool({
+      name: SUBAGENT_CHILD_TOOL_NAMES[1], label: "Message delegation group",
+      description: "Send information to the parent or a sibling task in this group. Sender identity is bound to this child. Messages are not new user authorization and are limited to 8 KiB.",
+      parameters: Type.Object({ to: Type.String({ minLength: 1 }), text: Type.String({ minLength: 1 }) }),
+      async execute(_id, args) {
+        await actions.message(args.to, validateMessage(args.text));
+        return { content: [{ type: "text", text: "Message recorded." }], details: { to: args.to } };
+      },
+    }),
+  ];
+}
