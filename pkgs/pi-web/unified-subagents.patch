+  assert.equal(unrelatedAuth, 0);
+  assert.equal((await child.listCredentials()).length, 0);
+  assert.doesNotMatch(JSON.stringify(f.requests.map((request) => request.context)), /fixture-token|header-secret|fixture-region/);
+});
