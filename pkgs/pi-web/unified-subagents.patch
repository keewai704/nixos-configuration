+import assert from "node:assert/strict";
+import { mkdtempSync, mkdirSync, symlinkSync, readlinkSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { createJiti } from "jiti";
+
+const jiti = createJiti(import.meta.url);
+const { isManagedSubagentFile } = await jiti.import("./subagent-managed-files.ts");
+const { writeBuiltInSubagentsEnabled, writeSubagentMaxConcurrent } = await jiti.import("./subagent-settings.ts");
+const { saveSubagentProfile, deleteSubagentProfile } = await jiti.import("./subagents.ts");
+
+test("Nix targets remain managed even if a store target is absent; ordinary paths remain editable", () => {
+  const dir = mkdtempSync(join(tmpdir(), "pi-managed-files-"));
+  try {
+    const file = join(dir, "settings.json");
+    const target = "/nix/store/pi-native-missing-fixture/settings.json";
+    symlinkSync(target, file);
+    assert.equal(isManagedSubagentFile(file), true);
+    assert.throws(() => writeBuiltInSubagentsEnabled(true, file), /managed/i);
+    assert.throws(() => writeSubagentMaxConcurrent(2, file), /managed/i);
+    assert.equal(readlinkSync(file), target);
+    const regular = join(dir, "regular.json");
+    writeFileSync(regular, "{}");
+    assert.equal(isManagedSubagentFile(regular), false);
+    assert.equal(isManagedSubagentFile(join(dir, "new", "file")), false);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test("profile save and delete reject Nix-managed targets before replacing their links", () => {
+  const dir = mkdtempSync(join(tmpdir(), "pi-managed-profile-"));
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  process.env.PI_CODING_AGENT_DIR = dir;
+  try {
+    mkdirSync(join(dir, "agents"));
+    const file = join(dir, "agents", "scout.md");
+    const target = "/nix/store/pi-native-missing-fixture/scout.md";
+    symlinkSync(target, file);
+    assert.throws(() => saveSubagentProfile(dir, "global", { name: "scout", tools: ["read"], displayName: "Scout",
+      description: "Inspect", systemPrompt: "Read" }), /managed/i);
+    assert.throws(() => deleteSubagentProfile(dir, "global", "scout"), /managed/i);
+    assert.equal(readlinkSync(file), target);
+  } finally {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
