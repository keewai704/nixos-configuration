+test("subagent APIs reconcile interrupted history and live queued or running state without rewriting files", async (t) => {
+  const dir = await mkdtemp(join(tmpdir(), "pi-web-interrupted-child-"));
+  const previousAgentDir = process.env.PI_CODING_AGENT_DIR;
+  const previousRegistry = globalThis.__piSessions;
+  const previousRuns = globalThis.__piSubagentRuns;
+  process.env.PI_CODING_AGENT_DIR = dir;
+  globalThis.__piSessions = new Map();
+  globalThis.__piSubagentRuns = new Map();
+  const manager = SessionManager.create(dir, undefined, { parentSession: join(dir, "parent.jsonl") });
+  const id = manager.getSessionId();
+  const filePath = manager.getSessionFile();
+  t.after(async () => {
+    if (previousAgentDir === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previousAgentDir;
+    globalThis.__piSessions = previousRegistry;
+    globalThis.__piSubagentRuns = previousRuns;
+    invalidateSessionPathCache(id);
+    invalidateSessionListCache();
+    await rm(dir, { recursive: true, force: true });
+  });
+  manager.appendCustomEntry("pi-web:subagent", {
+    version: 1, parentSessionId: "parent", parentSessionPath: join(dir, "parent.jsonl"),
+    parentToolCallId: "old-call", profile: "explore", description: "Inspect", task: "Inspect",
+    runInBackground: true, createdAt: new Date().toISOString(),
+  });
+  manager.appendMessage({ role: "user", content: "interruption-fixture", timestamp: Date.now() });
+  manager.appendMessage({ role: "assistant", content: [{ type: "text", text: "partial response" }], timestamp: Date.now() });
+  cacheSessionPath(id, filePath);
+  const context = { params: Promise.resolve({ id }) };
+  const readJson = async (handler, url) => {
+    const response = await handler(new Request(`http://localhost${url}`), context);
+    assert.equal(response.status, 200);
+    return response.json();
+  };
+  const assertStatus = async (status) => {
+    assert.equal((await readJson(getSubagent, `/api/subagents/${id}`)).run.status, status);
+    assert.equal((await readJson(getSessionDetail, `/api/sessions/${id}`)).info.relation.status, status);
+    const list = await readJson(getSessionList, "/api/sessions");
+    assert.equal(list.sessions.find((session) => session.id === id).relation.status, status);
+    assert.equal(list.runningSessionIds.includes(id), status === "running");
+    const search = await readJson(searchSessions, "/api/sessions/search?q=interruption-fixture");
+    assert.equal(search.results.find((result) => result.session.id === id).session.relation.status, status);
+  };
+
+  for (const status of ["queued", "running"]) {
+    manager.appendCustomEntry("pi-web:subagent-status", { version: 1, status });
+    invalidateSessionListCache();
+    const before = await readFile(filePath, "utf8");
+    await assertStatus("interrupted");
+    const { run } = await readJson(getSubagent, `/api/subagents/${id}`);
+    globalThis.__piSessions.set(id, {
+      sessionId: id, sessionFile: filePath, cwd: dir, inner: { sessionManager: manager },
+      isAlive: () => true, isRunning: () => status === "running",
+      hasSuppressedCompletionNotifications: () => true,
+    });
+    globalThis.__piSubagentRuns.set(id, { run: { ...run, status } });
+    await assertStatus(status);
+    globalThis.__piSessions.clear();
+    globalThis.__piSubagentRuns.clear();
+    await assertStatus("interrupted");
+    assert.equal(await readFile(filePath, "utf8"), before);
+  }
+});
