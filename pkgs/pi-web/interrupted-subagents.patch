+test("queue execution failures release the run so the existing child can be resumed", async () => {
+  const entries = [{ type: "custom", customType: "pi-web:subagent", data: {
+    version: 1, parentSessionId: "parent", parentSessionPath: "/tmp/parent.jsonl",
+    profile: "explore", task: "Inspect", description: "Inspect", runInBackground: true,
+  } }];
+  let failStatusWrite = true;
+  const child = {
+    sessionFile: "/tmp/queue-failure.jsonl", cwd: "/tmp", isAlive: () => true,
+    isRunning: () => false, waitUntilReady: async () => {},
+    inner: {
+      sessionManager: {
+        getEntries: () => entries,
+        appendCustomEntry: (customType, data) => {
+          if (failStatusWrite && customType === "pi-web:subagent-status" && data.status === "running") {
+            throw new Error("status write failed");
+          }
+          entries.push({ type: "custom", customType, data });
+        },
+      },
+      prompt: async () => {}, getLastAssistantText: () => "Recovered", abort: async () => {},
+    },
+  };
+  const parent = { ...child, inner: { sessionManager: { getSessionId: () => "parent" } } };
+  const controller = createSubagentController({
+    getSession: (id) => id === "queue-failure" ? child : parent,
+    registerSession: () => {}, reopenSession: async () => child,
+    resolveSessionPath: async () => child.sessionFile, invalidateSessionList: () => {},
+    isBuiltInSubagentsEnabled: () => true,
+  });
+  const request = {
+    parentContext: parent.inner, parentToolCallId: "resume-call", sessionId: "queue-failure",
+    task: "Continue", description: "Continue",
+  };
+  const failed = await controller.extensionRuntime.resume(request);
+  assert.match((await failed.completion).error, /status write failed/);
+  assert.equal(controller.getActiveStatus("queue-failure"), undefined);
+  assert.equal((await controller.get("queue-failure")).status, "interrupted");
+  failStatusWrite = false;
+  const recovered = await controller.extensionRuntime.resume(request);
+  assert.equal((await recovered.completion).status, "completed");
+});
