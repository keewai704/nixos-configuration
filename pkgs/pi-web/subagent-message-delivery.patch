+    const snapshot = new Map(offers);
+    const pending = new Set(await port.pending());
+    if (disposed || !port.isCurrent()) return [];
+    for (const [id, value] of snapshot) if (offers.get(id) === value && !pending.has(id)) offers.delete(id);
+    return [...offers.values()].filter((value) => pending.has(value.deliveryId));
