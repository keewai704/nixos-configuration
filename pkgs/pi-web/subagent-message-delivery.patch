diff --git a/lib/subagent-progress.ts b/lib/subagent-progress.ts
new file mode 100644
--- /dev/null
+++ b/lib/subagent-progress.ts
@@ -0,0 +1,21 @@
+import type { AgentMessage, CustomMessage, SessionEntry } from "./types";
+
+export const SUBAGENT_PROGRESS_TYPE = "native-subagent-progress";
+
+export function mergeSubagentProgressHistory<T extends { messages: AgentMessage[]; entryIds: string[]; oldestEntryId: string | null; hasMore: boolean }>(previous: T, incoming: T): T {
+  const overlap = previous.entryIds.indexOf(incoming.entryIds[0]);
+  if (overlap <= 0) return incoming;
+  return { ...incoming, messages: [...previous.messages.slice(0, overlap), ...incoming.messages],
+    entryIds: [...previous.entryIds.slice(0, overlap), ...incoming.entryIds],
+    oldestEntryId: previous.oldestEntryId, hasMore: previous.hasMore };
+}
+
+export function subagentProgressMessage(entry: SessionEntry | undefined): CustomMessage | null {
+  if (!entry || entry.type !== "custom" || entry.customType !== SUBAGENT_PROGRESS_TYPE
+    || !entry.data || typeof entry.data !== "object") return null;
+  const data = entry.data as Record<string, unknown>;
+  if (data.purpose !== "progress" || typeof data.text !== "string") return null;
+  return { role: "custom", customType: SUBAGENT_PROGRESS_TYPE, display: true,
+    content: `Native subagent progress${typeof data.from === "string" ? ` from ${data.from}` : ""}:\n${data.text}`,
+    details: { ...data, nativeProgressEntryId: entry.id }, timestamp: Date.parse(entry.timestamp) };
+}
