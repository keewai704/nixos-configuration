+test("idle native progress entry events preserve identity and payload through SSE and reconnect", async () => {
+  const entry = { type: "custom", customType: "native-subagent-progress", id: "progress-id", parentId: "earlier-id",
+    timestamp: new Date().toISOString(), data: { kind: "message", purpose: "progress", from: "worker", text: "Progress", deliveryId: "delivery" } };
+  for (let reconnect = 0; reconnect < 2; reconnect++) {
+    let listener;
+    const reader = createAgentEventStream(new Request("http://localhost/events"), "native-parent", Promise.resolve({
+      isStreaming: false, streamingMessage: undefined, onEvent(next) { listener = next; return () => {}; },
+    })).getReader();
+    try {
+      await readWithin(reader);
+      assert.equal(decodeData(await readWithin(reader)).isStreaming, false);
+      listener({ type: "entry_appended", entry });
+      assert.deepEqual(decodeData(await readWithin(reader)), { type: "entry_appended", entry });
+      const unknown = { ...entry, customType: "other-extension" };
+      listener({ type: "entry_appended", entry: unknown });
+      assert.deepEqual(decodeData(await readWithin(reader)), { type: "entry_appended", entry: unknown });
+    } finally { await reader.cancel(); }
+  }
+});
+
diff --git a/lib/session-reader.pagination.test.mjs b/lib/session-reader.pagination.test.mjs
--- a/lib/session-reader.pagination.test.mjs
+++ b/lib/session-reader.pagination.test.mjs
@@ -11,0 +12,38 @@
+const { subagentProgressMessage, mergeSubagentProgressHistory } = await jiti.import("./subagent-progress.ts");
+
+test("native progress history, reconnect merging and branches preserve IDs, pagination and legacy bytes", () => {
+  const timestamp = new Date().toISOString();
+  const entries = [
+    { type: "custom_message", id: "legacy", parentId: null, timestamp, customType: "native-subagent", content: "Original legacy bytes", display: true, details: { retained: true } },
+    { type: "custom_message", id: "unknown", parentId: "legacy", timestamp, customType: "other-extension", content: "Unknown custom still visible", display: true },
+    { type: "custom", id: "progress", parentId: "unknown", timestamp, customType: "native-subagent-progress", data: { kind: "message", purpose: "progress", text: "Metadata-only progress", from: "worker", deliveryId: "delivery" } },
+    { type: "custom", id: "private", parentId: "progress", timestamp, customType: "other-extension", data: { text: "Not a chat message" } },
+    { type: "compaction", id: "summary", parentId: "private", timestamp, summary: "Unmodified old summary", firstKeptEntryId: "unknown", tokensBefore: 10 },
+    { type: "custom_message", id: "attention", parentId: "summary", timestamp, customType: "native-subagent-notification", content: "Machine observation", display: true },
+  ];
+  const bytes = JSON.stringify(entries);
+  const full = buildSessionContext(entries, "attention");
+  assert.deepEqual(full.entryIds, ["legacy", "unknown", "progress", "summary", "attention"]);
+  assert.deepEqual(full.messages[2], subagentProgressMessage(entries[2]));
+  assert.equal(full.messages[2].details.nativeProgressEntryId, "progress");
+  assert.equal(full.messages[0].content, "Original legacy bytes");
+  assert.equal(full.messages[1].content, "Unknown custom still visible");
+  assert.equal(subagentProgressMessage(entries[3]), null);
+  const tail = buildSessionContext(entries, "attention", { tail: 3 });
+  const prefix = buildSessionContext(entries, "summary");
+  const merged = mergeSubagentProgressHistory(prefix, tail);
+  assert.deepEqual(merged.entryIds, full.entryIds);
+  assert.deepEqual(merged.messages, full.messages);
+  assert.equal(merged.oldestEntryId, "legacy");
+  assert.equal(merged.hasMore, false);
+  assert.deepEqual(mergeSubagentProgressHistory(merged, tail), merged);
+  assert.deepEqual(buildSessionContext(entries, "unknown").entryIds, ["legacy", "unknown"]);
+  assert.equal(JSON.stringify(entries), bytes);
+  let page = buildSessionContext(entries, "attention", { tail: 2 });
+  let ids = [...page.entryIds];
+  while (page.hasMore) {
+    page = buildSessionContext(entries, page.oldestEntryId, { tail: 2, excludeLeaf: true });
+    ids = [...page.entryIds, ...ids];
+  }
+  assert.deepEqual(ids, full.entryIds);
+});
