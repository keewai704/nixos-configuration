+test("profile lists expose six canonical roles without compatibility aliases", () => {
+  const expected = ["code-reviewer", "oracle", "planner", "quality-reviewer", "scout", "worker"];
+  for (const list of [listSubagentProfiles, listSubagentProfileSources]) {
+    assert.deepEqual(list(testAgentDir).filter((role) => role.scope === "builtin").map((role) => role.name).sort(), expected);
+  }
+});
+
+test("legacy alias resolution preserves builtin behavior without sharing mutable tools", () => {
+  for (const [alias, name] of [["general-purpose", "worker"], ["explore", "scout"], ["plan", "planner"]]) {
+    const role = resolveSubagentProfile(testAgentDir, ` ${alias.toUpperCase()} `);
+    const canonical = resolveSubagentProfile(testAgentDir, name);
+    assert.equal(role.name, alias);
+    assert.equal(role.scope, "builtin");
+    assert.equal(role.systemPrompt, canonical.systemPrompt);
+    assert.equal(role.isolation, canonical.isolation);
+    assert.deepEqual(role.tools, canonical.tools);
+    role.tools.length = 0;
+    assert.deepEqual(resolveSubagentProfile(testAgentDir, alias).tools, canonical.tools);
+  }
+  assert.equal(resolveSubagentProfile(testAgentDir, "unknown-role"), undefined);
+});
+
+test("explicit profiles named like aliases retain scope precedence and disabled state", async (t) => {
+  const cwd = await mkdtemp(join(tmpdir(), "pi-web-alias-override-"));
+  t.after(() => rm(cwd, { recursive: true, force: true }));
+  t.after(() => deleteSubagentProfile(cwd, "global", "Explore"));
+  saveSubagentProfile(cwd, "global", profile({ name: "Explore", systemPrompt: "Global alias override" }));
+  assert.equal(resolveSubagentProfile(cwd, "explore").systemPrompt, "Global alias override");
+  await mkdir(join(cwd, ".agents", "agents"), { recursive: true });
+  await writeFile(join(cwd, ".agents", "agents", "explore.md"), "---\nname: EXPLORE\n---\nWorkspace alias override\n");
+  assert.equal(resolveSubagentProfile(cwd, "explore").scope, "workspace");
+  saveProjectSubagentProfile(cwd, profile({ name: "explore", systemPrompt: "Project alias override", enabled: true }));
+  assert.equal(resolveSubagentProfile(cwd, "EXPLORE").systemPrompt, "Project alias override");
+  assert.ok(listSubagentProfiles(cwd).some((role) => role.name === "explore" && role.scope === "project"));
+  saveProjectSubagentProfile(cwd, profile({ name: "explore", enabled: false }));
+  assert.equal(resolveSubagentProfile(cwd, "explore"), undefined);
+});
