+int
+dnssd_get_service_fd(dnssd_t *dnssd, int service)
+{
+    DNSServiceRef ref = service == DNSSD_SERVICE_RAOP ? dnssd->raop_service : dnssd->airplay_service;
+    return ref ? dnssd->DNSServiceRefSockFD(ref) : -1;
+}
+
+int
+dnssd_process_service(dnssd_t *dnssd, int service)
+{
+    DNSServiceRef ref = service == DNSSD_SERVICE_RAOP ? dnssd->raop_service : dnssd->airplay_service;
+    return dnssd->DNSServiceProcessResult(ref);
+}
