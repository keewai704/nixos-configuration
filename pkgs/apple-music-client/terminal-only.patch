+    #[test]
+    fn setup_requires_imported_worker_and_apple_library() {
+        let root = tempfile::tempdir().unwrap();
+        let error = validate_setup(root.path()).unwrap_err().to_string();
+        assert!(error.contains("alac-room-auth-import"));
+        assert!(error.contains("3.6.0-beta (1109)"));
+        for name in [
+            "system/bin/main",
+            "system/bin/linker64",
+            "system/lib64/libandroidappmusic.so",
+        ] {
+            let path = root.path().join("rootfs").join(name);
+            std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+            std::fs::write(&path, b"fixture").unwrap();
+            std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700)).unwrap();
+        }
+        validate_setup(root.path()).unwrap();
+        std::fs::set_permissions(
+            root.path().join("rootfs/system/bin/main"),
+            std::fs::Permissions::from_mode(0o600),
+        )
+        .unwrap();
+        assert!(validate_setup(root.path()).is_err());
+        assert!(validate_setup(Path::new("relative")).is_err());
+    }
