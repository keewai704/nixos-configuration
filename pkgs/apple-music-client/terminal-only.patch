+pub fn check_setup() -> Result<()> {
+    let data = std::env::var_os("ALAC_ROOM_AUTH_DATA_DIR")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("XDG_DATA_HOME")
+                .filter(|value| !value.is_empty())
+                .map(|path| PathBuf::from(path).join("alac-room/auth"))
+        })
+        .or_else(|| {
+            std::env::var_os("HOME")
+                .map(|path| PathBuf::from(path).join(".local/share/alac-room/auth"))
+        })
+        .ok_or_else(|| anyhow!("HOMEまたはALAC_ROOM_AUTH_DATA_DIRを設定してください。"))?;
+    validate_setup(&data)
+}
+
+fn validate_setup(data: &Path) -> Result<()> {
+    if !data.is_absolute() {
+        bail!("ALAC_ROOM_AUTH_DATA_DIRには絶対パスを指定してください。");
+    }
+    let root = data.join("rootfs");
+    for (name, executable) in [
+        ("system/bin/main", true),
+        ("system/bin/linker64", true),
+        ("system/lib64/libandroidappmusic.so", false),
+    ] {
+        let usable = std::fs::metadata(root.join(name)).is_ok_and(|metadata| {
+            metadata.is_file() && (!executable || metadata.permissions().mode() & 0o111 != 0)
+        });
+        if !usable {
+            bail!(
+                "Apple Music認証用ライブラリが未導入、または不完全です。\nApple Music 3.6.0-beta (1109) のx86_64対応APK/APKMを用意して、次を実行してください。\n\nalac-room-auth-import /path/to/apple-music.apkm\n\n導入先: {}\n不足: {name}\n取り込み後、Sioraで :connect または :login を実行してください。",
+                root.display()
+            );
+        }
+    }
+    Ok(())
@@ -229,0 +279,26 @@
