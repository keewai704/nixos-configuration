+@pytest.mark.parametrize("location", ["explicit", "xdg", "home"])
+def test_shared_typesafe_key_is_read_again_after_replacement(monkeypatch, tmp_path, location):
+    monkeypatch.delenv("TYPESAFE_API_KEY", raising=False)
+    monkeypatch.delenv("TYPESAFE_API_KEY_FILE", raising=False)
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    path = tmp_path / ".config" / "typesafe" / "api-key"
+    if location == "explicit":
+        path = tmp_path / "credentials"
+        monkeypatch.setenv("TYPESAFE_API_KEY_FILE", str(path))
+    elif location == "xdg":
+        monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "xdg"))
+        path = tmp_path / "xdg" / "typesafe" / "api-key"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("first-key\n")
+    assert model.typesafe_api_key() == "first-key"
+    replacement = path.with_suffix(".new")
+    replacement.write_text("second-key\n")
+    replacement.replace(path)
+    assert model.typesafe_api_key() == "second-key"
+
+
+def test_typesafe_environment_override(monkeypatch, tmp_path):
+    monkeypatch.setenv("TYPESAFE_API_KEY", "explicit-key")
+    monkeypatch.setenv("TYPESAFE_API_KEY_FILE", str(tmp_path / "missing"))
+    assert model.typesafe_api_key() == "explicit-key"
+
+
+@pytest.mark.parametrize("content", [None, b"", b"first-key\nsecond-key", bytes([255])])
+def test_invalid_shared_typesafe_key_fails_without_disclosing_content(monkeypatch, tmp_path, content):
+    path = tmp_path / "api-key"
+    monkeypatch.setenv("TYPESAFE_API_KEY", "")
+    monkeypatch.setenv("TYPESAFE_API_KEY_FILE", str(path))
+    if content is not None:
+        path.write_bytes(content)
+    with pytest.raises(ValueError, match="TypeSafe") as error:
+        model.typesafe_api_key()
+    assert "first-key" not in str(error.value)
+    assert "second-key" not in str(error.value)
+
+
+def test_unreadable_typesafe_key_is_not_a_missing_credential(monkeypatch, tmp_path):
+    monkeypatch.delenv("TYPESAFE_API_KEY", raising=False)
+    monkeypatch.setenv("TYPESAFE_API_KEY_FILE", str(tmp_path))
+    with pytest.raises(ValueError, match="Cannot read"):
+        model.typesafe_api_key()
+
