+def typesafe_api_key():
+    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
+    if not key:
+        config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
+        path = Path(os.environ.get("TYPESAFE_API_KEY_FILE") or config_home / "typesafe" / "api-key").expanduser()
+        try:
+            key = path.read_text(encoding="utf-8").strip()
+        except FileNotFoundError:
+            raise ValueError("Configure the shared TypeSafe API key file or TYPESAFE_API_KEY.") from None
+        except (OSError, UnicodeError):
+            raise ValueError("Cannot read the shared TypeSafe API key file.") from None
+    if not key or any(character.isspace() for character in key):
+        raise ValueError("TypeSafe API key must be a nonempty single token.")
+    return key


