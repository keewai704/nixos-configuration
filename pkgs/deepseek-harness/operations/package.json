{
  "name": "@keewai/dsh-operations",
  "version": "0.1.0",
  "description": "Authenticated privacy, retention preview and plugin recovery controls",
  "type": "module",
  "license": "MIT",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./journal": "./journal-plugin.mjs",
    "./privacy": "./privacy-plugin.mjs",
    "./privacy-telemetry": "./privacy-telemetry.mjs",
    "./privacy-session-log": "./privacy-session-log.mjs",
    "./privacy-inventory": "./privacy-inventory.mjs",
    "./privacy-analytics": "./privacy-analytics.mjs",
    "./message-policy": "./message-policy.mjs",
    "./budget": "./budget-plugin.mjs",
    "./budget-guard": "./budget-guard.mjs",
    "./checkpoints": "./checkpoint-plugin.mjs",
    "./checkpoint-tools": "./checkpoint-tools.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-log-deepseek": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.1-alpha.2",
    "@deepseek-ai/node-addon-system": "0.1.2"
  }
}
