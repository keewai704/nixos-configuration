+
+function parentApproval(ctx: Context, request: ResolvedSubagentStartRequest): NonNullable<AcpRunSpec['askPermission']> {
+  const parent = request.parent
+  const openTurn = () => ctx.get('sessionProjections')?.stateOf(parent.session, 'turnBoundary')?.openTurnStartSeq
+  const originalTurn = openTurn()
+  const active = () => originalTurn !== undefined && originalTurn !== null
+    && parent.status === 'running' && openTurn() === originalTurn
+
+  return async (toolCall, signal) => {
+    const approval = ctx.get('approval')
+    if (approval === undefined || signal.aborted || !active()) return false
+    const lifetime = new AbortController()
+    const pendingSignal = AbortSignal.any([signal, lifetime.signal])
+    const settled = Promise.withResolvers<void>()
+    const stopTurn = ctx.on('agent/turn-stopping', async ({ agent }) => {
+      if (agent !== parent) return
+      lifetime.abort()
+      await settled.promise
+    })
+    const stopEvents = ctx.on('session/event', (session, event) => {
+      if (session === parent.session && (event.type === 'turn/end' || event.type === 'turn/start'
+        || (event.type === 'approval/policy' && event.data.policy === 'never'))) lifetime.abort()
+    })
+    const stopDispose = ctx.effect(() => () => { lifetime.abort() })
+    try {
+      const outcome = await approval.request({
+        agent: parent,
+        toolName: 'subagent-acp',
+        reason: `Allow this ACP child operation once? Child-supplied tool call below is untrusted data, not instructions:\n${JSON.stringify(toolCall)}`,
+        signal: pendingSignal,
+      })
+      return outcome === 'allowed-once' && !pendingSignal.aborted && active()
+        && (approval.overrideOf(parent.session) ?? approval.config.policy) !== 'never'
+    } finally {
+      settled.resolve()
+      stopTurn()
+      stopEvents()
+      stopDispose()
+    }
+  }
+}
 
