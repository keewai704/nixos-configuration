+import type { GenerateOptions, Message } from '@deepseek-ai/dsh-llm'
+import { unsupportedInput } from './errors.js'
+
+export function normalizeRequest(options: GenerateOptions): GenerateOptions {
+  const system = [options.system]
+  let offset = 0
+  for (const message of options.messages) {
+    if ((message.role as string) !== 'system') break
+    system.push(
+      message.content
+        .map((block) => {
+          if (block.type !== 'text')
+            throw unsupportedInput('Claude system messages require text content')
+          return block.text
+        })
+        .join('\n\n'),
+    )
+    offset++
+  }
+  const messages = options.messages.slice(offset).map((message, index) => {
+    if ((message.role as string) === 'system') {
+      throw unsupportedInput('Claude only accepts leading system messages')
+    }
+    if (message.role === 'user' && message.source === undefined && message.id === undefined) {
+      return {
+        ...message,
+        id: `claude-request-input:${index}` as Message['id'],
+        source: { kind: 'user' },
+      } as Message
+    }
+    return message
+  })
+  const normalized = { ...options, messages }
+  const prompt = system.filter(Boolean).join('\n\n')
+  if (prompt.length > 0) normalized.system = prompt
+  else delete normalized.system
+  return normalized
+}
