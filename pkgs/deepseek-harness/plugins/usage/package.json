{
  "name": "dsh-subscription-usage",
  "version": "0.1.0",
  "type": "module",
  "description": "Local Claude, ChatGPT and DSH usage history, estimated costs and subscription limits",
  "license": "MIT",
  "exports": { ".": "./index.mjs", "./client": "./lib/client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
