+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { createUserMessage, MessageId } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { z } from 'zod'
+import type { ScheduleTask } from './storage.ts'
+
+export const outboxSchema = z.object({
+  id: z.string().min(1),
+  sessionId: z.string().min(1).transform(SessionId),
+  text: z.string(),
+  members: z.array(z.object({
+    taskId: z.string().min(1),
+    prompt: z.string(),
+    scheduledAt: z.string(),
+    nextScheduledAt: z.string().optional(),
+  }).strict()).min(1),
+  attempts: z.number().int().min(0).max(5),
+  retryAt: z.number().int().min(0),
+  deliveredAt: z.string().optional(),
+}).strict()
+
+export type OutboxEntry = z.infer<typeof outboxSchema>
+export interface ScheduleOutbox {
+  entries(): IterableIterator<[string, OutboxEntry]>
+  put(key: string, value: OutboxEntry): Promise<void>
+  delete(key: string): Promise<boolean>
+}
+
+export function alreadyDelivered(agent: Agent, messageId: string): boolean {
+  for (const event of agent.session.ownEvents()) {
+    if (event.type === 'agent/inbox/spliced' && event.data.inserted.some(message => message.id === messageId)) return true
+  }
+  return false
+}
+
+export async function wakeAcknowledged(ctx: Context, entry: OutboxEntry): Promise<boolean> {
+  const resolved = await ctx.sessionController.resolveAgent(entry.sessionId)
+  if ('error' in resolved) throw resolved.error
+  const pending = [...resolved.agent.inbox.nextTurn, ...resolved.agent.inbox.nextStep].find(message => message.id === entry.id)
+  if (pending === undefined) {
+    if (!await ctx.sessions.flush(resolved.agent.session)) throw new Error('Schedule consumption was not persisted')
+    return true
+  }
+  if (!alreadyDelivered(resolved.agent, entry.id)) throw new Error('Schedule pending identity is not owned by the target Session')
+  if (resolved.agent.followupDurable === undefined) throw new Error('Schedule requires durable inbox admission')
+  await resolved.agent.followupDurable(pending)
+  return false
+}
+
+export async function deliverOutbox(ctx: Context, entry: OutboxEntry, outbox: ScheduleOutbox): Promise<OutboxEntry> {
+  const attempt = { ...entry, attempts: entry.attempts + 1, retryAt: Date.now() + Math.min(60_000, 1000 * 2 ** entry.attempts) }
+  await outbox.put(entry.id, attempt)
+  const resolved = await ctx.sessionController.resolveAgent(entry.sessionId)
+  if ('error' in resolved) throw resolved.error
+  if (resolved.agent.followupDurable === undefined) throw new Error('Schedule requires durable inbox admission')
+  const message = createUserMessage({ content: [{ type: 'text', text: entry.text }], source: { kind: 'schedule' } })
+  await resolved.agent.followupDurable({ ...message, id: MessageId(entry.id) })
+  const receipt = { ...attempt, deliveredAt: new Date().toISOString() }
+  await outbox.put(entry.id, receipt)
+  return receipt
+}
+
+export function taskWaitingForOutbox(task: ScheduleTask, entries: readonly OutboxEntry[]): boolean {
+  return entries.some(entry => entry.members.some(member => member.taskId === task.record.id
+    && (entry.deliveredAt === undefined || task.record.scheduledAt <= member.scheduledAt)))
+}
