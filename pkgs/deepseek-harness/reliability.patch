+export class WorkflowAdmission {
+  private started = 0
+  private active = 0
+
+  constructor(
+    readonly deadlineAt: number,
+    readonly maxTotalAgents: number,
+    readonly maxConcurrentAgents: number,
+  ) {}
+
+  reserve(): () => void {
+    if (Date.now() >= this.deadlineAt) throw new Error('workflow deadline exceeded')
+    if (this.started >= this.maxTotalAgents) throw new Error('workflow shared total-agent limit exceeded')
+    if (this.active >= this.maxConcurrentAgents) throw new Error('workflow shared concurrency limit exceeded')
+    this.started += 1
+    this.active += 1
+    let released = false
+    return () => {
+      if (released) return
+      released = true
+      this.active -= 1
+    }
+  }
+}
