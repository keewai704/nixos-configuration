+class AdaptivePaletteTests(unittest.TestCase):
+    def test_sixteen_bit_wallpaper_keeps_rgb_channel_boundaries(self):
+        with tempfile.TemporaryDirectory() as directory:
+            image = Path(directory) / "wallpaper.ppm"
+            image.write_text("P3\n1 1\n65535\n4660 22136 39612\n")
+            self.assertEqual(theme.sample_colors(str(image)), ["#12569A"])
+
+    def test_near_black_wallpaper_uses_neutral_accent(self):
+        with tempfile.TemporaryDirectory() as directory:
+            image = Path(directory) / "wallpaper.ppm"
+            image.write_text("P3\n1 1\n65535\n503 508 532\n")
+            self.assertEqual(theme.sample_colors(str(image)), ["#020202"])
+            palette = theme.build_palette(str(image))
+            self.assertEqual(palette["accent"], theme.NEUTRAL_ACCENT["hex"])
+
+    def test_eight_bit_rgb_wallpaper_keeps_its_color(self):
+        with tempfile.TemporaryDirectory() as directory:
+            image = Path(directory) / "wallpaper.ppm"
+            image.write_text("P3\n1 1\n255\n18 52 86\n")
+            self.assertEqual(theme.sample_colors(str(image)), ["#123456"])
+
+    def test_rgba_samples_keep_rgb_without_alpha(self):
+        result = subprocess.CompletedProcess([], 0, "0,0: (18,52,86,128) #12345680 srgba(18,52,86,0.5)\n")
+        with patch.object(theme.shutil, "which", return_value="magick"), \
+                patch.object(theme.subprocess, "run", return_value=result):
+            self.assertEqual(theme.sample_colors("wallpaper.png"), ["#123456"])
+
+    def test_unexpected_wide_samples_are_not_truncated(self):
+        result = subprocess.CompletedProcess([], 0, "#01F701FC0214 #01F701FC0214FFFF #123456\n")
+        with patch.object(theme.shutil, "which", return_value="magick"), \
+                patch.object(theme.subprocess, "run", return_value=result):
+            self.assertEqual(theme.sample_colors("wallpaper.png"), ["#123456"])
+
