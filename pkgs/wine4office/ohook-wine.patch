@@ -3,6 +3,21 @@
 #include <shlwapi.h>
 #include "sl.h"
 
+HRESULT WINAPI SLGetInstalledProductKeyIds(HSLC, const SLID *, UINT *, SLID **);
+
+BOOL IsWineProductWithKey(HSLC handle, const SLID *sku) {
+    SLID *keys = NULL;
+    UINT count = 0;
+    HRESULT result;
+
+    if (!GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "wine_get_version"))
+        return FALSE;
+
+    result = SLGetInstalledProductKeyIds(handle, sku, &count, &keys);
+    LocalFree(keys);
+    return result == S_OK && count > 0;
+}
+
 BOOL bIsHeartbeatRegistryModified = FALSE;
 
