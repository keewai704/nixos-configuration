+#[cfg(test)]
+mod tests {
+    use super::confirm_receive;
+    use std::path::Path;
+
+    #[tokio::test]
+    async fn external_confirmation_accepts_only_success() {
+        assert!(confirm_receive(Path::new("true"), "a file; $(false)").await);
+        assert!(!confirm_receive(Path::new("false"), "a file").await);
+        assert!(!confirm_receive(Path::new("/nonexistent/airdrop-confirm"), "a file").await);
+    }
+
+    #[tokio::test]
+    async fn external_confirmation_does_not_outlive_the_offer() {
+        assert!(!confirm_receive(Path::new("sleep"), "60").await);
+    }
+}
