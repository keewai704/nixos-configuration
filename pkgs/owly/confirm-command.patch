+async fn confirm_receive(command: &std::path::Path, offer: &str) -> bool {
+    matches!(
+        tokio::time::timeout(
+            Duration::from_secs(14),
+            tokio::process::Command::new(command)
+                .arg(offer)
+                .kill_on_drop(true)
+                .status()
+        )
+        .await,
+        Ok(Ok(status)) if status.success()
+    )
+}
