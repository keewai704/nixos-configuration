@@ -35,0 +73 @@
+  },
@@ -37 +75,79 @@
-    l10nReg.registerSources([src]);
+  _upsertLocaleSource(metaSource) {
+    const registry = L10nRegistry.getInstance();
+    const sourceName = this._sourceName(metaSource);
+    const source = this._buildLocaleSource(metaSource);
+    if (registry.hasSource(sourceName)) {
+      registry.updateSources([source]);
+    } else {
+      registry.registerSources([source]);
+    }
+  },
+
+  _removeLangpackShadow(langpackId) {
+    const sourceName = this._sourceName(langpackId);
+    const registry = L10nRegistry.getInstance();
+    if (registry.hasSource(sourceName)) {
+      registry.removeSources([sourceName]);
+    }
+    this._langpackShadowSources.delete(langpackId);
+  },
+
+  _syncLocaleSources() {
+    this._upsertLocaleSource("app");
+
+    const activeLangpackIds = new Set(Langpack.activeLangpackIds);
+    for (const langpackId of this._langpackShadowSources) {
+      if (!activeLangpackIds.has(langpackId)) {
+        this._removeLangpackShadow(langpackId);
+      }
+    }
+    for (const langpackId of activeLangpackIds) {
+      this._upsertLocaleSource(langpackId);
+      this._langpackShadowSources.add(langpackId);
+    }
+  },
+
+  registerLocales() {
+    if (!this._localeObserversRegistered) {
+      for (const topic of SINE_L10N_TOPICS) {
+        Services.obs.addObserver(this, topic);
+      }
+      this._localeObserversRegistered = true;
+    }
+
+    // Updating sources emits intl:app-locales-changed synchronously.
+    this._inLocaleObserver = true;
+    try {
+      this._syncLocaleSources();
+    } finally {
+      this._inLocaleObserver = false;
+    }
+  },
+
+  observe(subject, topic) {
+    if (this._inLocaleObserver) {
+      return;
+    }
+
+    this._inLocaleObserver = true;
+    try {
+      if (topic === "profile-before-change") {
+        for (const observedTopic of SINE_L10N_TOPICS) {
+          Services.obs.removeObserver(this, observedTopic);
+        }
+        this._localeObserversRegistered = false;
+        return;
+      }
+
+      if (topic === "webextension-langpack-shutdown") {
+        const langpackId = subject?.wrappedJSObject?.langpack?.langpackId;
+        if (langpackId) {
+          this._removeLangpackShadow(langpackId);
+        }
+        return;
+      }
+
+      this._syncLocaleSources();
+    } finally {
+      this._inLocaleObserver = false;
+    }
