+  "chrome://locales/content/ru/sine-preferences.ftl",
+  "chrome://locales/content/ru/sine-toasts.ftl",
+];
+const SINE_L10N_TOPICS = [
+  "intl:app-locales-changed",
+  "webextension-langpack-startup",
