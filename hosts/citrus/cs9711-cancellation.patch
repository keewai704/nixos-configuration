+static void
+m_scan_complete (FpiSsm *ssm, FpDevice *_dev, GError *error)
+{
+  FpImageDevice *dev = FP_IMAGE_DEVICE (_dev);
+  FpDeviceCs9711 *self = FPI_DEVICE_CS9711 (_dev);
+
+  g_assert (self->scan_ssm == ssm);
+  g_assert (!self->scan_transfer_pending);
+
+  self->scan_ssm = NULL;
+  g_clear_object (&self->scan_cancellable);
+  g_clear_error (&self->scan_error);
+
+  if (error || self->deactivating)
+    {
+      GError *reset_error = NULL;
+
+      /* Stop any frame that the device may still have queued before the
+       * interface is released and a later activation reads its init reply. */
+      usb_send_out_sync (_dev, CS9711_FP_CMD_TYPE_RESET, &reset_error);
+      g_clear_error (&reset_error);
+    }
+
+  if (self->deactivating)
+    fpi_image_device_deactivate_complete (dev, error);
+  else if (error)
+    fpi_image_device_session_error (dev, error);
+}
