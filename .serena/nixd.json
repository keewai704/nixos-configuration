{
  "nixpkgs": {
    "expr": "import (builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs { }"
  },
  "formatting": {
    "command": ["nixfmt"]
  },
  "options": {
    "nixos": {
      "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.orange.options"
    },
    "home-manager": {
      "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.orange.options.home-manager.users.type.getSubOptions []"
    }
  }
}
